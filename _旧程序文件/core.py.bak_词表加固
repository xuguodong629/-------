def _finalize_fields(fields: dict, type_: str, title: str, report: list) -> OrderedDict:
    """收尾 frontmatter：标题/别名对齐笔记名，补齐 type / importance / tags（英文键）。"""
    fields = canonicalize_fields(fields, report)
    out: OrderedDict = OrderedDict()
    out["title"] = title
    aliases = fields.get("aliases")
    if isinstance(aliases, list):
        items = [str(x).strip() for x in aliases if str(x).strip()]
    else:
        items = [str(aliases).strip()] if str(aliases or "").strip() else []
    if title and title not in items:
        items.insert(0, title)
    out["aliases"] = items[:3]
    out["type"] = type_ or str(fields.get("type") or "").strip()   # 以"该库的路由类型名"为准
    for key, val in fields.items():
        if key in ("title", "aliases", "type"):
            continue
        out[key] = val
    if not out.get("tags"):
        out["tags"] = ["历史", "中国近代史", "民国史", type_]
    return out


def _insert_before_tags(fields: OrderedDict, key: str, value) -> OrderedDict:
    """把字段插到 tags 之前，保持 frontmatter 的常规顺序。"""
    if key in fields:
        fields[key] = value
        return fields
    out: OrderedDict = OrderedDict()
    inserted = False
    for k, v in fields.items():
        if k == "tags" and not inserted:
            out[key] = value
            inserted = True
        out[k] = v
    if not inserted:
        out[key] = value
    return out


def template_footer(cfg: dict, type_: str) -> list:
    """取 `---` + `**关联**：…`：模板写了用模板的，没写就按格式规范兜底。

    格式规范 §1 第 11 条要求文件末尾固定为 `---` + `**关联**：…`；知识库里有几个
    模板（国民党全史 / 国家制度与财政 / 战役数据库 …）自己漏了页脚，这里补齐。
    """
    try:
        skeleton = template_skeleton(cfg, type_)
    except Exception:
        skeleton = ""
    routes = cfg.get("routes") or {}
    dir_values = {str(v) for v in routes.values()}
    for line in reversed([ln.strip() for ln in skeleton.splitlines()]):
        if line.startswith(("**关联**", "**关联模块**")):
            raw = line.replace("**关联模块**", "**关联**")
            links = re.findall(r"\[\[([^\]|]+)(?:\|[^\]]+)?\]\]", raw)
            conv: list = []
            for target in links:                       # 模板里写死的目录名 → 翻译成当前库实际目录名
                t = type_from_dir_name(target)
                d = str(routes.get(t) or "").strip()
                if not d and target in dir_values:
                    d = target
                if d and d not in conv:
                    conv.append(d)
            if conv:
                return ["---", "**关联**：" + " | ".join(f"[[{d}]]" for d in conv)]
            break                                      # 模板页脚在当前库里一个都解析不了 → 走下面兜底
    try:
        from templates import TYPE_FOOTER
    except Exception:
        return []
    links = TYPE_FOOTER.get(type_, "")
    return ["---", f"**关联**：{links}"] if links else []


def build_note_text(cfg: dict, type_: str, title: str, summary: str,
                    ai_fields: dict, ai_sections: OrderedDict,
                    report: list[str] | None = None,
                    images: list | None = None, auto_images: bool = True) -> tuple[str, str]:
    """
    按模板生成（或合并生成）笔记。返回 (最终文本, 状态说明)。

    模板是 Templater 版（格式规范 §0）时直接渲染：提示块不进笔记，frontmatter 由模板的
    `tR +=` 行拼出，正文 `<% 表达式 %>` 逐个求值，取不到就落 <!-- TODO: 待补 -->。
    用户自写的旧式 {{占位符}} 模板继续支持。
    """
    report = report if report is not None else []
    type_, alias_note = resolve_type_alias(cfg, type_)      # AI 给的「历史人物」这类说法先归并
    if alias_note:
        report.append(alias_note)
    template_text, note = load_template_text(cfg, type_)
    parsed = parse_template(template_text)

    if parsed["templater"]:
        values = build_template_values(type_, title, summary, ai_fields, parsed["prompts"],
                                      parsed.get("field_keys"))
        fields, body, _prompts = render_template(template_text, values, report)
    else:
        values = build_template_values(type_, title, summary, ai_fields, [], parsed.get("field_keys"))
        text = TPL_PROMPT_BLOCK_RE.sub("", template_text, count=1)
        legacy = {
            "{{title}}": title,
            "{{summary}}": summary or "",
            "{{era}}": values["period"],
            "{{importance}}": values["importance"] or "-",
            "{{year}}": values["year"],
            "{{generic_type}}": type_,
            "{{date}}": values["date"] or datetime.now().strftime("%Y-%m-%d"),
        }
        for key, val in legacy.items():
            text = text.replace(key, val)
        for placeholder in set(re.findall(r"\{\{[^}]*\}\}", text)):
            text = text.replace(placeholder, str(values.get(placeholder[2:-2].strip(), "")))
        fields, body = split_frontmatter(text)
        if fields is None:
            fields, body = {}, text

    fields = _finalize_fields(fields, type_, title, report)
    # 新字段只接受英文键（格式规范 §1-1）：模板提示变量里像「籍贯/身份/字号」这类没有英文键
    # 对应的，已经渲染进正文，不会再被当成 frontmatter 字段塞回来；有对应英文键的（时间→date、
    # 出生年→born…）照常合并填空。
    ai_src = {k: v for k, v in (ai_fields or {}).items()
              if str(k).strip() not in ("类型", "type", "标签", "tags")}
    ai_en = OrderedDict((k, v) for k, v in canonicalize_fields(ai_src, report).items()
                        if FIELD_KEY_RE.match(str(k)) and k not in PROTECTED_FIELDS)
    fields = update_frontmatter(fields, ai_en, report)
    if not str(fields.get("importance") or "").strip():       # 默认值放在合并之后，别挡住 AI 的判断
        fields = _insert_before_tags(fields, "importance", "3")

    template_sections = parse_sections(body)
    merged = merge_sections(template_sections, align_sections(ai_sections, template_sections), report)
    body_text = normalize_note_body(build_body(merged), title, report, template_footer(cfg, type_))
    lead = str(summary or "").strip()
    if lead and lead[:24] not in body_text:               # 模板没有对应小节时，首段作为导语保留（不丢内容）
        m_h1 = re.search(r"^#\s+.*$", body_text, re.M)
        if m_h1:
            body_text = (body_text[:m_h1.end()] + "\n\n" + lead + "\n\n"
                         + body_text[m_h1.end():].lstrip("\n"))
        else:
            body_text = lead + "\n\n" + body_text
        report.append("正文首段已作为导语保留在 H1 之后（模板没有对应小节）")
    n_dispute = sum(1 for ln in body_text.splitlines() if DISPUTE_MARK in ln)
    if n_dispute:
        report.append(f"争议说明：{n_dispute} 处（已就地附来源简介）")
    elif any(k in body_text for k in ("存在争议", "说法不一", "尚有争议", "存疑")):
        report.append("⚠ 正文提到“争议/说法不一”但没有按规范附「> ⚖️ 争议说明：…｜来源：…」，"
                      "建议补上（所有词条都适用）")
    text = "---\n" + serialize_simple_yaml(fields) + "\n---\n\n" + body_text
    entries = _image_entries(cfg, title, fields, images, auto_images)   # 配图（本地图库优先）
    if entries:
        text = insert_images(text, entries)
        report.append("配图：" + "、".join(str(e.get("file")) for e in entries))
    return text, note


def find_note_paths(cfg: dict, title: str) -> list:
    """在知识库里按文件名找同名词条（跳过模板/附件目录）。"""
    kb = resolve_kb(cfg)
    if kb is None:
        return []
    name = sanitize_title(title)
    out = []
    for p in kb.rglob(f"{name}.md"):
        if _is_skipped_path(p):
            continue
        out.append(p)
    return out


def _split_preamble(body: str) -> tuple:
    """把「第一个 `##`/`###` 之前」的内容（H1 + 引言段落）与其余正文分开。

    合并/整理时如果不带上它，H1 与引言就会在重建正文时被丢掉（真丢内容）。
    返回 (前导行列表, 其余正文字符串)。
    """
    lines = (body or "").splitlines()
    for i, ln in enumerate(lines):
        if re.match(r"^#{2,6}\s+\S", ln.strip()):
            return lines[:i], "\n".join(lines[i:])
    return lines, ""


def merge_into_existing(cfg: dict, target: Path, type_: str, title: str,
                        ai_fields: dict, ai_sections: OrderedDict, report: list,
                        images: list | None = None, auto_images: bool = True) -> str:
    """把 AI/粘贴的内容**增量合并**进一篇已存在的笔记，返回合并后的完整文本（不写盘）。

    规则：只填空字段、只填空小节、只追加缺失小节；已有内容一律保留（格式规范 §1）。
    report 里会逐条写明「正文填充/正文填空/新增小节/正文保留已有」，界面据此显示摘要。
    """
    existing = target.read_text(encoding="utf-8")
    fields, body = split_frontmatter(existing)
    if fields is None:
        fields, body = {}, existing
    fields = canonicalize_fields(fields, report)          # 中文键 → 英文键、去掉 [[ ]]
    ai_en = canonicalize_fields({k: v for k, v in (ai_fields or {}).items()
                                 if str(k).strip() not in ("类型", "type", "标签", "tags")}, report)
    # 老笔记里已有的中文键允许继续填充；不允许新增非英文键（格式规范 §1-1）
    ai_en = OrderedDict((k, v) for k, v in ai_en.items()
                        if FIELD_KEY_RE.match(str(k)) or k in fields)
    fields = update_frontmatter(fields, ai_en, report)
    existing_sections = parse_sections(body)
    preamble, _rest = _split_preamble(body)          # H1 + 引言段落不能丢
    # 先对齐已有笔记的小节（保住旧标题），剩下的再对齐模板（新小节用规范 emoji 标题）
    aligned = align_sections(ai_sections, existing_sections)
    resolved = OrderedDict((k, v) for k, v in aligned.items() if k in existing_sections)
    leftover = OrderedDict((k, v) for k, v in aligned.items() if k not in existing_sections)
    template_sections = parse_sections(template_skeleton(cfg, type_))
    if leftover and template_sections:
        leftover = align_sections(leftover, template_sections)
    merged_body = merge_sections(existing_sections,
                                 OrderedDict(list(resolved.items()) + list(leftover.items())),
                                 report)
    merged_text = "\n".join(preamble).strip("\n")
    if merged_text:
        merged_text += "\n\n" + build_body(merged_body)
    else:
        merged_text = build_body(merged_body)
    text = ("---\n" + serialize_simple_yaml(fields) + "\n---\n\n"
            + normalize_note_body(merged_text, title, report, template_footer(cfg, type_)))
    entries = _image_entries(cfg, title, fields, images, auto_images)
    if entries:
        text = insert_images(text, entries)
        report.append("配图：" + "、".join(str(e.get("file")) for e in entries))
    return text


def summarize_merge(report: list) -> str:
    """把 merge 报告压成一行摘要（界面用）：补充/填空/新增/跳过/字段。"""
    def count(prefix: str, *more: str) -> int:
        keys = (prefix,) + more
        return sum(1 for r in (report or []) if r.startswith(keys))
    filled = count("正文填充：", "正文填空", "正文引言填充：")
    added = count("新增小节：")
    kept = count("正文保留已有：")
    fld = count("frontmatter 填充：")
    bits = []
    if filled:
        bits.append(f"补充/填空 {filled} 个小节")
    if added:
        bits.append(f"新增 {added} 个小节")
    if fld:
        bits.append(f"补 {fld} 个字段")
    if kept:
        bits.append(f"保留已有 {kept} 个小节")
    return "；".join(bits) or "没有可补充的新内容"


def section_stats(cfg: dict, path: Path) -> dict:
    """一篇笔记的小节填充情况：{filled, empty, sections:[{label, filled, empty}]}。

    "空"= 该小节里只有 TODO/占位；"已填"= 至少有一行实质内容。界面用它一眼看出这篇还差什么。
    """
    out = {"filled": 0, "empty": 0, "sections": []}
    path = Path(path)
    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        return out
    body = split_frontmatter(text)[1] or text
    for _norm, (label, body_lines) in parse_sections(body).items():
        lines = [b for b in body_lines if str(b).strip()]
        real = [b for b in lines if not _is_placeholder_line(b) and TODO_TEXT not in str(b)]
        item = {"label": label.strip("# ").strip(), "filled": len(real),
                "empty": max(0, len(lines) - len(real))}
        out["sections"].append(item)
        if item["filled"]:
            out["filled"] += 1
        else:
            out["empty"] += 1
    return out


def find_existing_note(cfg: dict, title: str, type_: str = "",
                       extra_terms: list | None = None) -> dict:
    """查重：知识库里有没有这篇词条（同名词条 + 相近名建议），并给出已有小节的填充情况。

    返回 {found, path, matches:[{path,dir,title,size_kb,mtime,sections:[{label,filled,empty}]}],
          suggestions:[{title,path,dir}], route_hint}
    """
    out = {"found": False, "path": "", "matches": [], "suggestions": [], "route_hint": ""}
    kb = resolve_kb(cfg)
    name = sanitize_title(title or "")
    if kb is None or not name:
        return out
    paths = find_note_paths(cfg, name)
    dir_hint, _status = resolve_route_dir(cfg, type_) if type_ else (None, "")
    out["route_hint"] = str(dir_hint) if dir_hint else ""
    target = (dir_hint / f"{name}.md") if dir_hint else None
    if target is not None and target.is_file() and target not in paths:
        paths.insert(0, target)
    for p in paths:
        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue
        secs = section_stats(cfg, p)["sections"]
        try:
            stat = p.stat()
            size_kb = round(stat.st_size / 1024, 1)
            mtime = datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M")
        except Exception:
            size_kb, mtime = 0.0, ""
        out["matches"].append({"path": str(p), "dir": p.parent.name, "title": p.stem,
                               "size_kb": size_kb, "mtime": mtime, "sections": secs})
    out["found"] = bool(out["matches"])
    if out["matches"]:
        out["path"] = out["matches"][0]["path"]
    # 相近名建议（名字互相包含），方便用户发现"其实已经建过、只是名字略不同"
    terms = [t for t in ([name] + list(extra_terms or [])) if t and len(str(t)) >= 2]
    seen = {m["path"] for m in out["matches"]}
    for p in kb.rglob("*.md"):
        if _is_skipped_path(p) or str(p) in seen:
            continue
        stem = p.stem
        if any(str(t) in stem or stem in str(t) for t in terms):
            out["suggestions"].append({"title": stem, "path": str(p), "dir": p.parent.name})
        if len(out["suggestions"]) >= 12:
            break
    return out


def _is_skipped_path(p: Path) -> bool:
    """跳过模板/附件/资产目录（用子串匹配，像 `Templates（模板）` 这种带后缀的也算）。"""
    skip = ("Templates", "模板", "Assets", "Attachments", "附件", "资产")
    return any(k in str(part) for part in p.parts for k in skip)


def list_notes(cfg: dict, keyword: str = "", limit: int = 400) -> list:
    """列出知识库里的词条（⑦ 补充更新页选目标条目用）。

    keyword 支持**多个词（空格分隔，全部命中才算）**，忽略大小写；为空则按目录顺序列出。
    """
    kb = resolve_kb(cfg)
    if kb is None:
        return []
    terms = [t for t in re.split(r"\s+", str(keyword or "").strip().lower()) if t]
    out = []
    for p in sorted(kb.rglob("*.md")):
        if _is_skipped_path(p):
            continue
        if terms:
            hay = (p.stem + " " + p.parent.name).lower()
            if not all(t in hay for t in terms):
                continue
        try:
            st = p.stat()
            out.append({"title": p.stem, "dir": p.parent.name, "path": str(p),
                        "size_kb": round(st.st_size / 1024, 1),
                        "mtime": datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")})
        except Exception:
            continue
        if len(out) >= limit:
            break
    return out


def detect_type_of_note(cfg: dict, path: Path | None = None, text: str = "") -> str:
    """判断一篇笔记属于哪个类型：frontmatter 的 type → 所在目录对应的类型。"""
    if path is not None:
        try:
            text = Path(path).read_text(encoding="utf-8")
        except Exception:
            pass
    fields, _body = split_frontmatter(text or "")
    if isinstance(fields, dict):
        t = str(fields.get("type") or "").strip()
        if t:
            return t
    if path is not None:
        d = normalize_dir_name(Path(path).parent.name)
        for type_, dirname in (cfg.get("routes") or {}).items():
            if normalize_dir_name(dirname) == d:
                return type_
    return ""


def _add_missing_template_sections(cfg: dict, type_: str, text: str, report: list,
                                   title: str = "") -> str:
    """把模板里有、笔记里没有的 **顶级 `##` 小节**补成 TODO（放在页脚之前）。"""
    if not type_:
        return text
    try:
        template_sections = parse_sections(template_skeleton(cfg, type_))
    except Exception:
        return text
    if not template_sections:
        return text
    fields, body = split_frontmatter(text)
    fields, body = (fields or {}), (body or text)
    current = parse_sections(body)
    preamble, _rest = _split_preamble(body)
    have = {section_clean_name(k) for k in current}
    merged = OrderedDict(current)
    added = []
    for norm, (label, _b) in template_sections.items():
        clean = section_clean_name(norm)
        if not label.strip().startswith("## ") or clean in have or "参考资料" in clean:
            continue
        merged[norm] = [label, ["- " + TODO_TEXT]]
        added.append(label.strip("# ").strip())
    if not added:
        return text
    report.append("补齐模板缺失小节：" + "、".join(added[:6]) + ("…" if len(added) > 6 else "")
                  + "（已写 TODO）")
    head = "\n".join(preamble).strip("\n")
    merged_text = (head + "\n\n" if head else "") + build_body(merged)
    return ("---\n" + serialize_simple_yaml(fields) + "\n---\n\n"
            + normalize_note_body(merged_text, title or str((fields or {}).get("title") or ""),
                                  report, template_footer(cfg, type_)))


def update_note_file(cfg: dict, path: Path, sections: OrderedDict | None = None,
                     fields: dict | None = None, summary: str = "", images: list | None = None,
                     add_missing_sections: bool = False, dry_run: bool = True,
                     plain_text: str = "") -> dict:
    """把内容整合进**指定的** .md（⑦ 补充更新页用）：

    * 自动按模板对齐小节（`## 事件经过` → `## 📅 事件经过`），模板变量/字段照格式规范合并；
    * **只填空、只追加缺失小节，已有内容一律保留**；整篇还会按格式规范归一（唯一 H1、TODO 占位、页脚）；
    * `add_missing_sections=True` 时把模板里有、笔记里没有的顶级小节补成 TODO；
    * `plain_text`：粘贴内容没有 `##` 小节时，整段塞进**第一个空小节**（笔记里的优先，其次模板里的）；
    * `dry_run=True` 只返回整合后的全文与改动摘要，不写盘。
    返回 {ok, path, action, type, title, text, report, summary, changes}
    """
    path = Path(path)
    out = {"ok": False, "path": str(path), "action": "", "type": "", "title": path.stem,
           "text": "", "report": [], "summary": "", "changes": {}}
    if not path.is_file():
        out["report"].append(f"文件不存在：{path}")
        return out
    type_ = detect_type_of_note(cfg, path)
    out["type"] = type_
    report: list = []
    if not sections and str(plain_text or "").strip():
        # 没有 ## 分段 → 找第一个空小节装进去（笔记里的优先，其次模板里的）
        try:
            exist_body = split_frontmatter(path.read_text(encoding="utf-8"))[1] or ""
        except Exception:
            exist_body = ""
        exist_secs = parse_sections(exist_body)
        tpl_secs = parse_sections(template_skeleton(cfg, type_)) if type_ else OrderedDict()
        pick = next((n for n, (_lab, b) in exist_secs.items() if is_fillable(b)), None)
        pool = exist_secs if pick is not None else tpl_secs
        if pick is None:
            pick = next((n for n, (_lab, b) in tpl_secs.items() if is_fillable(b)), None)
        if pick is not None:
            label = (pool.get(pick) or tpl_secs.get(pick) or [pick])[0]
            sections = OrderedDict({pick: [label, [ln for ln in str(plain_text).splitlines()
                                                 if ln.strip()]]})
            report.append(f"内容没有 ## 小节 → 整段放进「{label.strip('# ').strip()}」")
    text = merge_into_existing(cfg, path, type_, path.stem, fields or {},
                               sections or OrderedDict(), report, images=images,
                               auto_images=bool(images))
    if add_missing_sections:
        text = _add_missing_template_sections(cfg, type_, text, report, path.stem)
    out["text"] = text
    out["report"] = report
    out["summary"] = summarize_merge(report) if sections else "仅按格式规范整理（未加新内容）"
    out["changes"] = {
        "filled": sum(1 for r in report if r.startswith(("正文填充：", "正文填空", "正文引言填充："))),
        "added": sum(1 for r in report if r.startswith("新增小节：")),
        "kept": sum(1 for r in report if r.startswith("正文保留已有：")),
        "fields": sum(1 for r in report if r.startswith("frontmatter 填充：")),
    }
    if dry_run:
        out.update(ok=True, action="预览")
        return out
    before = path.read_text(encoding="utf-8")
    dest = backup_note(path, resolve_kb(cfg))
    if dest is not None:
        try:
            rel = dest.relative_to(backup_root(create=False))
        except Exception:
            rel = Path(dest.name)
        report.append(f"旧版已备份：{BACKUP_DIR_NAME}/{rel}")
    if text.strip() == before.strip():
        out.update(ok=True, action="无改动", report=report + ["文件内容没有变化，未写盘"])
        return out
    path.write_text(text, encoding="utf-8")
    _sync_templates_on_write(cfg, report)
    out.update(ok=True, action="补充更新", report=report)
    return out


# ---------------------------------------------------------------------------
# 正文关键词双链：把正文里出现的知识库词条名自动包成 [[ ]]（已有链接/代码/图片不动）
# ---------------------------------------------------------------------------
LINK_SKIP_TITLE_PARTS = ("索引", "总览", "首页", "目录", "模板", "清单")
# 过于通用的短名：正文里多是"泛指"，默认不链（可用 cfg["link_skip_words"] 覆盖/增补）
LINK_GENERIC_SKIP = ("中国", "日本", "美国", "英国", "苏联", "德国", "法国", "俄国", "欧洲", "世界")
# 事件类词条的通称后缀：`九一八事变` 这种，正文里常写成「九一八」，允许再匹配一个简称
LINK_SHORT_SUFFIXES = ("事变", "事件", "战争", "会战", "战役", "战斗", "运动", "起义",
                       "政变", "罢工", "惨案", "屠杀", "条约", "协定", "会议", "谈判")
LINK_SHORT_MIN = 3          # 简称至少 3 个字（避免「西安事变 → 西安」这种把地名链进去）
LINK_NAME_SUFFIXES = ("战争", "战役", "战斗", "会战", "事变", "事件", "冲突", "运动", "起义",
                      "政变", "罢工", "惨案", "屠杀", "协定", "议定书", "条约", "会议", "谈判")


def name_core(name: str) -> str:
    """取名字的"主干"：去掉战争/事变/协定/会议这类后缀，用于把同一实体的多种写法归并。"""
    s = str(name or "").strip()
    for _ in range(2):                                # 最多剥两层（如 中东路战争 → 中东路）
        for suf in LINK_NAME_SUFFIXES:
            if s.endswith(suf) and len(s) - len(suf) >= 2:
                s = s[: -len(suf)]
                break
        else:
            break
    return s
# 这些小节/行里的词不链：参考资料里的书名、图片署名行里的网站与许可名
LINK_SKIP_SECTION_PARTS = ("参考资料", "参考", "引用", "注释", "来源", "延伸阅读", "参考文献", "书目")
LINK_SKIP_LINE_RE = re.compile(r"图片来源|来源[：:]|License|许可|维基百科|Wikimedia|公有领域")
# 期刊/网站/许可这类"非词条"字样，即使出现在正文也不当双链目标
LINK_BOILERPLATE = ("维基百科", "Wikipedia", "Wikimedia", "Public domain", "公有领域",
                    "知识共享", "Creative Commons", "CC BY", "GFDL", "Obsidian", "Dataview")


def title_variants(title: str, short_forms: bool = True) -> list:
    """一个词条名可以匹配的写法：原名、去掉年份前缀（`1931年-九一八事变` → `九一八事变`）、简称。"""
    out = []
    t = str(title or "").strip()
    if not t:
        return out
    out.append(t)
    bare = re.sub(r"^\d{3,4}\s*年\s*[-—－–]?\s*", "", t).strip()
    if bare and bare != t:
        out.append(bare)
    if short_forms:
        for base in list(out):
            for suf in LINK_SHORT_SUFFIXES:
                if base.endswith(suf) and len(base) - len(suf) >= LINK_SHORT_MIN:
                    stem = base[: -len(suf)]
                    if stem not in out and not any(k in stem for k in LINK_SKIP_TITLE_PARTS):
                        out.append(stem)
                    break
    seen, uniq = set(), []
    for x in out:
        if x and x not in seen:
            seen.add(x)
            uniq.append(x)
    return uniq
LINK_PROTECT_RE = re.compile(
    r"(\[\[[^\]]*\]\]"            # 已有 wiki 链接
    r"|!\[[^\]]*\]\([^)]*\)"      # markdown 图片
    r"|`[^`]*`"                   # 行内代码
    r"|<[^>]+>"                   # HTML 标签
    r"|https?://\S+)"             # 网址
)


def build_link_index(cfg: dict, min_len: int = 2, short_forms: bool = True,
                     only_resolved: bool = False) -> list:
    """候选写法表：[(可匹配写法, 目录, **真实词条名**)]，按长度从长到短。

    每个词条会贡献：原名、**去掉年份前缀的名字**（`1931年-九一八事变` → `九一八事变`）、
    frontmatter 里的 aliases、以及事件类词条的**简称**（`九一八事变` → `九一八`）。
    第三项是真名，用于把「正文里的通称」链到「能解析的真实词条」（`[[1931年-九一八事变|九一八事变]]`）。

    `only_resolved=True` 时只保留**库内确有对应笔记**的写法（避免写出一堆红链）。
    """
    out: list = []
    resolved: set = set()
    if only_resolved:
        kb = resolve_kb(cfg)
        if kb is not None:
            resolved = {p.stem for p in kb.rglob("*.md") if not _is_skipped_path(p)}
    for n in list_notes(cfg):
        title = str(n.get("title") or "").strip()
        if len(title) < min_len or any(k in title for k in LINK_SKIP_TITLE_PARTS):
            continue
        names = title_variants(title, short_forms)
        try:
            fields, _body = split_frontmatter(Path(n["path"]).read_text(encoding="utf-8"))
        except Exception:
            fields = {}
        aliases = (fields or {}).get("aliases")
        if isinstance(aliases, str):
            aliases = [aliases]
        for a in (aliases or []):
            a = str(a).strip()
            if len(a) >= min_len and not any(k in a for k in LINK_SKIP_TITLE_PARTS):
                names.extend(title_variants(a, short_forms))
        for name in names:
            if len(name) >= min_len:
                out.append((name, n.get("dir") or "", title))
    # 再把「链接词表」里的写法并进来（AI 识别过的别名/通称/已有管道链接，零 token 复用）
    terms = (load_term_dictionary().get("terms") or {})
    for disp, real in terms.items():
        disp, real = str(disp).strip(), str(real).strip()
        if len(disp) >= min_len and real:
            out.append((disp, "", real))
    if only_resolved:                                  # 只留能解析到真实笔记的写法
        out = [x for x in out if str(x[2]) in resolved]
    out.sort(key=lambda x: -len(x[0]))
    return out


def compile_link_pattern(index: list):
    """把候选写法编成一个正则：**长的在前**，`|` 交替从左到右匹配，短名不会吃掉长名。"""
    titles = sorted({str(t) for t, *_rest in (index or []) if str(t).strip()},
                    key=len, reverse=True)
    if not titles:
        return None
    return re.compile("|".join(re.escape(t) for t in titles))


TERM_DICT_FILE = "_链接词表.json"
LINK_FILE_EXT_RE = re.compile(r"\.(?:png|jpe?g|webp|gif|bmp|svg|pdf|docx?|xlsx?|pptx?|md|txt|zip)$", re.I)


def _looks_like_file(name: str) -> bool:
    """名字像文件名/附件（图片、pdf、md…）就不当词条。"""
    return bool(LINK_FILE_EXT_RE.search(str(name or "").strip()))


def term_dict_path() -> Path:
    """词表文件：默认在程序目录；可用环境变量 KB_TERM_DICT 改到别处（测试用）。"""
    env = (os.environ.get("KB_TERM_DICT") or "").strip()
    return Path(env) if env else (app_dir() / TERM_DICT_FILE)


def build_term_dictionary(cfg: dict, save: bool = True) -> dict:
    """扫全库生成"链接词表"（**零 token**）：

    * 词条名 + 去掉年份前缀的写法 + frontmatter aliases；
    * 正文里已有的 `[[目标|显示写法]]` → 显示写法指向目标；`[[目标]]` → 目标指向自己；
    * 库内没有对应笔记的名字（红链/待建）单独存一份，供"该建哪些词条"清单使用。

    这样 AI 只在一篇里认出来的写法（如「九一八事变」指到 `1931年-九一八事变`），
    以后在**任何**笔记里都能被本地引擎免费链上。
    """
    out = {"version": 1, "built": datetime.now().strftime("%Y-%m-%d %H:%M"),
           "terms": {}, "unresolved": []}
    kb = resolve_kb(cfg)
    if kb is None:
        return out
    terms: dict = {}
    for n in list_notes(cfg):
        title = str(n.get("title") or "").strip()
        if not title:
            continue
        for v in title_variants(title):
            terms.setdefault(v, title)
        try:
            text = Path(n["path"]).read_text(encoding="utf-8")
        except Exception:
            continue
        fields, body = split_frontmatter(text)
        al = (fields or {}).get("aliases")
        if isinstance(al, str):
            al = [al]
        for a in (al or []):
            for v in title_variants(str(a).strip()):
                terms.setdefault(v, title)
        for m in re.finditer(r"(?<!!)\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", body or ""):
            target = m.group(1).strip()
            disp = (m.group(2) or "").strip()
            if _looks_like_file(target) or re.match(r"^\d{2}\s*\S", target):
                continue                              # 图片/附件、模块导航链接（如 01时间线）不当词条
            if disp and not _looks_like_file(disp):
                terms.setdefault(disp, target)
            if target:
                terms.setdefault(target, target)
    names = {p.stem for p in kb.rglob("*.md") if not _is_skipped_path(p)}
    out["terms"] = terms
    fresh = {t for t in terms if terms[t] == t and t not in names}
    old = set()
    try:                                              # 与已有清单取并集：重建不会丢掉"待建词条"积累
        old = {str(x) for x in (load_term_dictionary().get("unresolved") or [])}
    except Exception:
        pass
    out["unresolved"] = sorted(fresh | old)
    if save:
        try:
            term_dict_path().write_text(json.dumps(out, ensure_ascii=False, indent=1),
                                        encoding="utf-8")
        except Exception:
            pass
    return out


def load_term_dictionary() -> dict:
    """读词表；没有或损坏就返回空 dict（不影响其它功能）。"""
    p = term_dict_path()
    if not p.is_file():
        return {}
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def link_map_from_index(index: list) -> dict:
    """候选表 → `写法: 链接文本`：写法与真实词条名不同时用管道链接 `[[真实|写法]]`。"""
    out: dict = {}
    for name, _d, real in (index or []):
        name, real = str(name or ""), str(real or "")
        if name and real and name != real:
            out.setdefault(name, f"[[{real}|{name}]]")
    return out


def link_keywords_in_text(text: str, index: list, self_title: str = "",
                          first_only: bool = True, skip_headings: bool = True,
                          max_links: int = 80, pattern=None,
                          skip_titles=None, link_map: dict | None = None,
                          skip_sections=None, skip_line_re=None) -> tuple:
    """把正文里出现的词条名包成 `[[ ]]`。返回 (新文本, 新增链接列表)。

    * frontmatter、已有 `[[ ]]`、图片、行内代码、网址一律不动；
    * 标题行默认跳过（`skip_headings=True`）；代码块内不动；
    * 默认每个词条只链第一次（`first_only=True`）；`skip_titles`（含自己标题/别名）不链；
    * `link_map`：匹配到的写法 → 要写入的链接（如 `{"九一八": "[[1931年-九一八事变|九一八]]"}`）；
    * `skip_sections`：这些小节名（含子串）里的内容一律不链（默认参考资料/引用/延伸阅读…）；
      `skip_line_re`：匹配的行不链（默认图片署名行、"来源："、"许可"…）；
    * 总数上限 `max_links`。
    """
    fields, body = split_frontmatter(text)
    body = body if fields is not None else text
    pattern = pattern or compile_link_pattern(index)
    if pattern is None and not link_map:
        return text, []
    skip = {str(x) for x in (skip_titles or ()) if str(x).strip()}
    if self_title:
        skip.add(str(self_title))
    if link_map:
        keys = set(link_map) | {str(t) for t, *_r in (index or []) if str(t).strip()}
        pattern = re.compile("|".join(re.escape(k) for k in
                                      sorted(keys, key=len, reverse=True)))
    skip_sections = tuple(LINK_SKIP_SECTION_PARTS if skip_sections is None else skip_sections)
    line_re = LINK_SKIP_LINE_RE if skip_line_re is None else skip_line_re
    used: set = set()
    added: list = []
    out: list = []
    in_fence = False
    cur_section = ""

    def link_seg(seg: str) -> str:
        def repl(m):
            t = m.group(0)
            if t in skip or (first_only and t in used) or len(added) >= max_links:
                return t
            used.add(t)
            added.append(t)
            return (link_map or {}).get(t) or f"[[{t}]]"
        return pattern.sub(repl, seg)

    for line in (body or "").splitlines():
        s = line.strip()
        if s.startswith("#"):
            cur_section = section_clean_name(s)          # 记住当前小节（下面按小节跳过）
            out.append(line)
            continue
        if s.startswith("```"):
            in_fence = not in_fence
            out.append(line)
            continue
        if in_fence or (skip_headings and s.startswith("#")):
            out.append(line)
            continue
        if any(k in cur_section for k in skip_sections) or (line_re and line_re.search(line)):
            out.append(line)
            continue
        parts = LINK_PROTECT_RE.split(line)
        out.append("".join(p if (i % 2) else link_seg(p) for i, p in enumerate(parts)))
    new_body = "\n".join(out)
    if fields is not None:
        return "---\n" + serialize_simple_yaml(fields) + "\n---\n\n" + new_body, added
    return new_body, added


def note_own_names(cfg: dict, path: Path) -> set:
    """这篇笔记自己的标题 + 别名（不给自己加双链）。"""
    path = Path(path)
    names = {path.stem}
    try:
        fields, _b = split_frontmatter(path.read_text(encoding="utf-8"))
        al = (fields or {}).get("aliases")
        if isinstance(al, str):
            al = [al]
        names |= {str(a).strip() for a in (al or []) if str(a).strip()}
    except Exception:
        pass
    return names


def link_skip_words(cfg: dict) -> set:
    """默认不链的通用短名（cfg["link_skip_words"] 可覆盖）。"""
    custom = cfg.get("link_skip_words")
    if isinstance(custom, (list, tuple)) and custom:
        return {str(x).strip() for x in custom if str(x).strip()}
    return set(LINK_GENERIC_SKIP)


