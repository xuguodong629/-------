def kb_stats(cfg: dict) -> dict:
    kb = resolve_kb(cfg)
    out = {"ok": False, "root": "", "rows": [], "total": 0, "content_total": 0}
    if kb is None:
        return out
    out["ok"] = True
    out["root"] = str(kb)
    total = 0
    content_total = 0
    for r in scan_kb(kb):
        d = Path(r["path"])
        n = len(list(d.glob("*.md")))
        total += n
        if r["role"] == "内容目录":
            content_total += n
        out["rows"].append((r["name"], r["role"], n))
    out["total"] = total
    out["content_total"] = content_total
    return out


