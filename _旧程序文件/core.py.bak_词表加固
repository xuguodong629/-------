def suggest_routes_for_kb(cfg: dict, dirs=None) -> dict:
    """按**当前知识库**的目录名，为每个类型挑一个最像的目录（换知识库时一键重排映射）。

    返回 {类型: 目录名}；挑不出来的类型给空串（界面上会标出来让你手填）。
    只做"名字像不像"的判断，不会动任何文件。
    """
    kb = resolve_kb(cfg)
    if kb is None:
        return {}
    names = list(dirs or [r["name"] for r in scan_kb(kb) if r.get("role") != "系统目录"])
    used: set = set()
    out: dict = {}
    for t in (cfg.get("routes") or {}):
        best, best_score = "", 0
        for nm in names:
            if nm in used:
                continue
            score = 0
            for kw in ROUTE_HINTS.get(t, (t,)):
                if kw and kw in nm:
                    score += 12 if kw == t else (8 if t in kw or kw in t else 5)
            if score > best_score:
                best, best_score = nm, score
        if best:
            used.add(best)
        out[t] = best
    return out


def apply_routes(cfg: dict, mapping: dict, save: bool = True) -> dict:
    """把 {类型: 目录名} 写进 cfg["routes"] 并（可选）落盘；返回实际改动。"""
    routes = cfg.setdefault("routes", {})
    changed = {}
    for t, d in (mapping or {}).items():
        t, d = str(t).strip(), str(d or "").strip()
        if not t or not d:
            continue
        if routes.get(t) != d:
            changed[t] = f"{routes.get(t) or '（未设置）'} → {d}"
            routes[t] = d
    if changed and save:
        save_config(cfg)
    return changed


def ensure_route_dirs(cfg: dict, create: bool = True, extra: tuple = ()) -> dict:
    """按②页映射在**当前知识库**里创建/检查每个类型的目录（换时期库、新建库时用）。

    * `extra`：额外要建的目录名（如 `("00 首页", "Assets（图片地图）", "Attachments（PDF）")`）；
    * `create=False` 只检查不创建。
    返回 {ok, kb, created:[...], existing:[...], failed:[...], report:[...]}
    """
    out = {"ok": False, "kb": "", "created": [], "existing": [], "failed": [], "report": []}
    kb = resolve_kb(cfg)
    if kb is None:
        out["report"].append("没有设置知识库目录（请到①页选目录）")
        return out
    out["kb"] = str(kb)
    want: list = []
    for t, d in (cfg.get("routes") or {}).items():
        d = str(d or "").strip()
        if d and d not in want:
            want.append(d)
    for d in extra:
        d = str(d or "").strip()
        if d and d not in want:
            want.append(d)
    if not want:
        out["report"].append("②页还没有配置任何「类型 → 目录」映射")
        return out
    for name in want:
        p = Path(name)
        if not p.is_absolute():
            p = kb / name
        if p.is_dir():
            out["existing"].append(name)
            continue
        if not create:
            out["report"].append(f"缺失：{name}")
            continue
        try:
            p.mkdir(parents=True, exist_ok=True)
            out["created"].append(name)
        except Exception as exc:  # noqa: BLE001
            out["failed"].append(name)
            out["report"].append(f"创建失败：{name}（{type(exc).__name__}: {exc}）")
    out["ok"] = not out["failed"]
    out["report"].append(f"目录检查：已存在 {len(out['existing'])} 个"
                         + (f"｜新建 {len(out['created'])} 个" if create else "")
                         + (f"｜失败 {len(out['failed'])} 个" if out["failed"] else ""))
    if out["created"]:
        out["report"].append("新建：" + "、".join(out["created"][:20])
                             + ("…" if len(out["created"]) > 20 else ""))
    return out


def create_kb_structure(kb_path, cfg: dict | None = None, copy_templates_from=None,
                        with_system_dirs: bool = True) -> dict:
    """在一个目录里建出"类型目录 + 系统目录"的完整结构（新开一个时期库时用）。

    目录名取自 `cfg["routes"]`（没传 cfg 就用当前配置）；`copy_templates_from` 给一个模板目录时，
    会把里面的 `.md` 复制进新库的 `Templates（模板）`（**已存在的不覆盖**）。
    """
    cfg = cfg or load_config()
    kb = Path(str(kb_path)).expanduser()
    res = {"ok": False, "kb": str(kb), "created": [], "existing": [], "failed": [],
           "templates_copied": [], "report": []}
    try:
        kb.mkdir(parents=True, exist_ok=True)
    except Exception as exc:  # noqa: BLE001
        res["report"].append(f"知识库目录创建失败：{type(exc).__name__}: {exc}")
        return res
    names = [str(d).strip() for d in (cfg.get("routes") or {}).values() if str(d).strip()]
    if with_system_dirs:
        for extra in ("00 首页", "Templates（模板）", "Assets（图片地图）", "Attachments（PDF）"):
            if extra not in names:
                names.append(extra)
    for name in names:
        p = kb / name
        if p.is_dir():
            res["existing"].append(name)
            continue
        try:
            p.mkdir(parents=True, exist_ok=True)
            res["created"].append(name)
        except Exception as exc:  # noqa: BLE001
            res["failed"].append(name)
            res["report"].append(f"创建失败：{name}（{type(exc).__name__}: {exc}）")
    if copy_templates_from:
        src = Path(str(copy_templates_from)).expanduser()
        dst = kb / "Templates（模板）"
        if src.is_dir():
            for f in sorted(src.glob("*.md")):
                target = dst / f.name
                if target.exists():
                    continue
                try:
                    target.write_text(f.read_text(encoding="utf-8"), encoding="utf-8")
                    res["templates_copied"].append(f.name)
                except Exception:
                    pass
    res["ok"] = not res["failed"]
    res["report"].append(f"已建目录 {len(res['created'])} 个、已存在 {len(res['existing'])} 个"
                         + (f"、复制模板 {len(res['templates_copied'])} 个" if res["templates_copied"] else ""))
    return res


def create_skeleton_note(cfg: dict, name: str, type_: str = "", target_dir: str = "",
                         dry_run: bool = True, overwrite: bool = False,
                         summary: str = "") -> dict:
    """建一篇"只有骨架（TODO 占位）"的词条：按类型选模板 → 放进类型对应目录。

    * 已存在同名笔记：默认**跳过**；`overwrite=True` 改为"只补空缺"（绝不覆盖已有内容）；
    * `target_dir` 为空则用 `cfg["routes"]`（② 类型映射页）里的目录；
    * `dry_run=True` 只报告会建到哪，不动文件。
    返回 {ok, name, type, dir, path, action, report}
    """
    out = {"ok": False, "name": str(name or "").strip(), "type": "", "dir": "", "path": "",
           "action": "", "report": []}
    kb = resolve_kb(cfg)
    if kb is None:
        out["report"].append("没有设置知识库目录（请到①页选目录）")
        return out
    title = sanitize_title(str(name or "").strip())
    if not title:
        out["report"].append("名字为空，跳过")
        return out
    out["name"] = title
    t = str(type_ or "").strip() or guess_note_type(title)
    out["type"] = t
    routes = cfg.get("routes") or {}
    rel = str(target_dir or "").strip() or str(routes.get(t) or "").strip()
    if not rel:
        out["report"].append(f"类型「{t}」没有对应目录（可到②页配映射，或指定目标目录）")
        return out
    dest_dir = Path(rel)
    if not dest_dir.is_absolute():
        dest_dir = kb / rel
    path = dest_dir / f"{title}.md"
    out["dir"] = dest_dir.name
    out["path"] = str(path)
    exists = path.exists()
    if exists and not overwrite:
        out.update(ok=True, action="已存在，跳过",
                   report=[f"已有同名笔记：{dest_dir.name}/{title}.md（未改动）"])
        return out
    if dry_run:
        out.update(ok=True, action="预览",
                   report=[f"将{'补充空缺' if exists else '新建'}：{dest_dir.name}/{title}.md"
                           f"（类型：{t}，模板：{resolve_template(cfg, t)[1]}）"])
        return out
    try:
        dest_dir.mkdir(parents=True, exist_ok=True)
    except Exception as exc:  # noqa: BLE001
        out["report"].append(f"目录创建失败：{type(exc).__name__}: {exc}")
        return out
    r = write_note(cfg, t, title, str(summary or ""), {}, OrderedDict(),
                   mode=("auto" if exists else "create"))
    out.update(ok=bool(r.get("ok")), action=r.get("action") or "",
               path=str(r.get("path") or path),
               report=out["report"] + [str(x) for x in (r.get("report") or [])])
    return out


def create_skeleton_notes(cfg: dict, keywords, type_: str = "", target_dir: str = "",
                          dry_run: bool = True, overwrite: bool = False,
                          limit: int = 0, on_progress=None) -> dict:
    """批量建骨架。keywords 可以是多行文本或列表，每行支持 `类型:名称`。"""
    items = parse_keyword_lines(keywords, default_type=type_, default_dir=target_dir)
    if limit:
        items = items[:limit]
    created, skipped, failed, detail = [], [], [], []
    for i, it in enumerate(items, 1):
        r = create_skeleton_note(cfg, it["name"], it["type"] or type_,
                                 it["dir"] or target_dir, dry_run=dry_run,
                                 overwrite=overwrite)
        line = (f"{it['name']} → {r.get('action')}"
                f"（{r.get('dir') or '—'}｜类型：{r.get('type') or '—'}）")
        detail.append(line)
        if not r.get("ok"):
            failed.append(it["name"])
        elif r.get("action") in ("新建", "增量更新", "预览"):
            created.append(f"{r.get('dir')}/{it['name']}")
        else:
            skipped.append(it["name"])
        if callable(on_progress):
            try:
                on_progress(i, len(items), line)
            except Exception:
                pass
    return {"ok": not failed, "total": len(items), "created": created, "skipped": skipped,
            "failed": failed, "report": detail, "dry_run": dry_run}


def link_keywords(cfg: dict, path: Path, dry_run: bool = True, first_only: bool = True,
                  skip_headings: bool = True, max_links: int = 80,
                  only_resolved: bool = True) -> dict:
    """给**一篇**笔记补正文关键词双链（dry_run 默认只预览，不写盘）。

    返回 {ok, path, action, added, report, text}
    """
    path = Path(path)
    out = {"ok": False, "path": str(path), "action": "", "added": [], "report": [], "text": ""}
    if not path.is_file():
        out["report"].append(f"文件不存在：{path}")
        return out
    index = build_link_index(cfg, only_resolved=only_resolved)
    skip = link_skip_words(cfg) | note_own_names(cfg, path)
    text = path.read_text(encoding="utf-8")
    new_text, added = link_keywords_in_text(text, index, self_title=path.stem,
                                            first_only=first_only,
                                            skip_headings=skip_headings, max_links=max_links,
                                            skip_titles=skip,
                                            link_map=link_map_from_index(index))
    out.update(ok=True, added=added, text=new_text)
    if not added:
        out.update(action="无改动", report=["正文里没有可补双链的词条（或已全部链过）"])
        return out
    out["report"] = [f"新增双链 {len(added)} 个：" + "、".join(f"[[{a}]]" for a in added[:12])
                     + ("…" if len(added) > 12 else "")]
    if dry_run:
        out["action"] = "预览"
        return out
    if new_text.strip() == text.strip():
        out.update(action="无改动", report=out["report"] + ["内容没有变化，未写盘"])
        return out
    dest = backup_note(path, resolve_kb(cfg))
    if dest is not None:
        try:
            rel = dest.relative_to(backup_root(create=False))
        except Exception:
            rel = Path(dest.name)
        out["report"].append(f"旧版已备份：{BACKUP_DIR_NAME}/{rel}")
    path.write_text(new_text, encoding="utf-8")
    out["action"] = "已补双链"
    return out


LINK_AI_PROMPT = """请从下面这段历史笔记正文里找出所有**专有名词**，只输出 JSON：
{{"entities": ["…", "…"]}}

要求：
1. 只列**正文里逐字出现过**的词（照抄原文写法，不要改写、不要补充正文里没有的）；
2. 专名优先：历史人物、历史事件、战争/战役、政变、起义、运动、党派/军队/组织、
   条约/协定/文件、会议、制度/政策、地名/据点、报刊/著作；
   **不要**列普通名词（如「军队」「政府」「时间」这类泛称）；
3. **同一实体只列一个最通行、最完整的名称**：不要同时列出「中东路」「中东铁路」「中东路战争」
   这种同一回事的不同写法；也不要把「某会议」和它通过的「议定书」当成两个实体；
4. 最多 {max_n} 条；不要解释、不要 Markdown 围栏。

正文：
{body}
"""


def ai_client_from_config(cfg: dict, timeout: int = 300):
    """按 config.json 的 ai 节点建一个 AIClient；没配 API Key 时返回 None。"""
    from ai_client import AIClient

    ai = (cfg or {}).get("ai") or {}
    if not str(ai.get("api_key") or "").strip():
        return None
    try:
        return AIClient(ai.get("base_url") or "https://api.deepseek.com/v1",
                        str(ai.get("api_key") or ""), ai.get("model") or "deepseek-chat",
                        float(ai.get("temperature", 0.3) or 0.3), timeout=timeout,
                        max_tokens=int(ai.get("max_tokens", 8000) or 8000))
    except Exception:
        return None


def ai_entity_names(cfg: dict, text: str, client=None, max_n: int = 80) -> list:
    """让 AI 从正文里挑专有名词。**逐字校验**：正文里没出现过的一律丢掉（防编造）。"""
    client = client or ai_client_from_config(cfg)
    if client is None:
        return []
    body = (split_frontmatter(text)[1] or text)[:8000]
    try:
        obj = client.analyze_topic(LINK_AI_PROMPT.format(max_n=max_n, body=body))
    except Exception:
        return []
    raw = obj.get("entities") if isinstance(obj, dict) else obj
    if isinstance(raw, str):
        raw = [raw]
    flat = re.sub(r"\s+", "", text or "")
    out, seen = [], set()
    for x in (raw or []):
        name = str(x).strip().strip("《》\"'“”（）()[]【】·,，。 ")
        if len(name) < 2 or name in seen:
            continue
        if re.sub(r"\s+", "", name) not in flat:      # 正文里没有 → AI 编造，丢掉
            continue
        seen.add(name)
        out.append(name)
        if len(out) >= max_n:
            break
    return out


def appears_linkable(text: str, name: str) -> bool:
    """这个名字是否出现在"可链区域"（参考资料/引用/署名行等都不算）。"""
    if not name:
        return False
    fields, body = split_frontmatter(text)
    body = body if fields is not None else text
    cur = ""
    for line in (body or "").splitlines():
        s = line.strip()
        if s.startswith("#"):
            cur = section_clean_name(s)
            continue
        if any(k in cur for k in LINK_SKIP_SECTION_PARTS):
            continue
        if LINK_SKIP_LINE_RE.search(line):
            continue
        if name in line:
            return True
    return False


def link_keywords_ai(cfg: dict, path: Path, client=None, dry_run: bool = True,
                     red_links: bool = True, first_only: bool = True,
                     skip_headings: bool = True, max_links: int = 80,
                     max_red: int = 12) -> dict:
    """用 AI 识别正文里的**专有名词**再补双链（比本地规则强：通称、异名、库里还没有的专名）。

    * AI 只负责挑名字，且每个名字都要求**在正文里逐字出现**（防止编造）；
    * 网站/许可/期刊名（维基百科、Wikimedia、Public domain…）不当双链目标；
      参考资料/引用/延伸阅读小节与图片署名行一律不链；
    * 能对上库内词条（含年份前缀变体/别名）→ 写成 `[[真实词条名|正文写法]]`，保证 Obsidian 能解析；
    * 对不上库内词条 → 按 `max_red` 取**正文里出现次数最多**的若干个写成 `[[名字]]`（待建链接），
      其余只在报告清单里列出（避免一篇笔记被几十个红链淹没）。
    返回 {ok, path, action, added, red, report, text, entities}
    """
    path = Path(path)
    out = {"ok": False, "path": str(path), "action": "", "added": [], "red": [],
           "report": [], "text": "", "entities": []}
    if not path.is_file():
        out["report"].append(f"文件不存在：{path}")
        return out
    text = path.read_text(encoding="utf-8")
    names = [n for n in ai_entity_names(cfg, text, client)
             if not any(b in n for b in LINK_BOILERPLATE)]
    if not names:
        out.update(ok=True, action="无改动",
                   report=["AI 没有识别出专名（未配置 API Key、调用失败，或正文太短）"])
        return out
    out["entities"] = names
    index = build_link_index(cfg)
    own = note_own_names(cfg, path)
    by_name: dict = {}
    for name, _d, real in sorted(index, key=lambda x: -len(x[0])):   # 变体写法 → 真实词条名
        by_name.setdefault(name, real or name)
    link_map, red_all = {}, []
    for nm in names:
        if nm in own or any(b in nm for b in LINK_BOILERPLATE):
            continue
        target = by_name.get(nm)
        if target is None:                            # 再按包含关系兜一次（九一八事变 ↔ 1931年-九一八事变）
            for cand, real in by_name.items():
                if len(nm) >= 3 and (nm in cand or cand in nm):
                    target = real
                    break
        if target:
            link_map[nm] = f"[[{target}]]" if target == nm else f"[[{target}|{nm}]]"
        else:
            red_all.append(nm)
    # 待建清单只保留"正文里真出现过"的（参考资料里的出版社/作者名不算）
    red_all = [n for n in red_all if appears_linkable(text, n)]
    # 待建链接限流：按"正文出现次数"排序；同一实体的多种写法（互相包含）只留一个
    red_sorted = sorted(set(red_all), key=lambda n: (-text.count(n), -len(n)))
    picked: list = []
    for nm in red_sorted:
        core_nm = name_core(nm)
        if any(nm in k or k in nm or (len(core_nm) >= 2 and core_nm == name_core(k))
               for k in picked):
            continue                                  # 中东路 / 中东路战争 / 中东铁路 只留最常见的那一个
        picked.append(nm)
        if max_red > 0 and len(picked) >= max_red:
            break
    red = picked
    skipped_red = [n for n in red_sorted if n not in picked]
    if red_links:
        for nm in red:
            link_map[nm] = f"[[{nm}]]"
    if not link_map:
        out.update(ok=True, action="无改动", report=["识别出的专名都已链过、或都属于本条目自身"],
                   red=red_sorted)
        return out
    skip = link_skip_words(cfg) | own
    new_text, added = link_keywords_in_text(text, index, self_title=path.stem,
                                            first_only=first_only,
                                            skip_headings=skip_headings, max_links=max_links,
                                            skip_titles=skip, link_map=link_map)
    out.update(ok=True, added=added, red=red_sorted, text=new_text)
    rep = [f"AI 识别专名 {len(names)} 个 → 新增双链 {len(added)} 个"]
    if red_sorted:
        rep.append(f"库内暂无对应词条（共 {len(red_sorted)} 个）："
                   + "、".join(red_sorted[:10]) + ("…" if len(red_sorted) > 10 else ""))
        if skipped_red:
            rep.append(f"其中 {len(skipped_red)} 个出现次数少，只在清单里、未写红链"
                       + ("（用 --max-red / max_red 可调）" if red_links else ""))
    out["report"] = rep
    if dry_run:
        out["action"] = "预览"
        return out
    if new_text.strip() == text.strip():
        out.update(action="无改动", report=rep + ["内容没有变化，未写盘"])
        return out
    dest = backup_note(path, resolve_kb(cfg))
    if dest is not None:
        try:
            rel = dest.relative_to(backup_root(create=False))
        except Exception:
            rel = Path(dest.name)
        out["report"].append(f"旧版已备份：{BACKUP_DIR_NAME}/{rel}")
    path.write_text(new_text, encoding="utf-8")
    out["action"] = "已补双链（AI 专名）"
    return out


def link_keywords_batch(cfg: dict, dry_run: bool = True, limit: int = 0,
                        first_only: bool = True, skip_headings: bool = True,
                        max_links: int = 80, on_progress=None,
                        only_resolved: bool = True) -> dict:
    """全库批量补正文关键词双链（dry_run 默认只统计，不写盘）。

    返回 {ok, files, changed, links, details:[{title, dir, added:[…]}], report, index}
    """
    index = build_link_index(cfg, only_resolved=only_resolved)
    pattern = compile_link_pattern(index)
    generic_skip = link_skip_words(cfg)
    lmap = link_map_from_index(index)
    try:                                             # 批量前先刷新词表：越链越准，且全程零 token
        build_term_dictionary(cfg, save=True)
        index = build_link_index(cfg, only_resolved=only_resolved)
        pattern = compile_link_pattern(index)
        lmap = link_map_from_index(index)
    except Exception:
        pass
    notes = list_notes(cfg)
    if limit:
        notes = notes[:limit]
    out = {"ok": True, "files": len(notes), "changed": 0, "links": 0,
           "details": [], "report": [], "index": len(index)}
    for i, n in enumerate(notes, 1):
        p = Path(n["path"])
        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue
        new_text, added = link_keywords_in_text(text, index, self_title=p.stem,
                                                first_only=first_only,
                                                skip_headings=skip_headings,
                                                max_links=max_links, pattern=pattern,
                                                skip_titles=generic_skip | note_own_names(cfg, p),
                                                link_map=lmap)
        if on_progress:
            try:
                on_progress(i, len(notes), n)
            except Exception:
                pass
        if not added:
            continue
        out["changed"] += 1
        out["links"] += len(added)
        out["details"].append({"title": n["title"], "dir": n["dir"], "added": added})
        if not dry_run and new_text.strip() != text.strip():
            backup_note(p, resolve_kb(cfg))
            p.write_text(new_text, encoding="utf-8")
    out["report"].append(f"{'可补' if dry_run else '已补'}双链：{out['changed']} 篇、"
                         f"共 {out['links']} 个链接（候选词条 {out['index']} 个）")
    return out


def write_note(cfg: dict, type_: str, title: str, summary: str,
               ai_fields: dict, ai_sections: OrderedDict,
               mode: str = "auto",
               images: list | None = None, auto_images: bool = True) -> dict:
    """
    类型路由 → 目录 → 创建 / 增量更新。
    mode: auto（存在则更新）/ create（强制新建）/ update（仅更新已存在）。
    返回 {ok, path, action, report:[...]}。
    绝不覆盖用户已有内容：只填空、只新增缺失小节。
    """
    title = sanitize_title(title)
    type_, alias_note = resolve_type_alias(cfg, type_)
    if type_ == "时间线":
        title = ensure_timeline_title(title, ai_fields.get("年份") or ai_fields.get("时间") or "")
    dirpath, status = resolve_route_dir(cfg, type_)
    result = {"ok": False, "path": "", "action": "", "report": ([alias_note] if alias_note else [])}
    if dirpath is None:
        # 目录还没建：只要②页配的是"知识库下的相对路径"，就自动创建（"建立相应的目录"）
        kb = resolve_kb(cfg)
        want = str((cfg.get("routes") or {}).get(type_) or "").strip()
        if not want:
            t2, _alias = resolve_type_alias(cfg, type_)
            want = str((cfg.get("routes") or {}).get(t2) or "").strip()
        cand = None
        if want and kb is not None:
            cand = Path(want)
            if not cand.is_absolute():
                cand = kb / want
        if cand is not None:
            try:
                cand.mkdir(parents=True, exist_ok=True)
                dirpath, status = cand, f"已创建目录「{want}」"
            except Exception as exc:  # noqa: BLE001
                result["report"].append(f"目录创建失败（{cand}）：{type(exc).__name__}: {exc}")
                return result
        if dirpath is None:
            result["report"].append(f"路由失败：{status}")
            return result
    try:                                                 # 目录不存在就建
        dirpath.mkdir(parents=True, exist_ok=True)
    except Exception as exc:  # noqa: BLE001
        result["report"].append(f"目录创建失败（{dirpath}）：{type(exc).__name__}: {exc}")
        return result
    target = dirpath / f"{title}.md"
    report: list[str] = []
    note_text = None
    if target.exists() and mode != "create":
        # 增量更新：只填空值、只补缺失小节，绝不覆盖已有内容
        text = merge_into_existing(cfg, target, type_, title, ai_fields, ai_sections,
                                   report, images=images, auto_images=auto_images)
        dest = backup_note(target, resolve_kb(cfg))          # 改写前备份（每个文件只留最新一份）
        if dest is not None:
            try:
                rel = dest.relative_to(backup_root(create=False))
            except Exception:
                rel = Path(dest.name)
            report.append(f"旧版已备份：{BACKUP_DIR_NAME}/{rel}")
        target.write_text(text, encoding="utf-8")
        _sync_templates_on_write(cfg, report)
        result.update(ok=True, path=str(target), action="增量更新", report=report)
        return result
    if mode == "update":
        result["report"].append(f"未找到目标笔记，跳过更新：{title}.md")
        return result
    # 新建
    text, note = build_note_text(cfg, type_, title, summary, ai_fields, ai_sections, report,
                                 images=images, auto_images=auto_images)
    others = [p for p in find_note_paths(cfg, title) if p != target]
    for other in others:                                     # 同名笔记在别的目录：提醒一下
        report.append(f"⚠ 同名笔记已存在：{other.parent.name}/{other.name}"
                      f"（本次写入的是 {target.parent.name}/）")
    target.write_text(text, encoding="utf-8")
    _sync_templates_on_write(cfg, report)
    result.update(ok=True, path=str(target), action="新建", report=[f"新建笔记：{target.name}（模板：{note}）"] + report)
    return result


