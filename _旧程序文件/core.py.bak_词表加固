def section_clean_name(norm: str) -> str:
    """去掉小节 norm 开头的非中文前缀（数字序号、emoji），用于跨格式匹配。"""
    return re.sub(r"^[^\u4e00-\u9fff]+", "", norm)


def fuzzy_match_section(user_norm: str, template_norms: list[str]) -> str | None:
    """用户小节名 → 模板小节 norm（忽略序号/emoji 前缀；先精确匹配，再取最长的包含匹配）。"""
    return _best_section_match(user_norm, template_norms)


def parse_manual_input(text: str) -> OrderedDict:
    """
    解析手动输入内容为 {norm: (标题行, [内容行])}。
    支持 ## / ### 标题行作小节分隔；连续无标题行归入前一小节。
    """
    result = OrderedDict()
    cur_norm = cur_label = None
    cur_lines: list[str] = []
    for line in text.splitlines():
        s = line.strip()
        m = re.match(r"^(#{2,3})\s+(.+?)\s*$", s)
        if m:
            if cur_norm is not None:
                result[cur_norm] = [cur_label, cur_lines]
            label = m.group(0).strip()
            cur_label = label
            cur_norm = header_norm(label)
            cur_lines = []
        elif s:
            cur_lines.append(line)
    if cur_norm is not None:
        result[cur_norm] = [cur_label, cur_lines]
    return result


def sections_from_ai(content: dict) -> OrderedDict:
    """把 AI 的 content 对象（小节名 → 要点数组）转为 merge 用的小节结构。"""
    result = OrderedDict()
    for key, val in (content or {}).items():
        if not key:
            continue
        # AI 偶尔输出嵌套键（如 "## 三、事件经过\n### 起因"）：取最后一级作为有效小节名
        if "\n" in key or "\r" in key:
            key = key.strip().splitlines()[-1].strip()
            if not key:
                continue
        line = key if key.startswith("#") else ("### " + key if key.startswith(("起因", "发展", "结果", "出身",
                        "教育", "早期", "阶段", "决策", "背景", "影响", "评价", "来源", "存藏", "引用", "时间", "地点",
                        "涉及", "短期", "长期", "正面", "负面", "不同", "核心人物", "国内", "国际", "进攻方", "防御方"))
                        else "## " + key)
        norm = header_norm(line)
        if norm == header_norm("参考资料"):
            continue  # 参考资料由用户在 Obsidian 中填写，不写入 AI 内容
        items = val if isinstance(val, list) else [str(val)]
        cleaned = []
        for x in items:
            for raw in str(x).replace("\r\n", "\n").split("\n"):
                t = raw.strip()
                if not t:
                    continue
                # 争议说明这类嵌套引用必须保住缩进（§1-12），统一成两个空格
                cleaned.append("  " + t if t.startswith(">") else t)
        result[norm] = [line, cleaned]
    return result


# ---------------------------------------------------------------------------
# 备份：统一目录 `_备份/`（模板/笔记每个文件只留最新一份；整库快照保留最近 N 份）
#   _备份/模板/<模板名>.md                 ← 模板被覆盖前的旧版（只留最新）
#   _备份/笔记/<知识库相对路径>/<文件>.md    ← 笔记被改写前的旧版（只留最新）
#   _备份/快照/<时间戳>-<名称>/…            ← 整库级操作前的快照，只保留最近 BACKUP_KEEP_SNAPSHOTS 份
# ---------------------------------------------------------------------------
BACKUP_DIR_NAME = "_备份"
BACKUP_KEEP_SNAPSHOTS = 3


def backup_root(create: bool = True) -> Path:
    """统一备份根目录：默认 <程序目录>/_备份；可用环境变量 KB_BACKUP_DIR 改到别处。"""
    env = (os.environ.get("KB_BACKUP_DIR") or "").strip()
    root = Path(env) if env else (app_dir() / BACKUP_DIR_NAME)
    if create:
        root.mkdir(parents=True, exist_ok=True)
    return root


def backup_file(src: Path, kind: str = "笔记", rel: str | Path = "") -> Path | None:
    """把一个文件备份到 `_备份/<kind>/[rel]`；同名覆盖 → 每个文件只保留最新一份。

    用 copy2（保留 mtime），方便比较新旧与"整理备份"时判断该留哪一份。
    """
    src = Path(src)
    if not src.is_file():
        return None
    dest = backup_root() / kind / (Path(rel) if str(rel) else Path(src.name))
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
    except Exception:
        return None
    return dest


def backup_note(path: Path, kb_root: Path | None = None) -> Path | None:
    """笔记备份：保留相对知识库的目录结构（`_备份/笔记/02 人物图谱/蔡锷.md`）。"""
    path = Path(path)
    rel: Path | str = path.name
    if kb_root:
        try:
            rel = path.resolve().relative_to(Path(kb_root).resolve())
        except Exception:
            rel = path.name
    return backup_file(path, "笔记", rel)


def backup_template(path: Path) -> Path | None:
    """模板备份：`_备份/模板/<模板名>.md`。"""
    return backup_file(path, "模板", Path(path).name)


def backup_snapshot(name: str, when=None) -> Path:
    """新建批次快照目录 `_备份/快照/<时间戳>-<名称>/`，并把快照裁到最近 N 份。"""
    stamp = (when or datetime.now()).strftime("%Y%m%d-%H%M%S")
    d = backup_root() / "快照" / f"{stamp}-{name}"
    d.mkdir(parents=True, exist_ok=True)
    prune_snapshots()
    return d


def prune_snapshots(keep: int = BACKUP_KEEP_SNAPSHOTS) -> list:
    """只保留最近 keep 个快照目录，返回被删掉的目录名。"""
    snap_root = backup_root() / "快照"
    if not snap_root.is_dir():
        return []
    dirs = sorted([d for d in snap_root.iterdir() if d.is_dir()], key=lambda d: d.name)
    removed = []
    for d in (dirs[:-keep] if keep > 0 else dirs):
        try:
            shutil.rmtree(d)
            removed.append(d.name)
        except Exception:
            pass
    return removed


def backup_summary() -> dict:
    """当前备份占用（给脚本/界面显示）。"""
    root = backup_root()
    out: dict = {}
    for kind in ("模板", "笔记", "快照"):
        d = root / kind
        files = [p for p in d.rglob("*") if p.is_file()] if d.is_dir() else []
        out[kind] = {"files": len(files),
                     "mb": round(sum(p.stat().st_size for p in files) / 1048576, 2)}
    out["root"] = str(root)
    return out


def _sync_templates_on_write(cfg: dict, report: list) -> None:
    """写入笔记时顺带补全仓库缺失的模板；**仓库已有的一律不动**（仓库是源头）。

    仓库里的模板与程序内置版不同时不覆盖，只在报告里提示（可到④页把仓库版更新进程序）。
    """
    if not cfg.get("template_sync", True):
        return
    try:
        sync = sync_templates(cfg, overwrite=False, backup=False, only_mapped=True)
    except Exception as exc:                       # 同步失败绝不能影响笔记写入
        report.append(f"模板同步跳过：{type(exc).__name__}: {exc}")
        return
    if sync.get("created") or sync.get("diff"):
        report.extend(sync.get("report") or [])


def materialize_templates(td: str | Path, overwrite: bool = False) -> dict:
    """
    把内置的「格式规范」模板写入模板目录。默认已有同名文件跳过（不覆盖）；
    overwrite=True 时覆盖（覆盖前由 sync_templates 负责备份旧版）。
    返回 {created: [...], skipped: [...], updated: [...], path}。
    """
    from templates import BUILTIN_TEMPLATES, KB_TEMPLATES

    source = KB_TEMPLATES or BUILTIN_TEMPLATES
    td = Path(td)
    td.mkdir(parents=True, exist_ok=True)
    out = {"created": [], "skipped": [], "updated": [], "path": str(td)}
    for name, text in source.items():
        p = template_file_path(td, name)             # 支持 `古代/xxx` → 落到 古代社会模板/xxx.md
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
        except Exception:
            out["skipped"].append(p.name)
            continue
        if p.exists():
            if not overwrite:
                out["skipped"].append(p.name)
                continue
            if p.read_text(encoding="utf-8") == text:
                out["skipped"].append(p.name)
                continue
            p.write_text(text, encoding="utf-8")
            out["updated"].append(p.name)
            continue
        p.write_text(text, encoding="utf-8")
        out["created"].append(p.name)
    return out


def template_file_path(td, name: str) -> Path:
    """模板键 → 模板文件路径。

    * 普通键（`制度`）→ `<模板库>/制度.md`；
    * 带前缀键（`古代/制度`）→ `<模板库>/古代社会模板/制度.md`（多时期库的实际目录名）；
    * 如果模板库里已有同名文件（可能在子目录里），返回那个路径（避免重复建）。
    """
    td = Path(td)
    raw = str(name or "").strip()
    if raw.startswith("古代/"):
        stem = raw.split("/", 1)[1]                  # 古代键一律落/比 古代社会模板/ 里的同名文件，
        return td / TPL_ANCIENT_DIR_NAME / f"{stem}.md"   # 绝不回退到顶层的同名近现代模板
    return td / f"{raw}.md"


