def build_index(cfg: dict) -> dict:
    """
    重建索引：
      * 每个内容目录生成「索引.md」（列出该目录全部 .md 笔记，[[标题]] 双链）；
      * 总索引写入 cfg["index_file"]（默认 00 首页/索引.md，目录不存在则回退根目录/索引.md）。
    返回 {ok, master, dirs:[...], report:[...]}。
    """
    kb = resolve_kb(cfg)
    result = {"ok": False, "master": "", "dirs": [], "report": []}
    if kb is None:
        result["report"].append("知识库未设置")
        return result
    rows = scan_kb(kb)
    master_links = []
    for r in rows:
        if r["role"] == "特殊目录":
            continue
        d = Path(r["path"])
        mds = sorted(p for p in d.glob("*.md") if p.stem != "索引")
        if not mds:
            continue
        lines = [f"# 索引 · {d.name}", "", "> 由民国历史知识库自动生成（重建后覆盖）", ""]
        links = []
        for p in mds:
            lines.append(f"- [[{p.stem}]]")
            links.append(f"- [[{p.stem}]]")
        (d / "索引.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
        result["dirs"].append(d.name)
        master_links.append(f"### {d.name}")
        master_links.extend(links)
        master_links.append("")

    rel = (cfg.get("index_file") or INDEX_FILE_DEFAULT).strip()
    target = kb / rel
    if not target.parent.exists():
        target = kb / "索引.md"
    master = ["# 知识库总索引", "", "> 由民国历史知识库自动生成（重建后覆盖）", ""]
    master.extend(master_links or ["（暂无内容目录笔记）"])
    target.write_text("\n".join(master) + "\n", encoding="utf-8")
    result.update(ok=True, master=str(target))
    result["report"].append(f"总索引：{target}")
    for n in result["dirs"]:
        result["report"].append(f"目录索引：{n}/索引.md")
    if not result["dirs"]:
        result["report"].append("没有可索引的内容目录")
    return result


