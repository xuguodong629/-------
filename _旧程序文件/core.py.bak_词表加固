def _type_section_table(cfg: dict) -> str:
    """各类型 → 章节标题一览（给 AI 选类型后照抄小节名用，避免小节对不上）。"""
    lines = []
    for key in sorted((cfg.get("routes") or {}).keys()):
        try:
            heads = [label.strip("# ").strip()
                     for label, _b in parse_sections(template_skeleton(cfg, key)).values()]
        except Exception:
            continue
        if heads:
            lines.append("· " + key + "：" + " / ".join(heads))
    return "\n".join(lines)


def _section_shape_hints(body: str) -> list:
    """从模板骨架里提取「表格小节 / 表单小节」的结构，供 AI 按行名、字段名精确填写。

    例：
      · ⚖️ 兵力对比（表格：项目 | 进攻方 | 防御方；行：总兵力、指挥官、主要装备）
      · ⚔️ 元数据（字段：时间、地点、所属战争、结果）
    """
    out = []
    for label, lines in parse_sections(body).values():
        rows, fields = [], []
        for raw in lines:
            s = str(raw).strip()
            if not s:
                continue
            if s.startswith("|") and s.endswith("|"):
                if set(s) <= set("|-: "):
                    continue
                cells = [c.strip() for c in s.strip("|").split("|")]
                if any(cells):
                    rows.append(cells)
                continue
            m = re.match(r"^\s*[-*+]?\s*\*\*\s*([^*]+?)\s*\*\*\s*[:：]", s)
            if m:
                fields.append(m.group(1).strip())
        name = label.strip("# ").strip()
        if rows:
            header = rows[0]
            row_names = [r[0] for r in rows[1:] if r and r[0]]
            out.append(f"· {name}（表格：{' | '.join(header)}"
                       + (f"；行：{'、'.join(row_names)}" if row_names else "") + "）")
        elif fields:
            out.append(f"· {name}（字段：{'、'.join(fields)}）")
    return out


def _frontmatter_key_help(fields: dict, parsed: dict) -> list:
    """给 AI 的「可填 frontmatter 键」清单：键名 + 模板变量的取值约束（suggester 的可选值）。

    例：
        phase（历史分期）只能取：晚清（1881—1911）、北洋（1912—1927）、抗战（1937—1945）
        timeline（挂靠节点）
        date / locations / people …
    """
    keys = [k for k in (fields or {}).keys() if k not in PROTECTED_FIELDS]
    var_to_key = {str(k): str(v) for k, v in (parsed.get("field_keys") or {}).items()}   # 变量 → 键
    options = parsed.get("options") or {}
    labels = {p.get("var"): p.get("label") for p in (parsed.get("prompts") or [])}
    lines, seen = [], set()
    for var, key in var_to_key.items():                # 模板里拼装出来的键（含 suggester）
        if key in PROTECTED_FIELDS or key in seen:
            continue
        seen.add(key)
        label = labels.get(var) or ""
        head = key + (f"（{label}）" if label and label != key else "")
        opts = [str(o) for o in (options.get(var) or []) if str(o).strip()]
        lines.append(f"{head} 只能取以下之一（不确定可留空）：" + "、".join(opts) if opts else head)
    for k in keys:                                     # 其余键（骨架里已有的）
        if k in seen:
            continue
        seen.add(k)
        lines.append(str(k))
    return lines


def build_analysis_prompt(cfg: dict, topic: str, type_hint: str = "", hits: list | None = None,
                          exists: bool | None = None) -> str:
    """构造 AI 分析提示词：主题 + 检索命中 + 目标模板骨架 + 格式规范约束 → 只输出 JSON。

    exists=True 表示知识库里已有同名词条（这次是增量补空）；False 表示要新建一个词条。
    未指定类型时：给出**各类型的小节标题清单**，要求先定 type、再逐字照抄该类型的小节名，
    否则 AI 会按「通用」模板给小节，落到人物/事件等模板上就全对不上了。
    """
    tpl_text, _note = load_template_text(cfg, type_hint or "通用")
    parsed = parse_template(tpl_text)
    if parsed["templater"]:
        values = build_template_values(type_hint or "通用", "", "", {}, parsed["prompts"],
                                      parsed.get("field_keys"))
        fields, body, _ = render_template(tpl_text, values, [])
    else:
        fields, body = split_frontmatter(tpl_text)
        fields, body = (fields or {}), (body or tpl_text)
    fields = canonicalize_fields(fields)
    skeleton = "\n".join(label for label, _b in parse_sections(body).values())
    shape_hints = _section_shape_hints(body)
    fm_keys = _frontmatter_key_help(fields, parsed)
    known = [(h.get("title", ""), h.get("snippet", "")) for h in (hits or [])]
    types = sorted((cfg.get("routes") or {}).keys())
    prompt = (
        f"研究主题/关键词：{topic}\n"
        f"目标类型（若指定）：{type_hint or '由你判定'}\n"
        f"可选类型（从中选择）：{'、'.join(types)}\n\n"
        "【知识库格式规范（硬性要求）】\n"
        "1. frontmatter 只允许英文键名，值里禁止出现 [[ ]]；\n"
        "2. 正文只有一个 H1；你给的章节标题必须与骨架**逐字一致**（含 emoji）；\n"
        "3. **骨架里每个小节都要给内容**，尤其是事实型小节（时间 / 地点 / 交战双方 / 指挥官 / 兵力 /\n"
        "   经过 / 伤亡 / 影响 / 职务 / 关系等）。用你知识范围内公认的史实来写；数字有争议就给区间与\n"
        "   主要说法（例：「约4万—9万人，日方公布约4万余人」），**不要因为“可能有争议”就把整节留空**。\n"
        "4. 只有某一个具体条目确实不知道时才省略它（程序会写 <!-- TODO: 待补 -->），\n"
        "   绝不要编造人名、番号、日期、数字；也不要因为一个小节没把握就把它和其它小节一起留空。\n"
        "5. **凡是有争议的数字或结论，必须紧跟在那一行下面附一条“争议说明 + 来源简介”**\n"
        "   （所有类型都适用，写在被争议条目的正下方，行首缩进两个空格）：\n"
        "        > ⚖️ 争议说明：<各方说法差在哪、为什么有分歧>｜来源：<1~3 个具体出处，注明哪一方/哪本书/哪个机构>\n"
        "   例：\n"
        "        - 中国军队伤亡约25万—30万人\n"
