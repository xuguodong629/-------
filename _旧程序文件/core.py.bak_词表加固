def find_notes(cfg: dict, keyword: str, limit: int = 40) -> list[dict]:
    kb = resolve_kb(cfg)
    hits = []
    if kb is None or not keyword.strip():
        return hits
    kw = keyword.strip()
    image_index = build_image_index(cfg)          # 一次扫描，供所有命中复用
    for md in sorted(kb.rglob("*.md")):
        if md.stem.startswith("索引"):
            continue
        if any(k in md.parts for k in ("Templates", "模板", "Assets", "Attachments", "附件", "资产")):
            continue
        score = 0
        snippet = ""
        if kw in md.stem:
            score += 10
        head = ""
        try:
            head = md.read_text(encoding="utf-8")[:3000]
        except Exception:
            pass
        if kw in head:
            score += 4
            idx = head.find(kw)
            snippet = head[max(0, idx - 40):idx + 60].replace("\n", " ").strip()
        if score:
            hits.append({"path": str(md), "title": md.stem, "score": score, "snippet": snippet,
                         "images": match_images(image_index, md.stem)})
    hits.sort(key=lambda h: (-h["score"], h["title"]))
    return hits[:limit]


