    "官署与机构": "古代/官署与机构",
}
TPL_ANCIENT_DIR_NAME = "古代社会模板"                # 古代模板集在多时期共享模板库里的实际目录名


def render_templates_module(templates: dict, order: list | None = None) -> str:
    """按当前模板集生成 templates.py 源码（结构同 _sync_templates.py）。"""
    import templates as _cur
    type_map = {t: re.sub(r"\.md$", "", str(f)) for t, f in DEFAULT_TEMPLATE_ROUTES.items()}
    for type_, name in ANCIENT_TYPE_TEMPLATE_FILE.items():   # 古代史独有类型（模板在集里才登记）
        if type_ not in type_map and name in templates:
            type_map[type_] = name
    footers = dict(getattr(_cur, "DEFAULT_FOOTERS", {}) or {})
    order = list(order or [])
    names = ([n for n in order if n in templates]
             + [n for n in templates if n not in order])
    out = [_templates_module_header().rstrip("\n"), "",
           "# 全部规范模板原文（文件名 stem → 原文）", "KB_TEMPLATES = {"]
    for name in names:
        text = templates[name]
        if "'''" not in text and not text.endswith("\\"):
            lit = "r'''" + text + "'''"          # raw 三引号：保住模板里的 \n
        else:
            lit = json.dumps(text, ensure_ascii=False)
        out.append(f"    {name!r}: {lit},")
    out.append("}")
    out.append("")
    out.append("# 类型（config.routes 的键）→ 该类型的首选模板文件")
    out.append("TYPE_TEMPLATE_FILE = {")
    for type_, name in type_map.items():
        out.append(f"    {type_!r}: {name!r},")
    out.append("}")
    out.append("")
    out.append("# 类型 → 模板原文（生成笔记的兜底模板）")
    out.append("BUILTIN_TEMPLATES = {t: KB_TEMPLATES[f] for t, f in TYPE_TEMPLATE_FILE.items() if f in KB_TEMPLATES}")
    out.append("")
    out.append("# 格式规范 §1 第 11 条：模板自己没写页脚时按这张表补齐（模板名 → 关联行）")
    out.append("DEFAULT_FOOTERS = {")
    for name in names:
        if name in footers:
            out.append(f"    {name!r}: {footers[name]!r},")
    out.append("}")
    out.append("")
    out.append("# 类型 → 关联行")
    out.append("TYPE_FOOTER = {t: DEFAULT_FOOTERS[f] for t, f in TYPE_TEMPLATE_FILE.items() if f in DEFAULT_FOOTERS}")
    out.append("")
    out.append('# 模板目录默认名（知识库根下）')
    out.append('DEFAULT_TEMPLATES_DIR_NAME = "Templates（模板）"')
    out.append("")
    out.append("# 格式规范文件名（模板目录内，只读、不作为模板）")
    out.append('SPEC_FILE_NAME = "格式规范.md"')
    out.append("")
    return "\n".join(out)


def import_templates_from_vault(cfg: dict, out_path: Path | None = None) -> dict:
    """把仓库 `Templates（模板）/*.md` 更新进程序内置模板（templates.py）。

    * 仓库里有、程序里也有 → **用仓库版覆盖程序版**（仓库是源头）；
    * 仓库里没有、程序里有 → 保留程序版（当兜底，不会因为仓库少文件就丢失模板）；
    * 写完后立刻重载程序内的 templates 模块，本次运行即生效（打包版建议随后重新打包）。
    返回 {ok, path, templates, updated, kept, report}
    """
    import importlib
    out = {"ok": False, "path": "", "templates": [], "updated": [], "kept": [], "report": []}
    td = ensure_templates_dir(cfg, create=False)
    if td is None:
        out["report"].append("找不到模板目录（先设置知识库）")
        return out
    spec_name = "格式规范.md"
    try:
        import templates as _cur
        spec_name = getattr(_cur, "SPEC_FILE_NAME", spec_name)
        current = dict(getattr(_cur, "KB_TEMPLATES", {}) or {})
    except Exception:
        current = {}
    vault = {}
    for p in sorted(td.glob("*.md")):
        if p.name == spec_name:
            continue
        vault[p.stem] = p.read_text(encoding="utf-8")
    if not vault:
        out["report"].append(f"仓库模板目录里没有 .md：{td}")
        return out
    merged = {**current, **vault}                 # 仓库优先；仓库没有的保留程序版
    kept = [n for n in current if n not in vault]
    updated = [n for n in vault if current.get(n) != vault[n]]
    dest = Path(out_path) if out_path else (app_dir() / "templates.py")
    try:
        dest.write_text(render_templates_module(merged), encoding="utf-8")
    except Exception as exc:
        out["report"].append(f"写入 {dest.name} 失败：{type(exc).__name__}: {exc}")
        return out
    try:                                          # 让本次运行就用上新模板
        import templates as _t
        _t.KB_TEMPLATES = merged
        _t.BUILTIN_TEMPLATES = {t: merged[f] for t, f in _t.TYPE_TEMPLATE_FILE.items() if f in merged}
        _t.DEFAULT_FOOTERS = {k: v for k, v in (_t.DEFAULT_FOOTERS or {}).items()}
    except Exception:
        pass
    out.update({"ok": True, "path": str(dest), "templates": sorted(merged),
                "updated": sorted(updated), "kept": sorted(kept)})
    out["report"].append(f"已从仓库更新程序模板：读取 {len(vault)} 个、其中变化 {len(updated)} 个"
                         f"；仓库没有、保留程序版 {len(kept)} 个")
    return out


def sync_templates(cfg: dict, overwrite: bool = False, backup: bool = True,
                   only_mapped: bool = False) -> dict:
    """程序内置模板 → 仓库 `Templates（模板）/`。

    **默认 overwrite=False：仓库是源头，绝不悄悄覆盖你在 Obsidian 里的修改**——
    仓库缺的补上；仓库有但和程序版不同的只记进 diff（提示可「从仓库更新程序模板」）。
    overwrite=True（④页「用程序模板覆盖仓库」）才会覆盖，并先备份到 `_备份/模板/`。
    返回 {ok, path, created, updated, kept, diff, backup, report}
    """
    from templates import BUILTIN_TEMPLATES, KB_TEMPLATES

    source = KB_TEMPLATES or BUILTIN_TEMPLATES
    out = {"ok": False, "path": "", "created": [], "updated": [], "kept": [], "backup": [],
           "report": []}
    td = ensure_templates_dir(cfg, create=True)
    if td is None:
        out["report"].append("模板同步跳过：找不到模板目录（先设置知识库或模板目录）")
        return out

    to_create, to_update, same, diff = [], [], [], []
    mapped = {tpl_stem(f) for f in (cfg.get("template_routes") or {}).values()}
    for name, text in source.items():
        if only_mapped and name not in mapped:
            continue                               # 只补"在用"的模板，避免把仓库删掉的旧模板又塞回去
        p = template_file_path(td, name)           # 支持 `古代/xxx` → 古代社会模板/xxx.md
        if not p.is_file():
            to_create.append(name)
        elif p.read_text(encoding="utf-8") == text:
            same.append(name)
        else:
            diff.append(name)
            (to_update if overwrite else same).append(name)

    if backup and to_update:
        for name in to_update:                     # 只备份即将被覆盖的，别把没改动的也覆盖掉
            try:
                dest = backup_template(template_file_path(td, name))
                if dest is not None:
                    out["backup"].append(dest.name)
            except Exception:
                pass
    for name in to_create + to_update:
        p = template_file_path(td, name)
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
        except Exception:
            continue
        p.write_text(source[name], encoding="utf-8")

    out.update({"ok": True, "path": str(td), "created": to_create, "updated": to_update,
                "kept": same, "diff": diff})
    if to_create:
        out["report"].append(f"模板同步：仓库缺少 {len(to_create)} 个模板，已补上"
                             f"（{'、'.join(to_create[:5])}{'…' if len(to_create) > 5 else ''}）")
    if to_update:
        out["report"].append(f"模板同步：按程序版覆盖 {len(to_update)} 个（{'、'.join(to_update[:4])}…），"
                             f"旧版已备份到 {BACKUP_DIR_NAME}/模板/")
    if diff and not overwrite:
        out["report"].append(f"ℹ 仓库里有 {len(diff)} 个模板和程序内置版不同（{'、'.join(diff[:5])}"
                             f"{'…' if len(diff) > 5 else ''}）——以仓库为准、未改动；"
                             "要把仓库版更新进程序：④ 模板管理 →「从仓库更新程序模板」")
    if not to_create and not to_update and not diff:
        out["report"].append("模板同步：仓库模板已是最新")
    return out