IMAGE_UA = "MinguoKB/1.0 (local markdown note tool)"
WIKI_SUMMARY_API = "https://zh.wikipedia.org/api/rest_v1/page/summary/"
COMMONS_API = "https://commons.wikimedia.org/w/api.php"


def image_assets_dir(cfg: dict, create: bool = False) -> Path | None:
    """图片目录：知识库里的 Assets（图片地图）/（不存在时只有 create=True 才新建）。"""
    kb = resolve_kb(cfg)
    if kb is None:
        return None
    for name in ASSET_DIR_CANDIDATES:
        p = kb / name
        if p.is_dir():
            return p
    if not create:
        return None
    p = kb / ASSET_DIR_CANDIDATES[0]
    try:
        p.mkdir(parents=True, exist_ok=True)
        return p
    except Exception:
        return None


def build_image_index(cfg: dict) -> list:
    """扫描知识库里所有图片（跳过模板目录），供配图匹配复用。"""
    kb = resolve_kb(cfg)
    if kb is None:
        return []
    index = []
    for p in kb.rglob("*"):
        try:
            if not p.is_file() or p.suffix.lower() not in IMAGE_EXTS:
                continue
        except OSError:
            continue
        if any(part in ("Templates（模板）", "Templates", "模板") for part in p.parts):
            continue
        index.append({"file": p.name, "path": str(p), "stem": p.stem.strip()})
    return index


def match_images(index: list, title: str, aliases=(), min_score: int = 0) -> list:
    """按文件名给词条匹配图片：同名 100 分 > 前缀 70 > 包含 50（别名依次递减）。

    min_score=70 时只认「同名 / 前缀」，避免事件条目（`1881年-袁世凯投身淮军`）
    被人物肖像（`袁世凯.jpg`）的弱包含命中。
    """
    keys = [sanitize_title(title)] + [sanitize_title(a) for a in (aliases or ()) if str(a).strip()]
    keys = [k for k in keys if k]
    scored = []
    for item in index or []:
        stem = str(item.get("stem") or "").strip()
        if not stem:
            continue
        score = 0
        hit_key = ""
        for i, key in enumerate(keys):
            if stem == key:
                score, hit_key = max(score, 100 - i), key
            elif stem.startswith(key) or key.startswith(stem):
                if (70 - i) > score:
                    score, hit_key = 70 - i, key
            elif key in stem:
                if (50 - i) > score:
                    score, hit_key = 50 - i, key
        if score and score >= max(0, int(min_score)):     # score 为 0 = 没匹配上，必须排除
            scored.append(dict(item, score=score, key=hit_key, source="本地图库"))
    scored.sort(key=lambda x: (-x["score"], x["file"]))
    seen, uniq = set(), []
    for item in scored:
        if item["file"] in seen:
            continue
        seen.add(item["file"])
        uniq.append(item)
    return uniq[:6]


def find_local_images(cfg: dict, title: str, aliases=()) -> list:
    """在知识库里给词条找本地图片。"""
    return match_images(build_image_index(cfg), title, aliases)


def _http_json(url: str, timeout: int = 15, retries: int = 2) -> dict:
    """请求 JSON：遇到限流/网络抖动自动退避重试（维基对并发很敏感）。"""
    import time as _time
    last = None
    for attempt in range(max(0, retries) + 1):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": IMAGE_UA})
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except Exception as exc:                      # 429/5xx/超时都退避重试
            last = exc
            if attempt < retries:
                _time.sleep(1.5 * (attempt + 1))
    raise last if last else RuntimeError("请求失败")


def fetch_wiki_image(title: str, timeout: int = 15, width: int = 1000) -> dict | None:
    """中文维基条目首图 + Wikimedia Commons 的作者/许可。取不到返回 None，绝不抛异常。

    默认取 `width` 宽的缩略图（1000px 足够看，别把几 MB 的原图塞进知识库）。
    """
    name = sanitize_title(title)
    thumb_url = pageimage = page_url = ""
    try:
        api = ("https://zh.wikipedia.org/w/api.php?action=query&format=json&prop=pageimages"
               f"&piprop=thumbnail|name&pithumbsize={int(width)}&titles=" + urllib.parse.quote(name))
        pages = (_http_json(api, timeout).get("query") or {}).get("pages") or {}
        for _pid, page in pages.items():
            thumb_url = ((page.get("thumbnail") or {}).get("source") or "")
            pageimage = str(page.get("pageimage") or "")
            break
    except Exception:
        pass
    if not thumb_url:                                   # 兜底：REST 摘要接口
        try:
            summary = _http_json(WIKI_SUMMARY_API + urllib.parse.quote(name), timeout)
        except Exception:
            return None
        thumb_url = ((summary.get("thumbnail") or {}).get("source")
                     or (summary.get("originalimage") or {}).get("source") or "")
        page_url = ((summary.get("content_urls") or {}).get("desktop") or {}).get("page", "")
        if not pageimage:
            pageimage = urllib.parse.unquote(urllib.parse.urlparse(thumb_url).path.rsplit("/", 1)[-1])
    if not thumb_url:                                   # 兜底2：搜索条目（消歧义页没有首图，如「丘吉尔」）
        try:
            api = ("https://zh.wikipedia.org/w/api.php?action=query&format=json&generator=search"
                   f"&gsrsearch={urllib.parse.quote(name)}&gsrlimit=1&prop=pageimages"
                   f"&piprop=thumbnail|name&pithumbsize={int(width)}")
            pages = (_http_json(api, timeout).get("query") or {}).get("pages") or {}
            for _pid, page in pages.items():
                thumb_url = ((page.get("thumbnail") or {}).get("source") or "")
                pageimage = str(page.get("pageimage") or "")
                break
        except Exception:
            pass
    if not thumb_url:
        return None
    if thumb_url.startswith("//"):
        thumb_url = "https:" + thumb_url
    pageimage = re.sub(r"^\d+px-", "", pageimage).strip()     # 缩略图名去掉宽度前缀
    ext = Path(urllib.parse.urlparse(thumb_url).path).suffix.lower() or ".jpg"
    info = {"url": thumb_url, "file": pageimage, "ext": ext, "license": "", "artist": "",
            "page": page_url or ("https://zh.wikipedia.org/wiki/" + urllib.parse.quote(name))}
    try:
        api = (COMMONS_API + "?action=query&format=json&prop=imageinfo&iiprop=url|extmetadata&titles="
               + urllib.parse.quote("File:" + pageimage))
        pages = (_http_json(api, timeout).get("query") or {}).get("pages") or {}
        for _pid, detail in pages.items():
            meta = ((detail.get("imageinfo") or [{}])[0].get("extmetadata") or {})
            pick = lambda k: str((meta.get(k) or {}).get("value", ""))
            info["license"] = html.unescape(re.sub(r"<[^>]+>", "", pick("LicenseShortName"))).strip()
            artist = urllib.parse.unquote(urllib.parse.unquote(pick("Artist")))
            artist = html.unescape(re.sub(r"<[^>]+>", " ", artist))
            artist = re.sub(r"\[\d+\]", "", artist)        # 去掉维基脚注标记 [1]
            info["artist"] = re.sub(r"\s{2,}", " ", artist).strip()
            break
    except Exception:
        pass
    return info


def download_image(url: str, dest: Path, timeout: int = 40) -> bool:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": IMAGE_UA})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = resp.read()
        if not data:
            return False
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        return True
    except Exception:
        return False


def _wiki_query_candidates(title: str, aliases=()) -> list:
    """维基检索词候选：原题名 → 去掉年份/序号前缀 → 别名。

    例：`1911年-辛亥革命` → `辛亥革命`；`03 北洋系` → `北洋系`。
    """
    out = []
    for raw in [title] + list(aliases or ()):
        name = sanitize_title(str(raw))
        if not name:
            continue
        if name not in out:
            out.append(name)
        stripped = re.sub(r"^\d{1,4}\s*年?\s*[-—–－]\s*", "", name).strip()
        if stripped and stripped not in out:
            out.append(stripped)
    return out


def acquire_image(cfg: dict, title: str, aliases=(), allow_network: bool = True) -> dict:
    """给词条找配图：本地图库优先；没有再（allow_network）从维基百科下载进 Assets（图片地图）。

    返回 {ok, file, path, source, credit, note}；失败只给 note，不抛异常。
    """
    # 本地匹配只要「同名 / 前缀」（≥70 分）：弱包含（袁世凯.jpg ↔ 1882年-壬午兵变）
    # 会让事件条目抢用人物肖像，这里宁可交给联网按标题取名的新图
    local = find_local_images(cfg, title, aliases)
    local = [x for x in local if x.get("score", 0) >= 70]
    if local:
        entry = dict(local[0])
        matched = str(entry.get("key") or "")
        if matched and matched != sanitize_title(title):
            # 命中的是词条里链接的实体（如 1928年-东北易帜 → 张学良.jpg）：署名里写明
            entry["credit"] = f"本地图库（词条内链接：{matched}）"
        entry.update(ok=True, source="本地图库", note=f"本地图库已有：{entry['file']}")
        return entry
    if not allow_network:
        return {"ok": False, "note": "本地图库没有匹配图片（联网取图已关闭）"}
    info = None
    used = ""
    for candidate in _wiki_query_candidates(title, aliases):
        info = fetch_wiki_image(candidate)
        if info:
            used = candidate
            break
    if not info:
        return {"ok": False, "note": f"维基百科没有查到「{title}」的图片（可手动把图片放进 Assets（图片地图））"}
    target_dir = image_assets_dir(cfg, create=True)
    if target_dir is None:
        return {"ok": False, "note": "知识库未设置或无法创建图片目录"}
    ext = str(info.get("ext") or Path(info["file"]).suffix.lower() or ".jpg")
    dest = target_dir / f"{sanitize_title(title)}{ext}"
    if not dest.exists() and not download_image(info["url"], dest):
        return {"ok": False, "note": f"图片下载失败：{info['url'][:70]}"}
    credit = " · ".join(part for part in (
        f"中文维基百科 / Wikimedia Commons（条目：{used}）" if used else "中文维基百科 / Wikimedia Commons",
        f"作者：{info['artist']}" if info.get("artist") else "",
        f"许可：{info['license']}" if info.get("license") else "",
    ) if part)
    return {"ok": True, "file": dest.name, "path": str(dest), "source": "维基百科",
            "credit": credit, "page": info.get("page", ""),
            "author": info.get("artist", ""), "license": info.get("license", ""),
            "note": f"已下载：{dest.name}（{credit}）"}


def image_block(entry: dict) -> list:
    """一张图的正文两行：`![[文件名]]` + `> 图片来源：…`。"""
    file = str(entry.get("file") or "").strip()
    if not file:
        return []
    lines = [f"![[{file}]]"]
    credit = str(entry.get("credit") or "").strip()
    source = str(entry.get("source") or "").strip()
    if credit:
        lines.append(f"> 图片来源：{credit}")
    elif source:
        lines.append(f"> 图片来源：{source}")
    return lines


def _split_raw(text: str) -> tuple:
    """拆成 (frontmatter 原文, 正文)——保留原文格式，绝不重新序列化 frontmatter。"""
    lines = text.replace("\r\n", "\n").split("\n")
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                return "\n".join(lines[:i + 1]), "\n".join(lines[i + 1:])
    return "", text


def insert_images(text: str, entries: list) -> str:
    """配图写进笔记：首图紧跟 H1，第二张起放 `## 🖼️ 相关图片`（页脚之前）。重复调用不会重复插图。"""
    entries = [e for e in (entries or []) if str(e.get("file") or "").strip()]
    if not entries:
        return text
    head, body = _split_raw(text)
    missing = [e for e in entries if f"![[{e['file']}]]" not in body]
    if not missing:
        return text
    lines = body.split("\n")
    h1 = next((i for i, ln in enumerate(lines) if re.match(r"^#\s+\S", ln)), None)
    block = image_block(missing[0])
    if block:
        at = (h1 + 1) if h1 is not None else 0
        while at < len(lines) and not lines[at].strip():
            at += 1
        lines[at:at] = block + [""]
        missing = missing[1:]
    if missing:
        block = [f"## {IMAGE_SECTION_TITLE}", ""]
        for entry in missing:
            block.extend(image_block(entry))
            block.append("")
        while block and not block[-1].strip():
            block.pop()
        # 定位页脚分隔线（---），新小节插在它前面；空行按 §1-5 补一个
        sep = None
        for i in range(len(lines) - 1, -1, -1):
            if lines[i].strip().startswith(("**关联**", "**关联模块**")):
                j = i - 1
                while j >= 0 and not lines[j].strip():
                    j -= 1
                if j >= 0 and lines[j].strip() == "---":
                    sep = j
                break
        at = sep if sep is not None else len(lines)
        while at > 0 and not lines[at - 1].strip():
            at -= 1
        if sep is not None and sep > at:
            del lines[at:sep]                       # 收掉原有空行，下面统一补
        lines[at:at] = [""] + block + [""]
    new_body = "\n".join(lines)
    if head:
        return head + "\n" + new_body
    return new_body


def _image_entries(cfg: dict, title: str, fields: dict, images, auto_images: bool) -> list:
    if images is not None:
        return list(images)
    if not auto_images:
        return []
    aliases = fields.get("aliases") if isinstance(fields, dict) else None
    return find_local_images(cfg, title, aliases or [])


# ---------------------------------------------------------------------------
# 粘贴导入：整段内容丢进来 → 首行认类型/标题 → 套模板 → 本地化图片 → 自动分发写入
#   不限文字（长文/表格/代码块原样保留），图片支持 ![](url)、<img src>、![[文件]]。
# ---------------------------------------------------------------------------

MD_IMG_RE = re.compile(r"!\[([^\]]*)\]\(\s*([^)\s]+)(?:\s+\"[^\"]*\")?\s*\)")
HTML_IMG_RE = re.compile(r"<img[^>]*?src=[\"']([^\"']+)[\"'][^>]*>", re.I)
IMG_EXT_FALLBACK = ".png"


def _looks_like_caption(text: str) -> bool:
    t = (text or "").strip()
    if not t:
        return False
    if re.fullmatch(r"[\w\-.]+\.(?:png|jpe?g|gif|webp|svg|bmp)", t, re.I):
        return False
    return True


def _localize_image(cfg: dict, assets: Path, src: str, title: str, index: int) -> str:
    """把一张图落到 Assets（图片地图）/，返回文件名；失败返回空串。"""
    src = (src or "").strip().strip("<>")
    if not src:
        return ""
    if src.startswith(("http://", "https://")):
        path_part = urllib.parse.urlparse(src).path
        ext = Path(path_part).suffix.lower()
        if ext not in IMAGE_EXTS:
            ext = IMG_EXT_FALLBACK
        # 复用已下载的同名图
        stem_base = sanitize_title(Path(urllib.parse.unquote(path_part)).stem)[:40] or "图片"
        name = f"{stem_base}{ext}"
        dest = assets / name
        if dest.exists():
            return dest.name
        if download_image(src, dest):
            return dest.name
        fallback = f"{sanitize_title(title)}-{index}{ext}"
        if download_image(src, assets / fallback):
            return fallback
        return ""
    # 本地文件：拷进图库（已经在图库里的直接用）
    p = Path(src)
    if p.is_file():
        try:
            if assets.resolve() in p.resolve().parents:
                return p.name
        except Exception:
            pass
        ext = p.suffix.lower() if p.suffix.lower() in IMAGE_EXTS else IMG_EXT_FALLBACK
        name = p.name
        if (assets / name).exists():
            name = f"{sanitize_title(title)}-{index}{ext}"
        try:
            shutil.copy2(p, assets / name)
            return name
        except Exception:
            return ""
    return ""


def import_markdown_images(cfg: dict, text: str, title: str) -> tuple:
    """把正文里的网络/本地图片存进 Assets（图片地图），并改写成 Obsidian 的 ![[文件名]]。

    返回 (新文本, 报告行列表)。失败的图片保持原样，只记一行说明。
    """
    assets = image_assets_dir(cfg, create=True)
    if assets is None:
        return text, []
    report: list = []
    counter = {"n": 0}

    def repl(match):
        counter["n"] += 1
        alt, src = match.group(1), match.group(2)
        name = _localize_image(cfg, assets, src, title, counter["n"])
        if not name:
            report.append(f"图片未能本地化，保持原样：{src[:70]}")
            return match.group(0)
        report.append(f"图片已入库：{name}")
        lines = [f"![[{name}]]"]
        if _looks_like_caption(alt):
            lines.append(f"> 图片：{alt.strip()}")
        return "\n".join(lines)

    new_text = MD_IMG_RE.sub(repl, text)
    new_text = HTML_IMG_RE.sub(lambda m: repl(_FakeMatch(m.group(1))), new_text)
    return new_text, report


class _FakeMatch:
    """让 <img src> 与 ![alt](src) 共用同一段处理逻辑。"""

    def __init__(self, src: str):
        self._src = src

    def group(self, i: int = 0) -> str:
        if i == 0:
            return f"![]({self._src})"
        return "" if i == 1 else self._src


def guess_title_from_text(cfg: dict, text: str) -> str:
    """从粘贴内容里取标题：frontmatter title → 首行（去掉 #、类型前缀、括号类型）。"""
    fields, body = split_frontmatter(text)
    if isinstance(fields, dict) and str(fields.get("title") or "").strip():
        return sanitize_title(str(fields["title"]))
    routes = list((cfg.get("routes") or {}).keys())
    type_alt = "|".join(re.escape(t) for t in sorted(routes, key=len, reverse=True)) or "类型"
    for line in (body or text).splitlines():
        s = line.strip()
        if not s or s.startswith("---"):
            continue
        s = re.sub(r"^#{1,6}\s*", "", s)
        s = re.sub(r"^\*\*(.+?)\*\*\s*$", r"\1", s)
        s = re.sub(rf"^[\[【(（]\s*(?:{type_alt})\s*[\]】)）]\s*", "", s)   # 「[事件] 七七事变」
        m = re.match(rf"^(?:{type_alt})\s*[：:]\s*(.+)$", s)
        if m:
            s = m.group(1)
        s = re.sub(rf"[（(]\s*(?:{type_alt})\s*[)）]\s*$", "", s)
        s = s.strip(" 　*#·-")
        if s:
            if len(s) > 40:                       # 首行是长句时截到第一个停顿，便于做文件名
                parts = re.split(r"[。；;，,！!？?]", s, maxsplit=1)
                s = parts[0].strip() or s[:40]
            return sanitize_title(s)
    return ""


def guess_type_from_text(cfg: dict, text: str, first_line: str = "") -> tuple:
    """猜词条类型：① 首行/前几行的类型标记 → ② 各类型模板的小节命中数。返回 (类型, 依据)。"""
    routes = list((cfg.get("routes") or {}).keys())
    if not routes:
        return "通用", "②页没有配置类型映射"
    head = (first_line or "").strip()
    if not head:
        head = next((ln.strip() for ln in (text or "").splitlines() if ln.strip()), "")
    head_clean = re.sub(r"^#{1,6}\s*", "", head)
    for key in sorted(routes, key=len, reverse=True):
        k = re.escape(key)
        if (re.match(rf"^(?:{k})\s*[：:]", head_clean)
                or re.search(rf"[\[\(（【]\s*{k}\s*[\]\)）】]", head_clean)
                or re.search(rf"[（(]\s*{k}\s*[)）]\s*$", head_clean)
                or re.search(rf"^(?:{k})\s*[-—·|]", head_clean)):
            return key, f"首行标明了「{key}」"
    flat = re.sub(r"\s+", "", text or "")
    scores = {}
    for key in routes:
        try:
            skeleton = template_skeleton(cfg, key)
        except Exception:
            continue
        heads = [label for label, _b in parse_sections(skeleton).values()]
        hit = 0
        for h in heads:
            clean = section_clean_name(header_norm(h))
            if len(clean) >= 2 and clean in flat:
                hit += 1
        if heads and hit:
            scores[key] = hit
    if scores:
        best = max(scores, key=lambda k: (scores[k], len(k)))
        if scores[best] >= 2:
            return best, f"正文命中「{best}」模板小节 {scores[best]} 处"
    # 兜底必须是②页真的有映射的类型，否则写不进去（「通用」只是模板名，不是目录映射键）
    if "专题" in routes:
        return "专题", "没看出类型（先按「专题」归档，可在界面上改）"
    if "通用" in routes:
        return "通用", "没看出类型（先按「通用」归档，可在界面上改）"
    return routes[0], f"没看出类型（先按「{routes[0]}」归档，可在界面上改）"


def _strip_title_line(text: str, title: str) -> str:
    """去掉正文里那一行标题（首行且与识别出的标题一致），其余原样保留。"""
    lines = text.split("\n")
    out, dropped = [], False
    for ln in lines:
        s = ln.strip()
        if not dropped and s and not s.startswith("---"):
            candidate = re.sub(r"^#{1,6}\s*", "", s).strip(" 　*#")
            candidate = re.sub(r"^[\[【(（][^\]】)）]{1,10}[\]】)）]\s*", "", candidate).strip()
            if title and (candidate.startswith(title) or title.startswith(candidate)):
                dropped = True
                continue
        out.append(ln)
    return "\n".join(out)


def import_entry_from_text(cfg: dict, text: str, type_override: str = "",
                           title_override: str = "", download_images: bool = True,
                           mode: str = "auto", dry_run: bool = False,
                           images: list | None = None) -> dict:
    """整段粘贴 → 词条：认类型/标题 → 套模板 → 解析小节 → 图片入库 → 写入对应目录。

    * 不限长度：`## / ###` 分段原样保留；模板里没有的小节会作为新小节追加；
    * 图片：`![](url)`、`<img src>`、本地路径都会存进 Assets（图片地图），改成 `![[文件名]]`；
    * 类型/标题都可以在界面上覆盖（覆盖后按覆盖的走）；
    * dry_run=True 只生成预览文本（供界面「识别并预览」用），不写盘。
    返回 write_note 的结果 + {type, title, why, report}（dry_run 时多给 text/note）。
    """
    raw = (text or "").strip()
    if not raw:
        return {"ok": False, "report": ["内容是空的"], "type": "", "title": "", "why": "", "images": []}
    report: list = []
    fields_raw, _body = split_frontmatter(raw)
    fields = canonicalize_fields(fields_raw or {}, report)

    first_line = next((ln.strip() for ln in raw.splitlines() if ln.strip()), "")
    why = ""
    if type_override.strip():
        type_, why = type_override.strip(), "界面上指定了类型"
    elif str(fields.get("type") or "").strip():
        type_, why = str(fields["type"]).strip(), "内容 frontmatter 里写了 type"
    else:
        type_, why = guess_type_from_text(cfg, raw, first_line)
    type_, alias_note = resolve_type_alias(cfg, type_)
    if alias_note:
        report.append(alias_note)

    title = sanitize_title(title_override) if title_override.strip() else guess_title_from_text(cfg, raw)
    if not title:
        title = sanitize_title(first_line) or "未命名"
        report.append("没识别出标题，用首行兜底")

    body = _strip_title_line(raw, title)
    # frontmatter 已在 fields 里，正文里那段 --- 噪声去掉
    if body.lstrip().startswith("---"):
        _f, body = split_frontmatter(body)
        body = body or ""

    image_entries: list = [e for e in (images or []) if isinstance(e, dict)]
    image_names: list = [str(e.get("file")) for e in image_entries if str(e.get("file") or "").strip()]
    if download_images and dry_run:
        report.append("预览不下载正文图片（点「写入知识库」时才存进 Assets（图片地图））")
    elif download_images:
        body, img_report = import_markdown_images(cfg, body, title)
        report += img_report
        for line in img_report:
            if not line.startswith("图片已入库："):
                continue
            name = line.split("：", 1)[-1].strip()
            if name and name not in image_names:
                image_names.append(name)
                image_entries.append({"file": name, "source": "正文图片"})

    sections = parse_manual_input(body)
    if not sections:                                  # 没有 ## 分段：整段塞进模板首个空小节
        tpl_sections = parse_sections(template_skeleton(cfg, type_))
        target = next((k for k, v in tpl_sections.items() if is_fillable(v[1])), None)
        content_lines = [ln for ln in body.splitlines() if ln.strip()]
        if target and content_lines:
            sections = OrderedDict({target: [tpl_sections[target][0], content_lines]})
            report.append(f"内容没有小节标题，整段写入「{tpl_sections[target][0].strip('# ')}」")
        elif content_lines:
            report.append("内容是空的（只有标题）")

    summary = str(fields.get("summary") or "").strip() if isinstance(fields, dict) else ""
    fields = {k: v for k, v in (fields or {}).items() if k not in ("summary",)}
    if dry_run:
        existing = find_existing_note(cfg, title, type_)
        target = Path(existing["path"]) if existing.get("path") else None
        dirpath, _status = resolve_route_dir(cfg, type_)
        if dirpath is not None:                       # 目标目录里已有同名笔记 → 这次是"补充整合"
            cand = dirpath / f"{sanitize_title(title)}.md"
            if cand.is_file():
                target = cand
        if target is not None and target.is_file() and mode != "create":
            text_out = merge_into_existing(cfg, target, type_, title, fields, sections, report,
                                           images=image_entries)
            return {"ok": True, "path": str(target), "action": "增量预览", "type": type_,
                    "title": title, "why": why, "text": text_out,
                    "note": f"补充整合 → {target.parent.name}/{target.name}",
                    "report": report, "images": image_names, "existing": existing,
                    "summary": summarize_merge(report)}
        if mode == "update":
            return {"ok": False, "path": "", "action": "跳过", "type": type_, "title": title,
                    "why": why, "text": "", "note": "", "report": ["按「只补充已有」模式，"
                    f"但知识库里没有「{title}」这篇词条 → 不会新建"], "images": image_names,
                    "existing": existing, "summary": "没有可补充的条目"}
        text_out, note = build_note_text(cfg, type_, title, summary, fields, sections, report,
                                         images=image_entries)
        return {"ok": True, "path": "", "action": "新建预览", "type": type_, "title": title,
                "why": why, "text": text_out, "note": note, "report": report,
                "images": image_names, "existing": existing,
                "summary": "知识库中没有同名条目 → 将新建"}
    result = write_note(cfg, type_, title, summary, fields, sections, mode=mode,
                        images=image_entries)
    result.update({"type": type_, "title": title, "why": why, "images": image_names})
    result["report"] = report + list(result.get("report") or [])
    return result


# ---------------------------------------------------------------------------
# 双链：补齐链接 + 反向链接
# ---------------------------------------------------------------------------

LINK_RE = re.compile(r"\[\[([^\]|]+)(?:\|[^\]]+)?\]\]")


def extract_links(text: str) -> list[str]:
    return [m.group(1).strip() for m in LINK_RE.finditer(text)]


def linkify(text: str, known: list[str]) -> str:
    """把裸人名/实体名包成 [[名]]（仅当确认为已知笔记名，避免误伤正文）。"""
    names = sorted([n for n in known if len(n) >= 2], key=len, reverse=True)
    if not names:
        return text
    pattern = re.compile("(" + "|".join(re.escape(n) for n in names) + ")")
    def repl(m):
        n = m.group(1)
        # 已处于 [[]] 内则不重复包裹
        start = m.start()
        prefix = text[max(0, start - 2):start]
        if prefix == "[[":
            return n
        return f"[[{n}]]"
    return pattern.sub(repl, text)


def apply_backlinks(cfg: dict, new_title: str, related: list[str], report: list[str]) -> dict:
    """
    双链补齐：让已有相关笔记反向挂上 [[新笔记]]。
    返回 {ok, added:[...], skipped:[...]}。
    """
    kb = resolve_kb(cfg)
    out = {"ok": False, "added": [], "skipped": []}
    if kb is None:
        report.append("反向链接跳过：知识库未设置")
        return out
    out["ok"] = True
    related_clean = [re.sub(r"^\[\[|\]\]$", "", x).strip() for x in related]
    link_targets = sorted({x for x in related_clean if x}, key=len, reverse=True)
    new_bare = re.sub(r"^\[\[|\]\]$", "", new_title).strip()
    for md in kb.rglob("*.md"):
        if any(k in md.parts for k in ("Templates", "模板", "Assets", "Attachments", "附件", "资产")):
            continue
        if md.stem == new_bare or md.stem == new_title:
            continue
        if md.stem not in link_targets:
            continue
        text = md.read_text(encoding="utf-8")
        if f"[[{new_bare}]]" in text or new_bare in extract_links(text):
            out["skipped"].append(f"{md.stem}：已存在链接")
            continue
        # 找合适的挂载小节
        lines = text.splitlines()
        anchor = _find_backlink_anchor(lines)
        if anchor is None:
            block = f"## 关联条目\n\n- [[{new_bare}]]\n"
            head, footer = _split_footer(text)          # 页脚必须留在文件最后（格式规范 §1-11）
            text = head.rstrip("\n") + "\n\n" + block + (("\n" + footer + "\n") if footer else "")
            out["added"].append(f"{md.stem}：末尾新增「关联条目」")
        else:
            idx = anchor + 1
            n = idx
            while n < len(lines) and (not lines[n].strip() or lines[n].strip() in ("-", "[[]]")):
                n += 1
            lines.insert(n, f"- [[{new_bare}]]")
            text = "\n".join(lines)
            out["added"].append(f"{md.stem}：小节「{lines[anchor].strip('# ')}」挂链")
        md.write_text(text, encoding="utf-8")
    return out


def _split_footer(text: str) -> tuple[str, str]:
    """把结尾的 `---` + **关联**：… 页脚与正文分开（页脚固定留在文件最后）。"""
    lines = text.rstrip("\n").splitlines()
    for i in range(len(lines) - 1, -1, -1):
        if lines[i].strip().startswith(("**关联**", "**关联模块**")):
            j = i - 1
            while j >= 0 and not lines[j].strip():
                j -= 1
            if j >= 0 and lines[j].strip() == "---":
                return "\n".join(lines[:j]), "\n".join(lines[j:])
            return "\n".join(lines[:i]), "\n".join(lines[i:])
    return text.rstrip("\n"), ""


def _find_backlink_anchor(lines: list[str]) -> int | None:
    """找最适合挂反向链接的小节（## 层）。优先关键词命中（含 emoji 模板的章节名）。"""
    keywords = ("关联人物", "核心人物", "相关人物", "关联事件", "相关事件", "核心事件",
                "关联组织", "相关组织", "参与的重要", "关键历史事件", "关联时间线",
                "相关战役", "相关条目", "关系网络", "关键事件参与", "相关院校",
                "相关组织 / 制度", "相关组织/制度", "关联")
    level2 = [(i, ln) for i, ln in enumerate(lines) if re.match(r"^## ", ln)]
    for i, ln in level2:
        key = re.sub(r"^## ", "", ln)
        for kw in keywords:
            if kw in key:
                return i
    # 退而求其次：有 [[]] 空占位的章节
    for i, ln in level2:
        following = lines[i + 1:i + 6]
        if any(s.strip() == "[[]]" for s in following):
            return i
    return None


