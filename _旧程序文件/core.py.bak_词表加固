def guess_note_type(name: str, fallback: str = SKELETON_DEFAULT_TYPE) -> str:
    """按名字猜词条类型（保守规则；`1931年-…` 一律算时间线）。猜不出返回 fallback。"""
    s = str(name or "").strip()
    if re.match(r"^\d{3,4}\s*年", s):
        return "时间线"
    for t, kws in SKELETON_TYPE_HINTS:
        if any(s.endswith(k) for k in kws):
            return t
    return fallback


def parse_keyword_lines(text, default_type: str = "", default_dir: str = "") -> list:
    """把"每行一个关键词"的清单解析成 [{name, type, dir}]。

    支持：`名称`、`类型:名称`（类型须是知识库类型映射里的）、行首 `-`/`*`；`#` 注释行忽略。
    """
    if isinstance(text, (list, tuple, set)):
        lines = [str(x) for x in text]
    else:
        lines = str(text or "").splitlines()
    known = {t for t, _ in SKELETON_TYPE_HINTS}
    try:
        known |= set((load_config().get("routes") or {}).keys())
    except Exception:
        pass
    out: list = []
    for raw in lines:
        line = str(raw).strip()
        if not line or line.startswith("#"):
            continue
        line = line.lstrip("-*+ \t").strip()
        if not line:
            continue
        typ, name = "", line
        m = re.match(r"^([\u4e00-\u9fa5A-Za-z]{1,8})\s*[:：]\s*(.+)$", line)
        if m and m.group(1) in known:
            typ, name = m.group(1), m.group(2).strip()
        if name.strip():
            out.append({"name": name.strip(), "type": typ or default_type, "dir": default_dir})
    return out


