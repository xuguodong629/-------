def app_dir() -> Path:
    """程序所在目录（配置文件 / 备份 / 日志都放这里）。

    * 源码运行：core.py 所在的项目目录；
    * 打包成 exe（PyInstaller onefile 等）：exe 所在目录。
      这里不能用 __file__：onefile 模式下它指向临时解包目录 _MEIPASS，
      config.json 会被写进临时目录，程序一退出就丢。
    """
    if getattr(sys, "frozen", False):
        return Path(sys.executable).resolve().parent
    return Path(__file__).resolve().parent


BASE_DIR = app_dir()
CONFIG_FILE = BASE_DIR / "config.json"


def resource_path(name: str) -> Path:
    """随程序分发的只读资源（如 app.ico）的路径。

    打包成 onefile 后，资源被解到临时目录 sys._MEIPASS，必须从这里取。
    """
    base = getattr(sys, "_MEIPASS", None)
    return (Path(base) if base else Path(__file__).resolve().parent) / name

