def looks_like_entity(name: str, max_len: int = 16) -> bool:
    """像不像一个"能单独建条"的专名（而不是一句话或一段描述）。"""
    s = str(name or "").strip().strip("《》\"'“”")
    if not (2 <= len(s) <= max_len):
        return False
    if any(c in s for c in ENTITY_BAD_CHARS):
        return False
    if s.startswith(ENTITY_BAD_PREFIX) or s.endswith(ENTITY_BAD_SUFFIX):
        return False
    return not re.search(r"[。！？；;]", s)


def collect_missing_terms(cfg: dict, include_backups: bool = True, limit: int = 0) -> list:
    """汇总"库内还没有对应笔记"的链接名（**包括备份里的红链**），按出现次数排序。

    用途：清理红链后仍能保留/恢复《待建词条》清单（= 该建哪些词条）。
    """
    kb = resolve_kb(cfg)
    if kb is None:
        return []
    names = {p.stem for p in kb.rglob("*.md") if not _is_skipped_path(p)}
    sources = [p for p in kb.rglob("*.md") if not _is_skipped_path(p)]
    bk = backup_root(create=False) / "笔记"
    if include_backups and bk.is_dir():
        sources += list(bk.rglob("*.md"))
    count: dict = {}
    for p in sources:
        try:
            text = p.read_text(encoding="utf-8")
        except Exception:
            continue
        for m in re.finditer(r"(?<!!)\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", text):
            t = m.group(1).strip()
            if (not t or t in names or _looks_like_file(t)
                    or re.match(r"^\d{2}\s*\S", t)):
                continue
            count[t] = count.get(t, 0) + 1
    out = sorted(count, key=lambda x: (-count[x], -len(x)))
    return out[:limit] if limit else out


MD_HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$")
MD_TITLE_STRIP_RE = re.compile(r"^\s*(?:\d+[.、)）]\s*|[一二三四五六七八九十]+[、.)）]\s*|[-*+]\s+)")


def clean_entry_title(raw: str) -> str:
    """把标题行整理成词条名：去掉编号、外层 `[[ ]]`、`**`、书名号外的空白。"""
    s = str(raw or "").strip()
    s = re.sub(r"^\[\[([^\]|]+)(?:\|[^\]]+)?\]\]$", r"\1", s)
    s = s.replace("**", "").strip()
    s = MD_TITLE_STRIP_RE.sub("", s).strip()
    return s.strip(" \t:：-—")


def split_markdown_entries(text: str, level: int = 0) -> list:
    """把一份 md 文档拆成多个词条（按标题切分）。

    * `level=0`：自动挑"出现次数 ≥2 且层级最浅"的标题级别；`level=1` = `#`，2 = `##` …
    * 文档开头的 frontmatter 当作整篇文档的元数据，不算词条；
    * 代码块（``` 围栏）里的 `#` 不当标题；
    * 每个词条返回 {title, body, meta(条目内自带的 frontmatter/类型行), line, level}。
    """
    text = str(text or "")
    doc_fields, body = split_frontmatter(text)
    lines = (body or "").splitlines()
    heads = []                                            # [(行号, 级别, 标题)]
    in_fence = False
    for i, line in enumerate(lines):
        if line.strip().startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = MD_HEADING_RE.match(line)
        if m:
            heads.append((i, len(m.group(1)), clean_entry_title(m.group(2))))
    use = int(level or 0)
    if not heads:
        return []
    if use <= 0:                                          # 自动：重复出现的最浅级别
        counts: dict = {}
        for _i, lv, _t in heads:
            counts[lv] = counts.get(lv, 0) + 1
        cands = [lv for lv, c in counts.items() if c >= 2]
        use = min(cands) if cands else min(counts)
    picked = [(i, t) for i, lv, t in heads if lv == use and t]
    out: list = []
    for idx, (i, title) in enumerate(picked):
        end = picked[idx + 1][0] if idx + 1 < len(picked) else len(lines)
        chunk = "\n".join(lines[i + 1:end]).strip("\n")
        meta = {}
        sub_fields, sub_body = split_frontmatter(chunk)
        if sub_fields:
            meta = sub_fields
            chunk = sub_body
        m2 = re.search(r"(?:^|\n)\s*(?:[-*+]\s*)?\*{0,2}\s*(?:类型|type)\s*\*{0,2}\s*[:：]\s*([^\n]+)",
                       chunk[:400], re.I)
        if m2 and "类型" not in meta and "type" not in meta:
            meta["类型"] = m2.group(1).strip()
            chunk = chunk.replace(m2.group(0), "", 1).lstrip("\n")
        out.append({"title": title, "body": chunk, "meta": meta, "level": use})
    return out


def import_markdown_document(cfg: dict, text: str, level: int = 0, type_override: str = "",
                             target_dir: str = "", dry_run: bool = True, overwrite: bool = False,
                             download_images: bool = False, limit: int = 0,
                             on_progress=None) -> dict:
    """把一份 md 文档**批量**建成规范词条：拆词条 → 判类型 → 套模板 → （缺目录则创建）→ 写入。

    * 每个词条走的是 ⑥ 页同一条管线（`import_entry_from_text`）：套该类型的模板、
      把小节对齐、图片入库、只补空缺不覆盖已有正文；
    * 词条内自带 `类型: X`（或 frontmatter `type:`）时优先用它，其次按标题/正文猜；
    * `dry_run=True` 只报告会建到哪、判成什么类型，不动文件。
    返回 {ok, total, created, skipped, failed, report, entries}
    """
    entries = split_markdown_entries(text, level=level)
    if limit:
        entries = entries[:limit]
    created, skipped, failed, report = [], [], [], []
    for i, e in enumerate(entries, 1):
        title = str(e.get("title") or "").strip()
        body = str(e.get("body") or "")
        meta = e.get("meta") or {}
        typ = (str(meta.get("类型") or meta.get("type") or "").strip()   # 条目内写的类型优先
               or str(type_override or "").strip()
               or guess_note_type(title))
        m_sec = re.search(r"^#{2,6}\s+\S", body, re.M)
        if m_sec and body[:m_sec.start()].strip():
            # 第一个小节之前的段落（导语）变成第一个小节里的首条要点，确保**一个字都不丢**
            lead = " ".join(x.strip() for x in body[:m_sec.start()].strip().splitlines() if x.strip())
            rest = body[m_sec.start():].rstrip()
            nl = rest.find("\n")
            item = f"- {lead}\n"
            body = (rest[:nl + 1] + "\n" + item + rest[nl + 1:]) if nl >= 0 else (rest + "\n\n" + item)
        if not overwrite:                              # 同名已存在 → 默认跳过（补充更新请用 ⑦ 页 / --overwrite）
            routes = cfg.get("routes") or {}
            rel = str(target_dir or routes.get(typ) or routes.get(title) or "").strip()
            cand = None
            if rel:
                cand = Path(rel)
                if not cand.is_absolute():
                    cand = resolve_kb(cfg) / rel if resolve_kb(cfg) else None
            if cand is not None and (cand / f"{sanitize_title(title)}.md").is_file():
                report.append(f"{title} → 已存在，跳过（{cand.name}/）")
                skipped.append(title)
                continue
        try:
            r = import_entry_from_text(cfg, body, type_override=typ, title_override=title,
                                       download_images=download_images, mode="auto",
                                       dry_run=dry_run)
        except Exception as exc:  # noqa: BLE001
            r = {"ok": False, "report": [f"{type(exc).__name__}: {exc}"]}
        line = (f"{title} → {r.get('type') or typ}"
                f"（{'预览' if dry_run else r.get('action') or r.get('why') or '—'}）")
        if not r.get("ok"):
            reason = "；".join(str(x) for x in (r.get("report") or [])[:2]) or str(r.get("why") or "失败")
            line = f"{title} → {r.get('type') or typ}（✗ {reason}）"
        report.append(line)
        if not r.get("ok"):
            failed.append(title)
        elif (r.get("path") and Path(str(r["path"])).is_file() and not dry_run
              and r.get("action") in ("新建", "增量更新")):
            created.append(f"{Path(str(r['path'])).parent.name}/{title}")
        elif dry_run:
            created.append(f"{r.get('type') or typ}：{title}")
        else:
            skipped.append(title)
        if callable(on_progress):
            try:
                on_progress(i, len(entries), line)
            except Exception:
                pass
    return {"ok": not failed, "total": len(entries), "created": created, "skipped": skipped,
            "failed": failed, "report": report, "dry_run": dry_run, "entries": entries}


