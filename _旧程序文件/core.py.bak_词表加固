def scan_kb(root: str | Path) -> list[dict]:
    """
    扫描知识库根目录第一层子目录，建立注册表。
    返回 [{name, path, file_count, md_count, role}]，按 name 排序。
    role: "内容目录" / "特殊目录"
    """
    root = Path(root)
    if not root.is_dir():
        return []
    rows = []
    for d in sorted(root.iterdir(), key=lambda p: p.name):
        if not d.is_dir():
            continue
        files = list(d.rglob("*.md")) if d.is_dir() else []
        special = any(k.lower() in d.name.lower() for k in SPECIAL_DIR_KEYWORDS)
        rows.append({
            "name": d.name,
            "path": str(d),
            "file_count": len(list(d.iterdir())),
            "md_count": len(files),
            "role": "特殊目录" if special else "内容目录",
        })
    return rows


def registry_names(rows: list[dict]) -> list[str]:
    return [r["name"] for r in rows]


def resolve_kb(cfg: dict) -> Path | None:
    kb = (cfg.get("knowledge_base") or "").strip()
    if not kb:
        return None
    p = Path(kb)
    return p if p.is_dir() else None


TPL_DIR_NAMES = ("Templates（模板）", "Templates", "模板", "Templates(模板)")
TPL_DIR_UP_LEVELS = 4          # 知识库里没模板时，往上找几层（多时期库共用顶层模板库）

# 目录名里需要跳过的"系统目录"（不是内容类型）
DIR_SKIP_PARTS = ("模板", "templates", "assets", "attachments", "附件", "资产", "图片",
                  "pdf", "sources", "首页", "索引", "总览", "index")
DIR_NUM_PREFIX_RE = re.compile(r"^\d{1,3}(?:\s*[-—–]\s*\d{1,3})*\s*[-—–.、]?\s*")


def list_template_files(tdir, depth: int = 2) -> list:
    """模板库里的模板文件（**含子目录**，如 `古代社会模板/`、`近现代/`）。返回排序后的 list[Path]。"""
    if not tdir:
        return []
    d = Path(tdir)
    if not d.is_dir():
        return []
    out, seen = [], set()
    for p in sorted(d.glob("*.md")):
        if p.is_file() and p.name not in seen:
            seen.add(p.name)
            out.append(p)
    if depth > 1:
        for sub in sorted(x for x in d.iterdir() if x.is_dir()):
            for p in sorted(sub.glob("*.md")):
                if p.is_file() and p.name not in seen:
                    seen.add(p.name)
                    out.append(p)
    return out


def find_template_files(tdir, name: str) -> Path | None:
    """在模板库里按文件名找模板（先顶层、再一层子目录）。"""
    if not tdir or not str(name or "").strip():
        return None
    for p in list_template_files(tdir):
        if p.name == str(name).strip():
            return p
    return None


def profile_key(kb) -> str:
    """知识库档案的键：归一化绝对路径（统一小写与分隔符），保证同一库永远同一个键。"""
    s = str(kb or "").strip()
    if not s:
        return ""
    try:
        s = os.path.abspath(os.path.expanduser(s))
    except Exception:
        pass
    return os.path.normcase(s).replace("\\", "/")


def type_from_dir_name(dir_name: str) -> str:
    """目录名 → 类型名：去掉编号前缀（`01 `、`07-02`、`13`）、末尾 ⭐ 与括号说明。"""
    s = str(dir_name or "").strip()
    if not s:
        return ""
    if "\\" in s or "/" in s:
        s = Path(s).name
    s = DIR_NUM_PREFIX_RE.sub("", s)
    s = re.sub(r"\s*[⭐★]+\s*$", "", s)
    s = re.sub(r"[（(][^）)]*[）)]\s*$", "", s)
    return s.strip(" \t-_—–.、")


def types_from_dirs(dir_names) -> dict:
    """从目录名推"类型 → 目录"映射：`'01人物' → {'人物': '01人物'}`。

    跳过系统目录（模板/Assets/Attachments/附件/首页/索引…）；同名类型先出现的优先。
    """
    out: dict = {}
    for raw in (dir_names or []):
        name = str(raw or "").strip()
        if not name:
            continue
        low = name.lower()
        if any(k in low for k in DIR_SKIP_PARTS):
            continue
        t = type_from_dir_name(name)
        if not t or len(t) > 24 or t in out:
            continue
        out[t] = name
    return out


