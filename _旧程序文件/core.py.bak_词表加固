def pick_template_for_type(cfg: dict, type_: str, fallback: str = "通用.md") -> str:
    """给类型挑模板名：① 同名 ② 同义词表 ③ 包含关系（长度差 ≤2） ④ fallback。

    只在**当前生效模板库**（含其子目录）里找，不会把别的库的模板名带进来。
    """
    t = str(type_ or "").strip()
    if not t:
        return fallback
    td = templates_dir(cfg)
    names = [p.name for p in list_template_files(td)] if td else []
    if f"{t}.md" in names:
        return f"{t}.md"
    alias = TPL_TYPE_ALIASES.get(t)
    if alias and f"{alias}.md" in names:
        return f"{alias}.md"
    cands = sorted((abs(len(Path(n).stem) - len(t)), n) for n in names
                   if t in Path(n).stem or Path(n).stem in t)
    if cands and cands[0][0] <= 2:
        return cands[0][1]
    return fallback


def detect_route_profile(cfg: dict, kb=None) -> dict:
    """扫描一个知识库的目录，生成它自己的 {"routes":…, "template_routes":…}。

    * `routes`：用 `types_from_dirs`（目录名去编号前缀当类型名）；
    * `template_routes`：按**当前生效模板库**给每个类型挑模板 —— 同名 → 同义词（历史地理→地理、
      考古遗址→考古…）→ 包含关系 → `通用.md`；若模板库和程序内置都没有，才落 `通用.md`。
    """
    kb_path = Path(kb) if kb else resolve_kb(cfg)
    if kb_path is None or not Path(kb_path).is_dir():
        return {"routes": {}, "template_routes": {}}
    dirs = [d.name for d in sorted(Path(kb_path).iterdir()) if d.is_dir()]
    routes = types_from_dirs(dirs)
    probe = dict(cfg)
    probe["routes"] = dict(routes)
    probe["template_routes"] = {}                     # 只按"目录同名模板/通用/内置"解析
    tpl_routes: dict = {}
    for t in routes:
        name = pick_template_for_type(cfg, t, "通用.md")
        if name == "通用.md":                          # 模板库里没有 → 再看看程序内置模板
            try:
                p, note = resolve_template(probe, t)
                if p is not None:
                    name = p.name
                else:
                    m = re.search(r"[:：]\s*([^\s（(]+\.md)", str(note or ""))
                    if m:
                        name = m.group(1)
            except Exception:
                pass
        tpl_routes[t] = name
    return {"routes": routes, "template_routes": tpl_routes}


def get_kb_profile(cfg: dict, kb=None) -> dict:
    """取某个知识库的档案（没有就返回 {}）。"""
    key = profile_key(kb if kb is not None else cfg.get("knowledge_base"))
    if not key:
        return {}
    prof = (cfg.get("profiles") or {}).get(key)
    return dict(prof) if isinstance(prof, dict) else {}


def save_kb_profile(cfg: dict, kb=None, save: bool = True) -> dict:
    """把当前 `cfg` 顶层的 routes / template_routes / templates_dir 存成该库的档案。"""
    kb_str = str(kb if kb is not None else cfg.get("knowledge_base") or "").strip()
    key = profile_key(kb_str)
    if not key:
        return {}
    prof = {
        "kb": kb_str,
        "name": Path(kb_str).name,
        "routes": dict(cfg.get("routes") or {}),
        "template_routes": dict(cfg.get("template_routes") or {}),
        "templates_dir": str(cfg.get("templates_dir") or ""),
        "types": len(cfg.get("routes") or {}),
        "updated": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    cfg.setdefault("profiles", {})[key] = prof
    if save:
        save_config(cfg)
    return prof


def switch_kb(cfg: dict, new_kb, save: bool = True) -> dict:
    """切换知识库：旧库存档 → 换 knowledge_base → 载入新库档案（没有就扫描生成并存档）。

    返回 {ok, kb, profile_found, types, routes, templates_dir, report}
    """
    out = {"ok": False, "kb": "", "profile_found": False, "types": 0, "routes": {},
           "templates_dir": "", "report": []}
    new_str = str(new_kb or "").strip()
    if not new_str:
        out["report"].append("没有指定知识库目录")
        return out
    if not Path(new_str).is_dir():
        out["report"].append(f"目录不存在：{new_str}")
        return out
    old_str = str(cfg.get("knowledge_base") or "").strip()
    same_kb = bool(old_str) and profile_key(old_str) == profile_key(new_str)
    if old_str and not same_kb:
        save_kb_profile(cfg, old_str, save=False)     # ① 先把旧库的映射存档
        out["report"].append(f"已存档旧库档案：{Path(old_str).name}")
    cfg["knowledge_base"] = new_str
    prof = get_kb_profile(cfg, new_str)
    if prof and (prof.get("routes") or {}):
        out["profile_found"] = True
        cfg["routes"] = dict(prof.get("routes") or {})
        if prof.get("template_routes"):
            cfg["template_routes"] = dict(prof["template_routes"])
        out["report"].append(f"已载入该库档案（{len(cfg['routes'])} 个类型"
                             + (f"，更新于 {prof.get('updated')}" if prof.get("updated") else "") + "）")
    elif same_kb:
        # 同一个库、只是重新保存：把当前映射存成它的档案，**不要**用扫描结果覆盖手改过的映射
        save_kb_profile(cfg, new_str, save=False)
        out["profile_found"] = True
        out["report"].append(f"已为该库建立档案（沿用当前 {len(cfg.get('routes') or {})} 个类型的映射）")
    else:                                             # ③ 没有档案 → 扫描生成并保存
        det = detect_route_profile(cfg, new_str)
        cfg["routes"] = dict(det.get("routes") or {})
        cfg["template_routes"] = dict(det.get("template_routes") or {})
        out["report"].append((f"该库没有档案，已扫描目录生成映射：{len(cfg['routes'])} 个类型"
                              if cfg["routes"] else
                              "该库下没有可识别的类型目录（映射为空）——可用「📁 按映射创建/检查目录」"
                              "或「🔎 扫描当前库目录生成类型」"))
        save_kb_profile(cfg, new_str, save=False)
    # ④ 模板库：档案里有且存在就用；否则清掉让 templates_dir 自动解析（知识库自带 → 上级共用）
    td = str(prof.get("templates_dir") or "").strip() if prof else ""
    if td and Path(td).is_dir():
        cfg["templates_dir"] = td
    else:
        cfg.pop("templates_dir", None)
    cur_td = templates_dir(cfg)
    out.update(ok=True, kb=new_str, types=len(cfg.get("routes") or {}),
               routes=dict(cfg.get("routes") or {}),
               templates_dir=str(cur_td) if cur_td else "")
    out["report"].append("模板库：" + (str(cur_td) if cur_td else "（没找到，可到④页指定）"))
    if save:
        save_config(cfg)
    return out


def find_template_dirs(cfg: dict) -> list:
    """所有候选模板库（绝对路径字符串，已去重）：① 配置里指定的 ② 知识库自带的 ③ 上级目录共用的。"""
    out: list = []
    td = str(cfg.get("templates_dir") or "").strip()
    kb = resolve_kb(cfg)
    if td:
        p = Path(td)
        if not p.is_absolute() and kb is not None:
            p = kb / td
        out.append(str(p))
    if kb is not None:
        for name in TPL_DIR_NAMES:
            cand = kb / name
            if cand.is_dir() and str(cand) not in out:
                out.append(str(cand))
        up = kb.parent
        for _ in range(TPL_DIR_UP_LEVELS):
            if up is None or up == up.parent:
                break
            for name in TPL_DIR_NAMES:
                cand = up / name
                if cand.is_dir() and str(cand) not in out:
                    out.append(str(cand))
            up = up.parent
    for base in list(out):                            # 模板库里的**子目录**也作为候选（如 古代社会模板 / 近现代）
        try:
            for sub in sorted(x for x in Path(base).iterdir() if x.is_dir()):
                if list_template_files(sub, depth=1) and str(sub) not in out:
                    out.append(str(sub))
        except Exception:
            continue
    return out


def templates_dir(cfg: dict) -> Path | None:
    """模板库目录：① 配置 `templates_dir` ② 知识库自带 ③ **上级目录共用**（多时期库常见）。

    规则：优先选"有 .md 模板"的目录；本地 `Templates（模板）` 是空的话会继续用上级共用的那个
    （避免空目录把共享模板库挡住）。
    """
    td = str(cfg.get("templates_dir") or "").strip()
    kb = resolve_kb(cfg)
    if td:
        p = Path(td)
        if not p.is_absolute() and kb is not None:
            p = kb / td
        if p.is_dir():
            return p
        # 配置指向已失效：继续往下找，别让④页整个变空
    cands = [Path(x) for x in find_template_dirs(cfg)]
    for p in cands:
        if p.is_dir() and list_template_files(p):
            return p
    for p in cands:                                   # 都没有 .md 时，退回第一个存在的目录
        if p.is_dir():
            return p
    return None


def set_templates_dir(cfg: dict, path, save: bool = True) -> dict:
    """设置模板库目录（空串 = 恢复默认：知识库自带 → 上级共用）。返回 {ok, path, count, report}"""
    out = {"ok": False, "path": "", "count": 0, "report": []}
    p = str(path or "").strip()
    if p:
        cand = Path(p)
        kb = resolve_kb(cfg)
        if not cand.is_absolute() and kb is not None:
            cand = kb / p
        if not cand.is_dir():
            out["report"].append(f"目录不存在：{cand}")
            return out
        cfg["templates_dir"] = str(cand)
        out["path"] = str(cand)
    else:
        cfg.pop("templates_dir", None)
        cur = templates_dir(cfg)
        out["path"] = str(cur) if cur else ""
    if save:
        save_config(cfg)
    got = templates_dir(cfg)
    out["count"] = len(list(got.glob("*.md"))) if got else 0
    out["ok"] = got is not None
    out["report"].append(f"模板库：{out['path'] or '（没有找到）'}"
                         + (f"｜.md 模板 {out['count']} 个" if out["count"] else ""))
    return out


def ensure_templates_dir(cfg: dict, create: bool = True) -> Path | None:
    """模板目录：配置优先，其次 知识库自带/上级共用，都没有才（create=True 时）在知识库里新建。"""
    cur = templates_dir(cfg)
    if cur is not None:
        return cur
    kb = resolve_kb(cfg)
    if kb is None:
        return None
    p = kb / "Templates（模板）"
    if not p.is_dir():
        if not create:
            return None
        try:
            p.mkdir(parents=True, exist_ok=True)
        except Exception:
            return None
    return p


def resolve_type_alias(cfg: dict, type_: str) -> tuple[str, str]:
    """把 AI 判出的类型名对齐到②页配置的类型键。返回 (类型, 说明)。

    AI 常给「历史人物」「战役/战斗」「军事组织」这类说法，而映射表里是「人物/战役/军队」。
    精确匹配优先；否则按包含关系取最长的那个键（避免把「战役」错配到「战争」之外的键）；
    实在匹配不上就原样返回，由调用方给出清晰的报错。
    """
    type_ = str(type_ or "").strip()
    routes = cfg.get("routes") or {}
    if not type_ or type_ in routes:
        return type_, ""
    clean = re.sub(r"[\s/·、，,（）()]+", "", type_)
    for key in routes:
        if re.sub(r"[\s/·、，,（）()]+", "", key) == clean:
            return key, f"类型「{type_}」按②页映射归到「{key}」"
    partial = [k for k in routes if k and (k in type_ or type_ in k)]
    if partial:
        best = max(partial, key=len)
        return best, f"类型「{type_}」按②页映射归到「{best}」"
    return type_, ""


def resolve_route_dir(cfg: dict, type_: str) -> tuple[Path | None, str]:
    """
    类型 → 实际目录。返回 (路径, 状态说明)。
    优先精确匹配目录名，其次“去掉星号/空格后的归一化匹配”，找不到返回 None。
    类型名与②页映射不完全一致时（AI 常见）先做一次别名归并。
    """
    kb = resolve_kb(cfg)
    if kb is None:
        return None, "知识库未设置"
    alias_note = ""
    if type_ not in (cfg.get("routes") or {}):
        type_, alias_note = resolve_type_alias(cfg, type_)
    target = (cfg.get("routes") or {}).get(type_, "")
    if not target:
        known = "、".join(sorted((cfg.get("routes") or {}).keys())) or "（空）"
        return None, f"类型「{type_}」未配置路由（②页可用的类型：{known}）"
    rows = scan_kb(kb)
    exact = next((r for r in rows if r["name"] == target), None)
    if exact:
        return Path(exact["path"]), (alias_note + "；" if alias_note else "") + f"命中「{target}」"
    norm = normalize_dir_name(target)
    fuzzy = next((r for r in rows if normalize_dir_name(r["name"]) == norm), None)
    if fuzzy:
        return Path(fuzzy["path"]), (alias_note + "；" if alias_note else "") + f"归一化命中「{fuzzy['name']}」（配置为「{target}」）"
    known = "、".join(sorted((cfg.get("routes") or {}).keys())) or "（空）"
    return None, (f"目录不存在：{target}（请在 Obsidian 中创建后重新扫描，或在映射页重新指定；"
                  f"②页可用的类型：{known}）")


def normalize_dir_name(name: str) -> str:
    return re.sub(r"[\s⭐*★\-—]+", "", name).lower()


# ---------------------------------------------------------------------------
# 模板
# ---------------------------------------------------------------------------

def resolve_template(cfg: dict, type_: str) -> tuple[Path | None, str]:
    """
    类型 → 模板文件。返回 (模板路径, 状态说明)。
    规则（优先级从高到低）：
      1) `template_routes` 里显式配置的模板（②页/配置文件指定的，**最优先**，
         这样仓库里即使留着同名旧模板也不会盖掉你指定的那个）；
      2) 目录同名模板：类型 → 路由目录 → Templates（模板）/‹目录名去掉数字前缀›.md
         （如 制度→07 国家制度与财政→国家制度与财政.md，人物→02 人物图谱→人物图谱.md）；
      3) 通用.md；4) 内置模板。
    """
    from templates import BUILTIN_TEMPLATES, KB_TEMPLATES  # 延迟导入避免循环

    td = templates_dir(cfg)

    # 1) 显式映射优先（**支持模板库子目录**，如 古代社会模板/制度.md）
    fname = (cfg.get("template_routes") or {}).get(type_, "")
    if fname:
        if td is not None:
            p = find_template_files(td, fname)
            if p is not None:
                return p, f"模板文件：{fname}"
        if tpl_stem(fname) in KB_TEMPLATES:
            return None, f"内置模板：{fname}"

    # 2) 目录同名模板（仓库里没有显式映射时的约定；同样支持子目录）
    dir_path, _ = resolve_route_dir(cfg, type_)
    if dir_path is not None and td is not None:
        dirname = re.sub(r"^\d+\s*", "", dir_path.name)
        dirname = dirname.replace(" ⭐", "").replace("（中文）", "").strip()
        for cand in (f"{dirname}.md", f"{type_}.md"):
            p = find_template_files(td, cand)
            if p is not None:
                return p, f"目录同名模板：{cand}"

    # 2b) 按类型名在同义词表里挑（历史地理→地理.md、考古遗址→考古.md …）
    if td is not None:
        picked = pick_template_for_type(cfg, type_, "")
        if picked and picked != "通用.md":
            p = find_template_files(td, picked)
            if p is not None:
                return p, f"按类型匹配模板：{picked}"

    # 3) 通用模板（支持子目录）
    if td is not None:
        gp = find_template_files(td, "通用.md")
        if gp is not None:
            return gp, "通用模板：通用.md"
    if "通用" in BUILTIN_TEMPLATES:
        return None, "内置通用模板"
    return None, "内置通用模板"


def tpl_stem(name: str) -> str:
    """模板文件名 → stem（去掉 .md；不用 str.removesuffix，兼容 Python 3.8）。"""
    n = str(name or "").strip()
    return n[:-3] if n.lower().endswith(".md") else n


def builtin_template_text(type_: str, tpl_name: str = "") -> tuple[str, str]:
    """内置模板文本：先按模板文件名找，再按类型的默认模板，最后通用。"""
    from templates import BUILTIN_TEMPLATES, KB_TEMPLATES, TYPE_TEMPLATE_FILE

    stem = tpl_stem(tpl_name)
    if stem and stem in KB_TEMPLATES:
        return KB_TEMPLATES[stem], f"内置模板：{stem}.md"
    default = TYPE_TEMPLATE_FILE.get(type_, "")
    if default and default in KB_TEMPLATES:
        return KB_TEMPLATES[default], f"内置模板：{default}.md"
    if type_ in BUILTIN_TEMPLATES:
        return BUILTIN_TEMPLATES[type_], f"内置模板：{type_}"
    return KB_TEMPLATES.get("通用", ""), "内置通用模板"


def load_template_text(cfg: dict, type_: str) -> tuple[str, str]:
    """返回 (模板文本, 状态说明)。优先读模板目录 .md，否则内置。

    type_ 先与②页映射做一次别名归并（AI 可能给「历史人物」这类说法），
    保证模板与写入目录取的是同一个类型。
    """
    type_, _alias = resolve_type_alias(cfg, type_)
    path, note = resolve_template(cfg, type_)
    if path is not None:
        return path.read_text(encoding="utf-8"), note
    return builtin_template_text(type_, (cfg.get("template_routes") or {}).get(type_, ""))


# ---------------------------------------------------------------------------
# 标题规范化
# ---------------------------------------------------------------------------

ILLEGAL_CHARS = re.compile(r'[\\/:*?"<>|\r\n]')


def sanitize_title(title: str) -> str:
    t = ILLEGAL_CHARS.sub("", title).strip()
    t = re.sub(r"\s+", " ", t)
    return t or "未命名"


def ensure_timeline_title(title: str, year_hint: str = "") -> str:
    """时间线类命名规范：YYYY年-标题。缺年份时从 hint 或标题内提取。"""
    m = re.search(r"(\d{4})", title)
    year = m.group(1) if m else (re.search(r"(\d{4})", year_hint).group(1) if year_hint else "")
    if year and not re.match(r"^\d{4}年-", title):
        rest = re.sub(r"^\d{4}", "", title)
        title = f"{year}年-{rest}"
    return sanitize_title(title)


# ---------------------------------------------------------------------------
# Frontmatter（简单 YAML）
# ---------------------------------------------------------------------------

def split_frontmatter(text: str) -> tuple[dict | None, str]:
    """拆 Obsidian 风格 frontmatter。返回 (字段 dict, 正文)。"""
    if not text.startswith("---"):
        return None, text
    lines = text.splitlines()
    end = None
    for i in range(1, min(len(lines), 300)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return None, text
    fields = parse_simple_yaml("\n".join(lines[1:end]))
    body = "\n".join(lines[end + 1:])
    return fields, body


def parse_simple_yaml(s: str) -> dict:
    out = {}
    lines = s.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith("#") or line.startswith(" "):
            i += 1
            continue
        if ":" not in line:
            i += 1
            continue
        key, _, val = line.partition(":")
        key = key.strip()
        val = val.strip()
        if val == "":
            items = []
            j = i + 1
            while j < len(lines) and re.match(r"^\s*- ", lines[j]):
                items.append(re.sub(r"^\s*- ", "", lines[j]).strip())
                j += 1
            out[key] = items
            i = j
        else:
            out[key] = val
            i += 1
    return out


def serialize_simple_yaml(fields: dict) -> str:
    out = []
    for k, v in fields.items():
        if isinstance(v, list):
            items = [str(x) for x in v if str(x).strip()]
            if not items:                      # 空列表写成 []，Dataview 也认
                out.append(f"{k}: []")
                continue
            out.append(f"{k}:")
            for item in items:
                out.append(f"  - {item}")
        else:
            out.append(f"{k}: {v}")
    return "\n".join(out)


def is_empty_value(v) -> bool:
    if v is None:
        return True
    if isinstance(v, list):
        return len(v) == 0 or all(str(x).strip() == "" for x in v)
    return str(v).strip() in ("", "-", "[]", "[[]]", "（原始档案 / 回忆录 / 报刊 / 著作 / 口述 / 影像…）")


def split_list_value(v) -> list[str]:
    """把 AI 给的标量值按常见分隔符切成列表项（用于列表型 frontmatter 字段）。"""
    if isinstance(v, list):
        return [str(x).strip() for x in v if str(x).strip()]
    s = str(v).strip()
    parts = re.split(r"[、，,;；/|]", s)
    parts = [p.strip() for p in parts if p.strip()]
    return parts


def _coerce_field(key: str, val):
    """列表型字段一律写成列表（frontmatter 是结构化数据源，Dataview 要能按项过滤）。"""
    if key in LIST_FIELDS:
        if isinstance(val, list):
            return [str(x).strip() for x in val if str(x).strip()]
        return split_list_value(val)
    return normalize_field_value(val)


def update_frontmatter(fields: dict, new_fields: dict, report: list[str]) -> dict:
    """
    增量更新 frontmatter 字段：只填空值，不覆盖已有内容。
    返回按原顺序（新字段插在 tags / 标签 前）的 dict。
    """
    result = OrderedDict(fields)
    tag_key = next((k for k in result if k in ("标签", "tags")), None)
    for key, val in new_fields.items():
        if not key or key in ("标签", "tags"):
            continue
        if key in result:
            if is_empty_value(result[key]):
                result[key] = _normalize_to_existing_kind(result[key], val, key)
                report.append(f"frontmatter 填充：{key}")
            else:
                report.append(f"frontmatter 保留已有：{key}")
        else:
            pos = list(result.keys()).index(tag_key) if tag_key else len(result)
            items = list(result.items())
            items.insert(pos, (key, _coerce_field(key, val)))
            result = OrderedDict(items)
            report.append(f"frontmatter 新增：{key}")
    return result


def normalize_field_value(val) -> str | list[str]:
    if isinstance(val, list):
        return [str(x).strip() for x in val if str(x).strip()]
    s = str(val).strip()
    if not s or is_empty_value(s):
        return ""
    return s


LIST_SEPARATORS = "、，,;；/|"


def _normalize_to_existing_kind(old, val, key: str = "") -> str | list[str]:
    """按现有字段形态写入：列表型字段永远是列表；标量字段（如 date）保持标量。"""
    if isinstance(old, list) or key in LIST_FIELDS:
        items = split_list_value(val)
        if key in LIST_FIELDS or len(items) > 1 or (isinstance(val, str) and any(sep in val for sep in LIST_SEPARATORS)):
            return items
        return items[0] if len(items) == 1 else ""
    return normalize_field_value(val)


# ---------------------------------------------------------------------------
# 正文小节解析 / 合并（## 与 ### 均作为小节边界）
# ---------------------------------------------------------------------------

HEADER_RE = re.compile(r"^(#{2,3}) (.+?)\s*$")


def header_norm(header: str) -> str:
    # 忽略层级符号（#）与空格：让 "三、事件经过" 与 "## 三、事件经过"、"(###) 起因" 互相匹配
    return re.sub(r"[#\s]+", "", header)


def parse_sections(text: str) -> OrderedDict:
    """解析正文为 {header_norm: [原始标题行(含#), [行...]]}，保持出现顺序。"""
    sections = OrderedDict()
    cur = None
    for line in text.splitlines():
        m = HEADER_RE.match(line)
        if m:
            label = m.group(0).strip()
            norm = header_norm(label)
            sections[norm] = [label, []]
            cur = norm
        elif cur is not None:
            sections[cur][1].append(line)
    return sections


def build_body(sections: OrderedDict) -> str:
    lines = []
    for norm, (label, body) in sections.items():
        lines.append(label)
        if body:
            lines.extend(body)
    return "\n".join(lines)


PLACEHOLDER_BLOCKQUOTE = re.compile(r"^>\s*(用一段话|概括|为什么|TODO|待补充)")


EMPTY_VALUE_RE = re.compile(r"^[-—–~]{1,3}$|^(?:无|暂无|N/?A|待补|未知)$", re.I)


def _is_placeholder_line(raw: str) -> bool:
    """这一行是不是「空位」（供 is_fillable / 字段填空共用）。

    认得这些写法（格式规范 §1 总则第 7 条及其模板变体）：
      空行 / 纯注释 / 未渲染的模板表达式 /
      `- ` `- [[]]` / `- **字段**：` / `- **字段**：[[]]` /
      `- **甲方**：<!-- TODO -->（指挥官：…，兵力：…）`（注释 + 括号提示）/
      `1. <!-- TODO: 待补 -->`（编号占位）/ `（胜利/失败/停战）`（纯括号提示）
    """
    s = str(raw).strip()
    if not s:
        return True
    s = HTML_COMMENT_RE.sub("", s)
    s = TPL_EXPR_RE.sub("", s)
    s = re.sub(r"<%\*.*?%>", "", s, flags=re.S)
    s = s.strip()
    if not s:
        return True
    if re.match(r"^\*\*关联(模块)?\*\*\s*[:：]", s):          # 页脚不参与“小节是否为空”的判断
        return True
    if re.fullmatch(r"-{2,}", s):
        return True
    if re.fullmatch(r"[（(]?\d{1,2}\s*[.、)）]?", s):        # 1. / 2) / （3）
        return True
    if re.fullmatch(r"[（(][^（）()]*[)）]", s):              # 纯括号提示
        return True
    bullet = re.match(r"^[-*+]\s*", s)                  # 只剥列表符号，别把 ** 也剥掉
    body = s[bullet.end():].strip() if bullet else s.strip()
    if re.fullmatch(r"-{2,}", body) or body in ("", "[[]]", "[]"):
        return True
    hint = r"(?:[（(][^（）()]*[)）]\s*)*"          # 字段名与冒号之间允许夹「（若有）」这类提示
    fm = (re.match(rf"^\s*[-*+]?\s*\*\*\s*([^*]+?)\s*\*\*\s*{hint}[:：]\s*(.*)$", s)
          or re.match(rf"^\*\*([^*]+?)\*\*\s*{hint}[:：]\s*(.*)$", body))
    if fm:
        rest = re.sub(r"[（(][^（）()]*[)）]", "", fm.group(2)).strip()   # 去掉括号提示
        if rest in ("", "[[]]", "[]") or EMPTY_VALUE_RE.match(rest):
            return True
    plain = re.match(r"^([^：:]{1,26})\s*[:：]\s*(.*)$", body)           # 无 ** 的字段行
    if plain:
        rest = re.sub(r"[（(][^（）()]*[)）]", "", plain.group(2)).strip()
        if rest in ("", "[[]]", "[]") or EMPTY_VALUE_RE.match(rest):
            return True
    if body.startswith("[[]]"):
        return True
    return False


def is_fillable(section_body: list[str]) -> bool:
    """小节是否可填充：所有行都是空位就算空位（详见 _is_placeholder_line）。"""
    for raw in section_body:
        s = str(raw).strip()
        if not s:
            continue
        if _is_placeholder_line(raw):
            continue
        if s.startswith(">"):                       # 引用块占位（> 用一段话概括…）
            inner = HTML_COMMENT_RE.sub("", s.lstrip(">")).strip()
            if not inner or PLACEHOLDER_TEXT.search(inner):
                continue
        return False
    return True


def _ai_field_map(ai_body: list) -> dict:
    """从 AI 的行里抽 `- **字段**：值` / `字段：值`，供表单式小节逐字段填空。"""
    out: dict = {}
    for raw in ai_body or []:
        s = str(raw).strip()
        bullet = re.match(r"^[-*+]\s*", s)      # 只剥列表符号，别把 ** 也剥掉
        if bullet:
            s = s[bullet.end():].strip()
        m = (re.match(r"^\*\*\s*([^*]+?)\s*\*\*\s*[:：]\s*(.+)$", s)
             or re.match(r"^([^：:]{1,14})\s*[:：]\s*(.+)$", s))
        if m:
            key, val = m.group(1).strip(), m.group(2).strip()
            if key and val:
                out.setdefault(key, val)
    return out


def _match_field(name: str, fields: dict) -> str:
    """把一个模板字段名对到 AI 给的字段值：先精确，再唯一包含（如 所属战争 ↔ 战争）。"""
    if name in fields:
        return fields[name]
    cands = [k for k in fields if len(k) >= 2 and (k in name or name in k)]
    if len(cands) == 1:
        return fields[cands[0]]
    return ""


def _fill_table_cells(old_body: list, ai_body: list) -> tuple:
    """填空表格：模板里 `| 总兵力 |  |  |` 这种空单元格，用 AI 同名字段的值补上。

    值里若含明显分隔（` / `、`、`、`vs`、`；`），前两段分别填进两个空格。
    返回 (新正文 | None, 用掉的字段名集合)。
    """
    fields = _ai_field_map(ai_body)
    if not fields:
        return None, set()
    out, changed, used = [], False, set()
    for raw in old_body:
        line, s = raw, str(raw).strip()
        if s.startswith("|") and s.endswith("|") and not set(s) <= set("|-: "):
            cells = [c.strip() for c in s.strip("|").split("|")]
            if len(cells) >= 3 and cells[0]:
                name = re.sub(r"[*`\s]", "", cells[0])
                val = _match_field(name, fields)
                if val and any(not c for c in cells[1:]):
                    if " / " in val:                       # 优先按「 / 」分左右两方（如 林彪、聂荣臻 / 板垣征四郎）
                        parts = [p.strip() for p in val.split(" / ") if p.strip()]
                    else:
                        parts = [p for p in re.split(r"\s*(?:、|\bvs\b|VS|；|;)\s*", val) if p.strip()]
                    new_cells = list(cells)
                    for i in range(1, len(new_cells)):
                        if not new_cells[i] and parts:
                            new_cells[i] = parts.pop(0)
                            changed = True
                    indent = raw[: len(raw) - len(raw.lstrip())]
                    line = indent + "| " + " | ".join(new_cells) + " |"
                    used.add(name)
        out.append(line)
    return (out if changed else None), used


def _fill_empty_fields(old_body: list, ai_body: list) -> list | None:
    """表单式小节（时间/地点已自动填、还留着空字段）的合并：

    1) 按字段名把 AI 的值填进空字段行（`- **结果**：<!-- TODO -->` → `- **结果**：…`）；
    2) 名字对不上的 AI 行**追加到小节末尾**（不丢信息），但小节里已有的字段（时间/地点）不重复追加。
    什么都没做则返回 None（保持原样）。
    """
    fields = _ai_field_map(ai_body)
    if not fields and not [x for x in (ai_body or []) if str(x).strip()]:
        return None                                # 真的没有内容才返回 None
    existing_names: set = set()
    for raw in old_body:
        m = re.match(r"^\s*[-*+]\s*\*\*([^*]+?)\*\*\s*(?:[（(][^（）()]*[)）]\s*)*[:：]", str(raw))
        if m:
            existing_names.add(m.group(1).strip())
    new_body, changed, used = [], False, set()
    for raw in old_body:
        line = raw
        m = re.match(r"^(\s*[-*+]\s*\*\*([^*]+)\*\*\s*[:：]\s*)(.*)$", str(raw))
        if m and _is_placeholder_line(raw):
            name = m.group(2).strip()
            val = _match_field(name, fields) or _match_field(name.replace(" ", ""), fields)
            if val:
                line = m.group(1) + val
                changed = True
                used.add(name)
        new_body.append(line)
    table_body, table_used = _fill_table_cells(old_body, ai_body)   # 先填空表格单元格
    if table_body is not None:
        new_body, changed = table_body, True
        used |= table_used
    extras = []
    for raw in ai_body or []:
        s = str(raw).strip()
        if not s:
            continue
        fm = re.match(r"^\s*[-*+]?\s*\*\*\s*([^*]+?)\s*\*\*\s*[:：]", s)
        plain = re.match(r"^([^：:]{1,16})\s*[:：]", s)
        name = (fm or plain).group(1).strip() if (fm or plain) else ""
        if name:
            if name in existing_names or name in used:
                continue                      # 小节里已有这个字段（如时间/地点），不重复追加
            if any(len(n) >= 2 and (n in name or name in n) for n in existing_names | used):
                continue
        extras.append(s if s.startswith(("-", "*")) else "- " + s)
    if extras:
        new_body = new_body + ([""] if new_body and new_body[-1].strip() else []) + extras
        changed = True
    return new_body if changed else None


def _as_bullets(lines: list) -> list:
    """把应写成阶段列表的小节（如「生平简史」）统一成 `- **1881-1894**：…` 形式的条目。"""
    out = []
    for ln in lines:
        s = str(ln).strip()
        if not s:
            continue
        out.append(s if s.startswith(("-", "*")) else "- " + s)
    return out


def merge_sections(existing: OrderedDict, ai: OrderedDict, report: list[str]) -> OrderedDict:
    """
    把 AI 小节合并进现有小节：
      * 已有小节：空 → 整段替换（AI 摘要把引用块占位替换为 AI 行）；有内容 → 保留跳过；
        若小节内有子标题（###）且顶部无实质内容，AI 行插入为引言。
      * 新小节：追加到末尾（若存在“参考资料”则插在其前）。
    """
    result = OrderedDict(existing)
    for norm, (label, ai_body) in ai.items():
        if not [x for x in (ai_body or []) if str(x).strip()]:
            # AI 整节留空（模型保守）：明确记一行，界面会提示可重试
            report.append(f"⚠ AI 未给内容：{label}（保留 TODO；可重试「AI 分析与抽取」）")
            continue
        if norm in result:
            old = result[norm]
            old_body = old[1]
            if is_fillable(old_body):
                # 「生平简史」按格式规范 §2.2 写成时间线阶段列表，AI 给成段落也转成条目
                lines = _as_bullets(ai_body) if "生平简史" in section_clean_name(norm) else ai_body
                result[norm] = [old[0], _wrap_ai_body(old_body, lines)]
                report.append(f"正文填充：{label}")
            else:
                # 顶部无实质内容且有 ### 子标题 → AI 行作引言
                sub = any(HEADER_RE.match(ln) and ln.startswith("### ") for ln in old_body)
                if sub:
                    intro_region = old_body[: _first_subheader_index(old_body)]
                    if is_fillable(intro_region):
                        new_body = _wrap_ai_body(intro_region, ai_body) + old_body[_first_subheader_index(old_body):]
                        result[norm] = [old[0], new_body]
                        report.append(f"正文引言填充：{label}")
                        continue
                # 表单式小节（时间/地点已自动填，还留着空字段）：按字段名补空
                filled = _fill_empty_fields(old_body, ai_body)
                if filled is not None:
                    result[norm] = [old[0], filled]
                    report.append(f"正文填空（字段级）：{label}")
                else:
                    report.append(f"正文保留已有：{label}")
        else:
            # 追加：插到「参考资料」之前，否则末尾
            # 注意：emoji 模板里是 `## 📚 参考资料`，header_norm 会带上 emoji，
            # 所以这里按「去掉 emoji/序号后的中文名」来认，否则新小节会掉到页脚后面。
            ref_idx = next((i for i, nm in enumerate(result.keys())
                            if "参考资料" in section_clean_name(nm)), None)
            if ref_idx is not None:
                items = list(result.items())
                items.insert(ref_idx, (norm, [label, ai_body]))
                result = OrderedDict(items)
            else:
                result[norm] = [label, ai_body]
            report.append(f"新增小节：{label}")
    return result


def _first_subheader_index(body: list[str]) -> int:
    for i, ln in enumerate(body):
        if HEADER_RE.match(ln):
            return i
    return len(body)


def _wrap_ai_body(old_body: list[str], ai_body: list[str]) -> list[str]:
    """若原小节是引用块占位（> …），AI 行也按引用块排版；否则直接用 AI 行。"""
    had_blockquote = any(ln.strip().startswith(">") for ln in old_body)
    clean = [ln for ln in ai_body if ln.strip()]
    if had_blockquote:
        return [f"> {ln}" if not ln.startswith(">") else ln for ln in clean]
    return clean if clean else old_body


# ---------------------------------------------------------------------------
# 格式规范（Templates（模板）/格式规范.md）支持
#   * Templater 模板（开头 <%* %> 收集块 + 正文 <% %> 表达式）直接渲染成笔记骨架，
#     提示块本身绝不写进笔记（格式规范 §0.2 的「占位符卡在笔记里」陷阱）；
#   * frontmatter 只允许英文键名、禁止 [[ ]]；正文只有一个 H1 + emoji 章节；
#   * 空位统一写 <!-- TODO: 待补 -->；结尾固定 --- + **关联**：…。
# ---------------------------------------------------------------------------

TODO_TEXT = "<!-- TODO: 待补 -->"
HTML_COMMENT_RE = re.compile(r"<!--.*?-->", re.S)
TPL_PROMPT_BLOCK_RE = re.compile(r"<%\*(.*?)%>", re.S)
TPL_EXPR_RE = re.compile(r"<%\s*(.+?)\s*%>", re.S)
TPL_PROMPT_DECL_RE = re.compile(
    r'const\s+([^\s=]+)\s*=\s*await\s+tp\.system\.prompt\(\s*"((?:[^"\\]|\\.)*)"'
    r"\s*(?:,\s*([^)]*?)\s*)?\)\s*(?:\|\|\s*\"\")?\s*;"
)
TPL_APPEND_RE = re.compile(r"tR\s*\+=\s*(.+?);\s*(?=\n|$)")
# Templater 的 suggester（下拉/建议选择器）：
#   const 分期 = await tp.system.suggester(["晚清（1881—1911）", …], ["晚清", …], false, "历史分期")
#   第一个数组是显示文本，第二个（可选）是真正写进 frontmatter 的值 → 取第二个当允许取值。
TPL_SUGGESTER_DECL_RE = re.compile(
    r'const\s+([^\s=]+)\s*=\s*await\s+tp\.system\.suggester\(\s*(\[[^\]]*\])\s*,?\s*(\[[^\]]*\])?'
    r'([^;]*?)\)\s*(?:\|\|\s*"")?\s*;', re.S)
# frontmatter 拼装行：tR += "phase: " + 历史分期  →  变量「历史分期」写进 key「phase」
TPL_TR_KEY_RE = re.compile(r'tR\s*\+=\s*"([A-Za-z_][\w\-]*)\s*:\s*"\s*\+\s*([^\s;+)]+)')


def _array_strings(literal: str) -> list:
    """从 JS 数组字面量里取出字符串项（["a", 'b'] → ['a','b']）。"""
    return [m.group(1) if m.group(1) is not None else m.group(2)
            for m in re.finditer(r'"((?:[^"\\]|\\.)*)"|\'((?:[^\'\\]|\\.)*)\'', literal or "")]

# frontmatter 中文别名 → 规范英文键（格式规范 §1 总则第 1 条）
FIELD_ALIASES = {
    "姓名": "title", "名称": "title", "标题": "title", "条目": "title",
    "条约": "title", "文献": "title", "派系": "title", "院校": "title",
    "时期": "period", "年代": "period", "历史时期": "period", "核心时期": "period", "era": "period",
    "重要性": "importance", "历史重要性": "importance",
    "年份": "year",
    "出生年": "born", "生年": "born", "出生": "born",
    "逝世年": "died", "卒年": "died", "逝世": "died",
    "日期": "date", "时间": "date",
    "地点": "locations", "位置": "locations", "地区": "locations",
    "人物": "people", "相关人物": "people", "核心人物": "people", "关联人物": "people",
    "事件": "events", "相关事件": "events", "关联事件": "events",
    "组织": "organizations", "关联组织": "organizations", "组织列表": "organizations",
    "前置事件": "prev_events", "后续事件": "next_events",
    "前置战役": "prev_events", "后续战役": "next_events",
    "标签": "tags", "标签列表": "tags",
}
LIST_FIELDS = {"aliases", "locations", "people", "events", "organizations",
               "prev_events", "next_events", "tags", "sources", "references"}
FIELD_KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")     # 合规的 frontmatter 键（§1-1）
# 由模板/程序决定、AI 不得覆盖的字段
PROTECTED_FIELDS = {"title", "aliases", "type", "tags"}

PLACEHOLDER_TEXT = re.compile(r"^(用一段话|概括|为什么|TODO|待补充|待补)")

_JS_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", '"': '"', "'": "'", "\\": "\\"}
_JS_OPS = ("===", "!==", "==", "!=", "&&", "||", "?", ":", "+", "(", ")", "[", "]", ",", ".")


class TemplateExprError(ValueError):
    """模板表达式超出可安全求值的子集（如 tp.* 函数调用）。"""


def _js_tokens(expr: str) -> list:
    tokens: list = []
    i, n = 0, len(expr)
    while i < n:
        ch = expr[i]
        if ch.isspace():
            i += 1
            continue
        if ch in "\"'":
            quote, i, buf = ch, i + 1, []
            while i < n and expr[i] != quote:
                if expr[i] == "\\" and i + 1 < n:
                    buf.append(_JS_ESCAPES.get(expr[i + 1], expr[i + 1]))
                    i += 2
                    continue
                buf.append(expr[i])
                i += 1
            if i >= n:
                raise TemplateExprError("字符串缺少结束引号")
            i += 1
            tokens.append(("str", "".join(buf)))
            continue
        if ch.isdigit():
            j = i
            while j < n and (expr[j].isdigit() or expr[j] == "."):
                j += 1
            tokens.append(("num", expr[i:j]))
            i = j
            continue
        if ch.isalpha() or ch == "_" or ord(ch) > 127:
            j = i
            while j < n and (expr[j].isalnum() or expr[j] in "_$" or ord(expr[j]) > 127):
                j += 1
            tokens.append(("ident", expr[i:j]))
            i = j
            continue
        for op in _JS_OPS:
            if expr.startswith(op, i):
                tokens.append(("op", op))
                i += len(op)
                break
        else:
            raise TemplateExprError(f"无法解析的字符 {ch!r}")
    return tokens


def _truthy(val) -> bool:
    s = "" if val is None else str(val).strip()
    return s not in ("", "0", "false", "null", "undefined", "NaN")


def _is_number(val) -> bool:
    try:
        float(str(val).strip())
        return str(val).strip() != ""
    except (TypeError, ValueError):
        return False


class _JsParser:
    """模板用到的 JS 子集：字符串/数字/标识符、+ 拼接、?: 三元、|| 与 &&、括号。"""

    def __init__(self, tokens: list, values: dict):
        self.toks = tokens
        self.pos = 0
        self.values = values

    def _peek(self):
        return self.toks[self.pos] if self.pos < len(self.toks) else (None, None)

    def _take(self, op: str) -> bool:
        kind, val = self._peek()
        if kind == "op" and val == op:
            self.pos += 1
            return True
        return False

    def parse(self) -> str:
        val = self._ternary()
        if self.pos != len(self.toks):
            raise TemplateExprError("表达式未被完整解析")
        return val

    def _ternary(self) -> str:
        cond = self._or()
        if self._take("?"):
            a = self._ternary()
            if not self._take(":"):
                raise TemplateExprError("三元表达式缺少 :")
            b = self._ternary()
            return a if _truthy(cond) else b
        return cond

    def _or(self) -> str:
        val = self._and()
        while self._take("||"):
            rhs = self._and()
            val = val if _truthy(val) else rhs
        return val

    def _and(self) -> str:
        val = self._add()
        while self._take("&&"):
            rhs = self._add()
            val = rhs if _truthy(val) else val
        return val

    def _add(self) -> str:
        val = self._unary()
        while self._take("+"):
            rhs = self._unary()
            if _is_number(val) and _is_number(rhs):
                num = float(val) + float(rhs)
                val = str(int(num)) if num == int(num) else str(num)
            else:
                val = ("" if val is None else str(val)) + ("" if rhs is None else str(rhs))
        return val

    def _unary(self) -> str:
        kind, val = self._peek()
        if kind in ("str", "num"):
            self.pos += 1
            return val or ""
        if kind == "ident":
            self.pos += 1
            if self._peek() == ("op", "("):
                raise TemplateExprError(f"不支持函数调用 {val}(…)")
            if self._take("."):
                raise TemplateExprError(f"不支持属性访问 {val}.…")
            return self.values.get(val, "")
        if self._take("("):
            inner = self._ternary()
            if not self._take(")"):
                raise TemplateExprError("括号未闭合")
            return inner
        if self._take("["):
            raise TemplateExprError("不支持数组字面量")
        raise TemplateExprError("不支持该表达式")


def _eval_js(expr: str, values: dict) -> str:
    """求值模板表达式（只支持安全子集），失败抛 TemplateExprError。"""
    return _JsParser(_js_tokens(expr), values or {}).parse()


def parse_template(text: str) -> dict:
    """解析模板：{templater, prompts:[{var,label,default,options?}], body, field_keys, options}。

    * prompt 与 suggester 都算提示项（suggester 额外带 options 可选值）；
    * field_keys: {模板变量 → frontmatter 键}（从 `tR += "phase: " + 历史分期` 这类行解析），
      这样「历史分期」这类新变量才能被 AI 的 phase 值填上、并告诉 AI 允许的取值。
    """
    block = TPL_PROMPT_BLOCK_RE.search(text)
    prompts: list = []
    options: dict = {}
    if block:
        src = block.group(1)
        found: list = []
        for m in TPL_PROMPT_DECL_RE.finditer(src):
            var, label, default = m.group(1), m.group(2), (m.group(3) or "").strip()
            if "tp.file.title" in default:
                default = ""
            elif len(default) >= 2 and default[0] in "\"'" and default[-1] == default[0]:
                default = default[1:-1]
            found.append((m.start(), {"var": var, "label": label, "default": default}))
        for m in TPL_SUGGESTER_DECL_RE.finditer(src):
            var = m.group(1)
            display = _array_strings(m.group(2))
            values = _array_strings(m.group(3)) if m.group(3) else display
            tail = m.group(4) or ""
            quoted = re.findall(r'"([^"]{1,40})"', tail)
            item = {"var": var, "label": (quoted[-1] if quoted else var), "default": "",
                    "options": values, "display": display, "kind": "suggester"}
            if values:
                options[var] = values
            found.append((m.start(), item))
        prompts = [item for _pos, item in sorted(found, key=lambda x: x[0])]
    body = TPL_PROMPT_BLOCK_RE.sub("", text, count=1) if block else text
    body = re.sub(r"^\s*_%>\s*\n?", "", body.lstrip("\n"))
    templater = bool(block) or bool(TPL_EXPR_RE.search(text))
    field_keys = {var: key for key, var in TPL_TR_KEY_RE.findall(text)}
    return {"templater": templater, "prompts": prompts, "body": body,
            "field_keys": field_keys, "options": options}


def _render_expr(expr: str, values: dict, report: list) -> str:
    expr = expr.strip()
    if expr.startswith("tp."):
        report.append("正文里还有 tp.system.prompt（格式规范 §0.2 反例）：已改为 TODO 占位")
        return TODO_TEXT
    try:
        val = _eval_js(expr, values)
    except TemplateExprError as exc:
        report.append(f"模板表达式无法求值，已用 TODO 占位：{expr[:40]}（{exc}）")
        return TODO_TEXT
    text_val = "" if val is None else str(val)
    if text_val.strip():
        return text_val
    if '""' in expr:
        return ""            # 模板自己用空串兜底（如「肖像可留空」）→ 保持空行，不塞 TODO
    return TODO_TEXT


def render_template(text: str, values: dict, report: list | None = None) -> tuple[dict, str, list]:
    """把 Templater 模板渲染成 (frontmatter 字段, 正文, 提示项列表)。

    frontmatter 由模板里的 `tR += "…"` 逐行拼出（格式规范 §0.2 要点 3），
    正文里的 `<% 表达式 %>` 逐个求值，取不到值就落 <!-- TODO: 待补 -->。
    """
    report = report if report is not None else []
    parsed = parse_template(text)
    fm_lines: list = []
    for m in TPL_APPEND_RE.finditer(text):
        expr = m.group(1).strip()
        try:
            fm_lines.append(_eval_js(expr, values))
        except TemplateExprError as exc:
            report.append(f"模板 frontmatter 表达式跳过：{expr[:40]}（{exc}）")
    fields: dict = {}
    fm_text = "".join(fm_lines).split("\n")
    if fm_text and fm_text[0].strip() == "---":
        end = next((i for i in range(1, len(fm_text)) if fm_text[i].strip() == "---"), None)
        if end is not None:
            fields = parse_simple_yaml("\n".join(fm_text[1:end]))
    body = TPL_EXPR_RE.sub(lambda m: _render_expr(m.group(1), values, report), parsed["body"])
    body = TPL_EXPR_RE.sub("", body)
    return fields, body, parsed["prompts"]


def strip_wiki_links(value):
    """frontmatter 禁止 [[ ]]（格式规范 §1 总则第 2 条）：把 [[X]] / [[X|Y]] 还原成纯文本。"""
    if isinstance(value, list):
        return [strip_wiki_links(v) for v in value]
    return re.sub(r"\[\[([^\]|]+)(?:\|[^\]]+)?\]\]", r"\1", str(value)).strip()


def canonicalize_fields(fields: dict, report: list | None = None) -> OrderedDict:
    """frontmatter 规范化：中文键 → 英文键；去掉值里的 [[ ]]；列表字段统一为列表。"""
    report = report if report is not None else []
    out: OrderedDict = OrderedDict()
    for key, val in (fields or {}).items():
        name = str(key).strip()
        if not name:
            continue
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            eng = name
        else:
            eng = FIELD_ALIASES.get(name)
            if eng is None:
                report.append(f"frontmatter 非英文键无法映射，按原样保留：{name}")
                eng = name
            else:
                report.append(f"frontmatter 键规范化：{name} → {eng}")
        val = strip_wiki_links(val)
        if eng in LIST_FIELDS:
            if isinstance(val, list):
                items = [str(x).strip() for x in val if str(x).strip()]
            else:
                text = str(val).strip()
                items = [] if text in ("", "[]") else split_list_value(text)
            if isinstance(out.get(eng), list):
                out[eng] = out[eng] + items
            else:
                out[eng] = items
        else:
            if isinstance(val, list):
                val = "、".join(str(x).strip() for x in val if str(x).strip())
            out[eng] = val
    return out


def _first_value(val) -> str:
    if isinstance(val, list):
        return str(val[0]).strip() if val else ""
    return str(val).strip() if val is not None else ""


def build_template_values(type_: str, title: str, summary: str,
                          ai_fields: dict, prompt_items: list | None = None,
                          field_keys: dict | None = None) -> dict:
    """模板变量 → 值：标题/摘要/年份 + AI 字段（中文或英文键都认）+ 模板里的默认值。

    field_keys 是「模板变量 → frontmatter 键」映射（如 历史分期 → phase），
    这样模板新增的变量（含 suggester）也能拿到 AI 给的值。
    """
    ai = canonicalize_fields(ai_fields or {})
    year = ""
    m = re.search(r"(\d{4})", title or "")
    if m:
        year = m.group(1)
    year = year or str(ai.get("year") or "")
    vals = {
        "title": title, "标题": title, "名称": title, "姓名": title,
        "事件名称": title, "人物姓名": title, "简称": title, "别名": title, "generic_type": type_,
        "type": type_, "类型": type_,
        "summary": summary, "一句话": summary, "摘要": summary,
        "year": year, "年份": year,
        "period": str(ai.get("period") or ""), "时期": str(ai.get("period") or ""),
        "importance": str(ai.get("importance") or ""), "重要性": str(ai.get("importance") or ""),
        "date": str(ai.get("date") or ""), "日期": str(ai.get("date") or ""), "时间": str(ai.get("date") or ""),
        "born": str(ai.get("born") or ""), "出生年": str(ai.get("born") or ""),
        "died": str(ai.get("died") or ""), "逝世年": str(ai.get("died") or ""),
        "locations": _first_value(ai.get("locations")), "地点": _first_value(ai.get("locations")),
        "people": _first_value(ai.get("people")), "人物": _first_value(ai.get("people")),
        "events": _first_value(ai.get("events")), "事件": _first_value(ai.get("events")),
        "organizations": _first_value(ai.get("organizations")), "组织": _first_value(ai.get("organizations")),
    }
    for key, val in (ai_fields or {}).items():          # 模板自定义变量（字号/籍贯/身份…）原样透传
        vals.setdefault(str(key).strip(), _first_value(val))
    for var, key in (field_keys or {}).items():          # 模板变量 ← 对应英文键的 AI 值
        if not vals.get(var):
            v = ai.get(key, ai_fields.get(key) if isinstance(ai_fields, dict) else None)
            if v not in (None, "", []):
                vals[var] = _first_value(v)
    for item in (prompt_items or []):                    # 没给值就用提示里的默认值（如 重要性 "3"）
        var = item.get("var")
        if var and not vals.get(var) and item.get("default"):
            vals[var] = item["default"]
    return vals


def _best_section_match(norm: str, template_norms: list) -> str | None:
    """小节名对齐：先忽略序号/emoji 精确匹配，再取包含关系里最长的那个。"""
    clean = section_clean_name(norm)
    if not clean:
        return None
    exact = [t for t in template_norms if section_clean_name(t) == clean]
    if exact:
        return exact[0]
    partial = [t for t in template_norms
               if clean in section_clean_name(t) or section_clean_name(t) in clean]
    if not partial:
        return None
    return max(partial, key=lambda t: len(section_clean_name(t)))


def align_sections(sections: OrderedDict, template_sections: OrderedDict) -> OrderedDict:
    """把 '三、事件经过' / '事件经过' 这类小节名对齐到模板的 '📅 事件经过'。"""
    if not sections or not template_sections:
        return sections
    norms = list(template_sections.keys())
    out: OrderedDict = OrderedDict()
    for norm, value in sections.items():
        target = norm if norm in template_sections else _best_section_match(norm, norms)
        if target is None:
            out.setdefault(norm, value)
            continue
        if target in out:
            out[target][1].extend(value[1])
            continue
        out[target] = [template_sections[target][0], list(value[1])]
    return out


def template_skeleton(cfg: dict, type_: str) -> str:
    """模板渲染成「空值骨架」（供 AI 提示词 / 预览用）：没有提示块，空位全是 TODO。"""
    text, _note = load_template_text(cfg, type_)
    _parsed = parse_template(text)
    values = build_template_values(type_, "（标题）", "", {}, _parsed["prompts"],
                                  _parsed.get("field_keys"))
    if parse_template(text)["templater"]:
        fields, body, _ = render_template(text, values, [])
        fields = canonicalize_fields(fields)
        return "---\n" + serialize_simple_yaml(fields) + "\n---\n\n" + normalize_note_body(body, "")
    for key in ("{{title}}", "{{summary}}", "{{era}}", "{{importance}}", "{{year}}", "{{generic_type}}", "{{date}}"):
        text = text.replace(key, "")
    return text


def normalize_note_body(body: str, title: str = "", report: list | None = None,
                        footer: list | None = None) -> str:
    """按格式规范整理正文：唯一 H1、标题前后空行、空位写 TODO、结尾固定页脚。

    footer 形如 ["---", "", "**关联**：…"]：正文里已有页脚就保留正文的，
    没有就补上它（格式规范 §1 第 11 条）。
    """
    report = report if report is not None else []
    lines = [ln.rstrip() for ln in (body or "").replace("\r\n", "\n").split("\n")]

    found: list = []
    for i in range(len(lines) - 1, -1, -1):
        if lines[i].strip().startswith(("**关联**", "**关联模块**")):
            line = lines[i].strip().replace("**关联模块**", "**关联**")
            j = i - 1
            while j >= 0 and not lines[j].strip():
                j -= 1
            tail = [ln for ln in lines[i + 1:] if ln.strip()]      # 页脚之后的内容不能丢
            lines = lines[:j] if (j >= 0 and lines[j].strip() == "---") else lines[:i]
            if tail:
                lines = lines + [""] + tail
                report.append("新小节已放在关联页脚之前")
            found = ["---", line]                 # --- 紧贴 **关联**（§1-11）
            break
    footer = found or list(footer or [])
    if not found and footer:
        report.append("格式修正：补上 关联 页脚")

    h1 = [i for i, ln in enumerate(lines) if re.match(r"^#\s+\S", ln)]
    if not h1:
        if title:
            lines = [f"# {title}", ""] + lines
    else:
        for i in reversed(h1[1:]):
            lines[i] = re.sub(r"^#\s+", "## ", lines[i])
            report.append("格式修正：多余 H1 已降级为 H2")

    out: list = []
    for ln in lines:
        s = ln.strip()
        if DISPUTE_MARK in s:                      # §1-12：统一成「两个空格 + > ⚖️ 争议说明：…｜来源：…」
            probe = re.sub(r"^[-*+]\s*(?:>\s*)?", "", s)
            probe = re.sub(r"^>\s*", "", probe)
            if probe.startswith(DISPUTE_MARK):
                ln, s = "  > " + probe, "> " + probe
        if s in ("-", "*", "- [[]]", "-[[]]", "* [[]]", "- [[]] "):
            ln, s = "- " + TODO_TEXT, "- " + TODO_TEXT
        if "<%" in ln:
            ln = re.sub(r"<%\*.*?%>", "", ln, flags=re.S)
            ln = TPL_EXPR_RE.sub(lambda m: _render_expr(m.group(1), {}, report), ln)
            s = ln.strip()
            report.append("格式修正：清理了未渲染的模板表达式")
        if not s:
            if out and out[-1] == "":
                continue
            out.append("")
            continue
        if s.startswith("#"):
            if out and out[-1] != "":
                out.append("")
            out.append(ln)
            out.append("")
            continue
        if s.startswith(("- ", "* ")) and out and out[-1] != "" and not out[-1].lstrip().startswith(("- ", "* ")):
            out.append("")
        out.append(ln)

    body_text = "\n".join(out).strip("\n")
    if footer:
        body_text = body_text.rstrip("\n") + "\n\n" + "\n".join(footer) + "\n"
    return body_text


