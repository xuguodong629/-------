def check(name: str, cond: bool, extra: str = ""):
    global FAILS
    mark = "PASS" if cond else "FAIL"
    if not cond:
        FAILS += 1
    RESULTS.append(f"[{mark}] {name}" + (f"  — {extra}" if extra else ""))


