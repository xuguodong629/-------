          and det_t["template_routes"].get("战争") == "战争.md"
          and det_t["template_routes"].get("历史地理") == "地理.md"
          and det_t["template_routes"].get("考古遗址") == "考古.md"
          and det_t["template_routes"].get("没见过的类") == "通用.md",
          str(list(det_t["template_routes"].items())))

    # ---- 11n. 干净启动原则：一切自动行为都取消 ----
    os.environ["KB_BACKUP_DIR"] = str(SANDBOX / "_备份")

    # ① 目录不存在 → 失败且**绝不自动创建**
    cfg_no_dir = dict(cfg)
    cfg_no_dir["routes"] = dict(cfg["routes"], 事件="99 不存在目录")
    ghost = SANDBOX / "99 不存在目录"
    if ghost.exists():
        shutil.rmtree(ghost)
    r_nd = core.write_note(cfg_no_dir, "事件", "自动建目录测试", "", {}, OrderedDict())
    check("干净启动①：路由目录不存在 → write_note 失败、不建目录、提示指向②页",
          r_nd.get("ok") is False and not ghost.exists()
          and any("按映射创建" in x for x in r_nd.get("report") or []),
          str(r_nd.get("report"))[:140])
    r_nd2 = core.create_skeleton_note(cfg_no_dir, "自动建目录测试2", "事件", dry_run=False)
    check("干净启动①：目录不存在 → create_skeleton_note 也不建目录",
          r_nd2.get("ok") is False and not ghost.exists()
          and any("按映射创建" in x for x in r_nd2.get("report") or []),
          str(r_nd2.get("report"))[:140])

    # ② 切到没有档案的库 → 映射置空、不推断
    fake_kb = SANDBOX / "新库无档案"
    for d in ("01人物", "02事件"):
        (fake_kb / d).mkdir(parents=True, exist_ok=True)
    cfg_sw = dict(cfg)
    cfg_sw["profiles"] = {}
    sw = core.switch_kb(cfg_sw, fake_kb, save=False)
    check("干净启动②：切到无档案的库 → routes 为空、profile_found=False、提示去②页配置",
          sw.get("profile_found") is False and cfg_sw.get("routes") == {}
          and cfg_sw.get("template_routes") == {}
          and any("还没有配置" in x for x in sw.get("report") or []),
          str(sw.get("report"))[:160])

    # ③ templates_dir 不再向上级目录查找
    up_root = SANDBOX / "上级模板测试"
    (up_root / "子库").mkdir(parents=True, exist_ok=True)
    (up_root / "Templates（模板）").mkdir(parents=True, exist_ok=True)
    (up_root / "Templates（模板）" / "通用.md").write_text("# 通用", encoding="utf-8")
    cfg_up = {"knowledge_base": str(up_root / "子库"), "routes": {}, "template_routes": {},
              "templates_dir": ""}
    check("干净启动③：只配置了 templates_dir 时用它；未配置时**不向上级目录查找**",
          core.templates_dir({**cfg_up, "templates_dir": str(up_root / "Templates（模板）")})
          == up_root / "Templates（模板）" and core.templates_dir(cfg_up) is None,
          str(core.templates_dir(cfg_up)))

    # ③b 不再回落"程序内置模板"
    cfg_notpl = {"knowledge_base": str(fake_kb), "routes": {"人物": "01人物"},
                 "template_routes": {"人物": "人物图谱.md"}, "templates_dir": ""}
    _tp, _note = core.resolve_template(cfg_notpl, "人物")
    _text, _tnote = core.load_template_text(cfg_notpl, "人物")
    check("干净启动③：没有用户模板 → resolve_template 返回 None 并给出④页提示（无内置兜底）",
          _tp is None and not _text.strip()
          and "选择模板文件夹" in _note and "粘贴模板" in _note and "内置" not in _note,
          str(_note)[:90])

    # ③c 粘贴模板：写进程序自己的目录（KB_TPL_DIR 隔离），并被优先使用
    pt = core.save_pasted_template({}, "人物", "# 粘贴测试模板\n\n## 🪪 基本信息\n\n- <!-- TODO -->",
                                   save=False)
    check("干净启动③：粘贴模板保存到 <程序目录>/_模板/<类型>.md（可用 KB_TPL_DIR 隔离）",
          pt.get("ok") is True and Path(pt["path"]).parent == Path(os.environ["KB_TPL_DIR"])
          and Path(pt["path"]).name == "人物.md" and Path(pt["path"]).is_file(),
          str(pt.get("path")))
    cfg_paste = {"knowledge_base": str(fake_kb), "routes": {"人物": "01人物"},
                 "template_routes": {"人物": "人物.md"}, "templates_dir": ""}
    _tp2, _n2 = core.resolve_template(cfg_paste, "人物")
    check("干净启动③：粘贴的模板会被 resolve_template 找到",
          _tp2 is not None and _tp2.name == "人物.md"
          and _tp2.parent == Path(os.environ["KB_TPL_DIR"]), str(_tp2))

    # ④ 批量补链不再自动重建词表
    dict_file = core.term_dict_path(core.load_config())
    before = dict_file.read_bytes() if dict_file.is_file() else b""
    b_batch = core.link_keywords_batch(cfg, dry_run=True, limit=3)
    after = dict_file.read_bytes() if dict_file.is_file() else b""
    check("干净启动④：批量补链不再改写 _链接词表.json",
          before == after and bool(b_batch.get("ok")), f"{len(before)} → {len(after)} 字节")

    # ⑤ 备份目录在程序目录里、按知识库分文件夹（不在知识库里）
    root_env = os.environ.get("KB_BACKUP_DIR")
    os.environ["KB_BACKUP_DIR"] = ""
    try:
        br = core.backup_root(create=False)
        check("干净启动⑤：backup_root 在 <程序目录>/_备份/<库名>（不在知识库内）",
              str(br).startswith(str(core.app_dir())) and core.BACKUP_DIR_NAME in str(br)
              and str(SANDBOX) not in str(br), str(br))
    finally:
        os.environ["KB_BACKUP_DIR"] = root_env if root_env is not None else ""
    os.environ["KB_BACKUP_DIR"] = str(SANDBOX / "_备份")

    out_txt = core.normalize_note_body("## ⚖️ 历史评价\n\n- 兵力数字说法不一\n  > ⚖️ 争议说明：各方统计差别很大。\n",
                                       "争议测试", [], "")
    check("争议说明：归一化绝不代写「｜来源：」", "｜来源" not in out_txt, out_txt[:100].replace("\n", " "))
    rep2 = []
    core.build_note_text(cfg, "事件", "争议文案测试", "", {},
                         core.parse_sections("## 📌 事件概览\n\n- 兵力数字说法不一。\n"
                                             "  > ⚖️ 争议说明：各方统计差别很大。\n"), rep2)
    check("争议说明：报告明确提示“缺来源”，不再写“已就地附来源简介”",
          any("缺来源" in x for x in rep2) and not any("已就地附" in x for x in rep2),
          str([x for x in rep2 if "争议" in x]))

    # ---- 11n. 写盘跟随原文件换行符（不再制造 CRLF/LF 混合）----
    crlf_note = SANDBOX / "02 人物图谱" / "换行CRLF测试.md"
    crlf_src = "# 换行CRLF测试\n\n正文 [[链接目标人物]] 一行。\n\n## 📜 生平简史\n\n- 内容\n\n---\n**关联**：[[02人物图谱]]\n"
    crlf_note.write_bytes(crlf_src.replace("\n", "\r\n").encode("utf-8"))
    core.link_keywords(cfg, crlf_note, dry_run=False)
    raw = crlf_note.read_bytes()
    crlf_cnt = raw.count(b"\r\n")
    bare_lf = raw.count(b"\n") - crlf_cnt
    check("换行符：改写 CRLF 笔记后仍是 CRLF，且没有双重转换",
          crlf_cnt > 0 and bare_lf == 0 and (b"\r\r\n" not in raw),
          "CRLF %d 处｜裸 LF %d 处" % (crlf_cnt, bare_lf))
    lf_note = SANDBOX / "02 人物图谱" / "换行LF测试.md"
    lf_note.write_bytes(("# 换行LF测试\n\n正文 [[链接目标人物]] 一行。\n\n---\n**关联**：[[02人物图谱]]\n").encode("utf-8"))
    core.link_keywords(cfg, lf_note, dry_run=False)
    raw2 = lf_note.read_bytes()
    crlf2 = raw2.count(b"\r\n")
    check("换行符：改写 LF 笔记后仍是 LF", b"\r\n" not in raw2, "CRLF %d 处" % crlf2)
    new_path = SANDBOX / "02 人物图谱" / "换行新建测试.md"
    if new_path.exists():
        new_path.unlink()
    core.write_note(cfg, "人物", "换行新建测试", "", {}, {})
    new_raw = new_path.read_bytes() if new_path.is_file() else b""
    new_crlf = new_raw.count(b"\r\n")
    check("换行符：新建笔记用 LF", bool(new_raw) and (b"\r\n" not in new_raw),
          "CRLF %d 处" % new_crlf)
    style_new = core.write_text_keep_eol(SANDBOX / "eol_new.txt", "a\nb\n")
    style_crlf = core.write_text_keep_eol(crlf_note, crlf_note.read_text(encoding="utf-8"))
    check("换行符：write_text_keep_eol 新文件→LF、CRLF 文件→CRLF、二次写不双重转换",
          style_new == "LF" and style_crlf == "CRLF" and (b"\r\r\n" not in crlf_note.read_bytes()),
          "新文件 %s｜CRLF 文件 %s" % (style_new, style_crlf))
    core.update_note_file(cfg, crlf_note, sections={}, dry_run=False)
    after = crlf_note.read_bytes()
    after_crlf = after.count(b"\r\n")
    after_bare = after.count(b"\n") - after_crlf
    check("换行符：update_note_file 改写 CRLF 笔记后仍是 CRLF",
          after_crlf > 0 and after_bare == 0 and (b"\r\r\n" not in after),
          "CRLF %d 处｜裸 LF %d 处" % (after_crlf, after_bare))

    # ---- 11n. sections 形状校验 + 兼容直觉写法 ----
    r1 = core.write_note(cfg, "人物", "形状测试甲", "", {}, {"生平简史": ["- 甲", "- 乙"]})
    t1 = Path(r1["path"]).read_text(encoding="utf-8")
    check("sections 直觉写法：{名称: [行…]} 不抛异常且内容进小节",
          "甲" in t1 and "乙" in t1 and "生平简史" in t1, str(r1.get("action")))
    r2 = core.write_note(cfg, "人物", "形状测试乙", "", {}, {"生平简史": "- 甲\n- 乙"})
    t2 = Path(r2["path"]).read_text(encoding="utf-8")
    check("sections 直觉写法：{名称: 整段文本} 同样生效",
          "甲" in t2 and "乙" in t2, str(r2.get("action")))
    r3 = core.write_note(cfg, "人物", "形状测试丙", "", {},
                         {"生平简史": ("## 📜 生平简史", ["- 甲", "- 乙"])})
    t3 = Path(r3["path"]).read_text(encoding="utf-8")
    check("sections 内部形状向后兼容", "甲" in t3 and "乙" in t3, str(r3.get("action")))
    n1 = core.normalize_sections_input({"## 生平简史": ["- 甲"]})
    check("sections：名称已带 `## ` 时不重复补",
          list(n1)[0] == "生平简史" and n1["生平简史"][0] == "## 生平简史", str(n1))
    a = core.normalize_sections_input({"生平简史": ["- 甲", "- 乙"]})
    b = core.normalize_sections_input({"生平简史": "- 甲\n- 乙"})
    c = core.normalize_sections_input({"生平简史": ("## 📜 生平简史", ["- 甲", "- 乙"])})
    check("sections：三种写法归一化后结构一致", list(a) == list(b) == list(c), str(a))
    try:
        core.normalize_sections_input({"生平简史": 123})
        msg = "（没有抛异常 ✗）"
    except ValueError as e:
        msg = str(e)
    check("sections：非法形状抛中文 ValueError 且含示例写法",
          "形状" in msg and "整段文本" in msg and "收到" in msg, msg[:70])
    r4 = core.update_note_file(cfg, Path(r1["path"]), sections={"生平简史": ["- 丙"]},
                               dry_run=False)
    t4 = Path(r1["path"]).read_text(encoding="utf-8")
    check("sections：update_note_file 也接受直觉写法", bool(r4.get("ok")), str(r4.get("action")))

    # ---- 汇总 ----
    print("=" * 60)
    print("民国历史知识库 · 核心引擎自测")
    print("=" * 60)
    for line in RESULTS:
        print(" " + line)
    print("=" * 60)
    fails = sum(1 for r in RESULTS if r.startswith("[FAIL]"))
    print(f"结果：{len(RESULTS) - fails}/{len(RESULTS)} 通过，{fails} 失败")
    print("沙盒目录：" + str(SANDBOX))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
