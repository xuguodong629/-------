def patch(path, pairs, label):
    p = pathlib.Path(path)
    s = p.read_text(encoding="utf-8")
    for old, new, why in pairs:
        if old not in s:
            print(f"  ⚠ 锚点未命中（跳过）：{why}")
            continue
        s = s.replace(old, new, 1)
        print(f"  ✓ {why}")
    if p.suffix == ".py":
        ast.parse(s)
    p.write_text(s, encoding="utf-8")
    print(f"  → {p.name} 写入完成（{label}）")


