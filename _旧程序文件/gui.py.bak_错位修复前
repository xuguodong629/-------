    def do_quality_check(self):
        """规范清单体检（只读、零 token）：读规范里的检查清单，逐条报 自动/人工/未通过/脱节。"""
        def work():
            return core.quality_checklist(self.cfg)

        self.log(self.index_log, "▶ 规范清单体检：读规范 §15 的清单 → 逐条跑已实现的检查…", "head")
        self.run_task(work, self._on_quality_done, "规范清单体检", busy=(self.btn_quality,))

    def _on_quality_done(self, r):
        r = self._on_result(self.index_log, r, "规范清单体检失败：")
        if r is None:
            return
        total = int(r.get("total") or 0)
        if not total:
            self.log(self.index_log, "✗ 没有找到规范文件或缺 §15 一节"
                                     "（可在 config.json 里用 spec_file 指定规范路径）", "err")
            for d in (r.get("drift") or []):
                self.log(self.index_log, "   · " + str(d), "info")
            self.set_status("规范清单体检：未找到规范文件", err=True)
            return
        spec_name = Path(r.get("spec_path") or "").name
        self.log(self.index_log, "─── 📋 规范清单体检（" + spec_name + " · " + core.SPEC_SECTION_HEAD
                                 + "，共 " + str(total) + " 条）───", "head")
        icons = {"pass": "✅", "fail": "❌", "manual": "⚪"}
        for it in (r.get("items") or []):
            st = it.get("status")
            text = str(it.get("text") or "")
            if len(text) > 44:
                text = text[:44]
            line = icons.get(st, "·") + " " + str(it.get("no")).rjust(2) + ". " + text.ljust(46)
            if st == "fail":
                line += "→ 未通过（" + str(it.get("detail"))[:80] + "）"
            elif st == "manual":
                line += "→ 人工复核"
            else:
                line += "→ 通过"
                if it.get("detail"):
                    line += "（" + str(it.get("detail")) + "）"
            self.log(self.index_log, line, "ok" if st == "pass" else ("err" if st == "fail" else "info"))
        for d in (r.get("drift") or []):
            self.log(self.index_log, "⚠️ 脱节：" + str(d), "err")
        self.log(self.index_log, "（本工具只报告、不修改任何文件）", "info")
        passed = int(r.get("mapped") or 0) - int(r.get("failed") or 0)
        self.set_status("规范清单：" + str(total) + " 条（自动 " + str(r.get("mapped") or 0)
                        + "：通过 " + str(passed) + " / 未通过 " + str(r.get("failed") or 0)
                        + "｜人工 " + str(r.get("manual") or 0) + "）｜脱节 "
                        + str(len(r.get("drift") or [])),
                        err=bool(r.get("failed") or r.get("drift")))

    def do_syntax_check(self):
        """Markdown 结构体检（只读、零 token）：查 7 类语法级污染。"""
        def work():
            return core.syntax_check(self.cfg)

        self.log(self.index_log, "▶ 语法体检：检查 [[_索引|X]] / 嵌套双链 / <!-- 不配对 / "
                                 "frontmatter 异常 / BOM / 重复 ## …", "head")
        self.run_task(work, self._on_syntax_done, "语法体检", busy=(self.btn_syntax,))

    def _on_syntax_done(self, r):
        r = self._on_result(self.index_log, r, "语法体检失败：")
        if r is None:
            return
        counts = r.get("counts") or {}
        findings = r.get("findings") or {}
        self.log(self.index_log, f"─── 🩺 Markdown 结构体检（{r.get('files')} 篇）───", "head")
        bad = []
        for key, label in core.SYNTAX_ITEMS:
            n = int(counts.get(key) or 0)
            if n:
                bad.append((label, n))
            self.log(self.index_log, f"{label:<18}: {n:<6}{'✅' if not n else '⚠️'}",
                     "ok" if not n else "err")
        for key, label in core.SYNTAX_ITEMS:
            n = int(counts.get(key) or 0)
            if not n:
                continue
            self.log(self.index_log, f"   --- {label}（{n} 处）---", "err")
            for it in (findings.get(key) or [])[:20]:
                self.log(self.index_log, "      · " + str(it), "info")
            if n > len(findings.get(key) or []):
                self.log(self.index_log, f"      …（其余 {n - len(findings.get(key) or [])} 处略）", "info")
        if r.get("ok"):
            self.log(self.index_log, "✅ 七项全绿：没有发现语法级问题。", "ok")
            self.set_status("语法体检：七项全绿 ✅")
        else:
            summary = "、".join(f"{lab} {n} 处" for lab, n in bad)
            self.log(self.index_log, "⚠️ 本工具**只报告、不修改任何文件**"
                                     "（要修请先备份、并且一次只改一类）", "info")
            self.set_status(f"语法体检：{len(bad)} 项有发现（{summary}）", err=True)

    def do_build_index(self):
        """重建各目录索引 + 总索引。"""
        def work():
            return core.build_index(self.cfg)

        self.run_task(work, self._on_index_done, "重建索引", busy=(self.btn_index,))

    # ---- 全库补正文双链（⑤ 页）----

    def do_link_all_preview(self):
        self._do_link_all(dry_run=True)

    def do_link_all_write(self):
        self._do_link_all(dry_run=False)

    def _do_link_all(self, dry_run: bool):
        """全库补双链：dry_run=True 只统计；False 才逐篇写盘（core 会先备份）。"""
        cfg = self.cfg

        def work():
            return core.link_keywords_batch(cfg, dry_run=dry_run)

        desc = "🔗 全库补双链（预览）" if dry_run else "🔗 全库补双链（写入）"
        self.run_task(work, lambda r: self._on_link_all_done(r, dry_run=dry_run), desc,
                      busy=(self.btn_link_all, self.btn_link_all_write))

    def _on_link_all_done(self, r, dry_run: bool):
        r = self._on_result(self.index_log, r, "全库补双链失败：")
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(str(x) for x in (r.get("report") or ["全库补双链未能完成"]))
            self.log(self.index_log, f"✗ {detail}", "err")
            self.set_status(f"{detail}（详情见日志区）", err=True)
            return
        details = r.get("details") or []
        for line in r.get("report") or []:
            self.log(self.index_log, "✓ " + str(line), "ok")
        self.log(self.index_log, f"   检查 {r.get('files')} 篇 → {'可补' if dry_run else '已补'} "
                                 f"{r.get('changed')} 篇、共 {r.get('links')} 个链接"
                                 f"（候选词条 {r.get('index')} 个）", "info")
        for d in details[:15]:
            self.log(self.index_log,
                     f"   · {d.get('dir')}/{d.get('title')}.md → {len(d.get('added') or [])} 个", "info")
        if len(details) > 15:
            self.log(self.index_log, f"   …（其余 {len(details) - 15} 篇略）", "info")
        if not details:
            self.log(self.index_log, "   （没有可补的词条双链）", "info")
        if dry_run:
            self.log(self.index_log, "   确认无误再点「🔗 全库补双链（写入）」", "info")
            self.set_status(f"全库补双链预览：可补 {r.get('changed')} 篇、{r.get('links')} 个链接")
        else:
            self.log(self.index_log,
                     f"   旧版已备份到 {core.BACKUP_DIR_NAME}/笔记/（每个文件只留最新一份）", "info")
            self.set_status(f"全库补双链完成：{r.get('changed')} 篇、{r.get('links')} 个链接")

    def _on_index_done(self, r):
        r = self._on_result(self.index_log, r)
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(r.get("report") or ["索引重建失败"])
            self.log(self.index_log, f"✗ {detail}", "err")
            self.set_status(f"索引重建失败：{detail}（详情见日志区）", err=True)
            return
        self.log(self.index_log, f"✓ 总索引：{r.get('master')}", "ok")
        n = 0
        for rep in r.get("report") or []:
            self.log(self.index_log, "   · " + rep, "info")
            n += 1
        self.set_status(f"索引重建完成：总索引 {r.get('master')}（{n} 条明细见日志）")

    def do_stats(self):
        def work():
            return core.kb_stats(self.cfg)

        self.run_task(work, self._on_stats_done, "统计", busy=(self.btn_stats,))

    def _on_stats_done(self, r):
        r = self._on_result(self.index_log, r)
        if r is None:
            return
        for i in self.stat_tree.get_children():
            self.stat_tree.delete(i)
        if not r.get("ok"):
            self.log(self.index_log, "✗ 知识库未设置", "err")
            self.set_status("统计失败：知识库未设置（详情见日志区）", err=True)
            return
        for name, role, n in r.get("rows") or []:
            self.stat_tree.insert("", "end", values=(name, role, n))
        self.log(self.index_log, f"✓ 知识库：{r.get('root')}", "ok")
        self.log(self.index_log, f"  内容目录笔记：{r.get('content_total')}｜全部 .md（含模板/索引）：{r.get('total')}", "info")
        self.set_status(f"统计完成：内容目录 {r.get('content_total')} 个笔记，全部 .md {r.get('total')} 个")

