    def _template_name_choices(self) -> list:
        """模板名候选：**只用用户提供的模板**（选定文件夹 / 粘贴目录 / 库内 Templates），可手输。"""
        names = []
        td = core.templates_dir(self.cfg)
        if td:
            try:
                names += [p.name for p in sorted(core.list_template_files(td))]
            except Exception:
                pass
        for sd in core.template_sources(self.cfg):
            try:
                names += [f.name for f in core.list_template_files(sd)]
            except Exception:
                pass
        return list(dict.fromkeys(names)) or ["通用.md"]

    def refresh_tpl_map(self):
        """④页「每个类型用哪个模板」表：跟着当前知识库与类型映射刷新。"""
        if not hasattr(self, "tpl_map_tree"):
            return
        for i in self.tpl_map_tree.get_children():
            self.tpl_map_tree.delete(i)
        self._tpl_name_choices = self._template_name_choices()
        td = core.templates_dir(self.cfg)
        routes = self.cfg.get("template_routes") or {}
        for t in sorted((self.cfg.get("routes") or {}).keys()):
            tpl = str(routes.get(t) or "通用.md")
            exists = bool(td and (td / tpl).is_file())
            note = "✓ 仓库里有这个模板" if exists else "仓库里暂无 —— 写入时会自动补/或点上面「补齐缺失」"
            self.tpl_map_tree.insert("", "end", iid=t, values=(t, tpl, note))

    def _on_tpl_map_double(self, event):
        """双击「模板文件」单元格就地改这个类型的模板指向（改完即存）。"""
        tree = self.tpl_map_tree
        if tree.identify_region(event.x, event.y) != "cell":
            return
        if tree.identify_column(event.x) != "#2":
            return
        row = tree.identify_row(event.y)
        if not row:
            return
        vals = tree.item(row, "values")
        if not vals:
            return
        t, cur = str(vals[0]), str(vals[1])
        bbox = tree.bbox(row, "#2")
        if not bbox or not bbox[2]:
            return
        x, y, w, h = bbox
        ed = ttk.Combobox(tree, values=list(getattr(self, "_tpl_name_choices", ["通用.md"])),
                          state="normal")
        ed.set(cur)
        ed.place(x=x, y=y, width=w, height=h)
        ed.focus_set()
        done = {"closed": False}

        def commit(_e=None):
            if done["closed"]:
                return
            done["closed"] = True
            new = ed.get().strip()
            try:
                ed.destroy()
            except Exception:
                pass
            if not new:
                new = "通用.md"
            if not new.lower().endswith(".md"):
                new += ".md"
            if new == cur:
                self.set_status(f"未修改：{t} → {cur}")
                return
            self.cfg.setdefault("template_routes", {})[t] = new
            self.refresh_tpl_map()
            self.refresh_map_rows()
            self._persist(f"模板指向：{t} → {new}")

        def cancel(_e=None):
            if done["closed"]:
                return
            done["closed"] = True
            try:
                ed.destroy()
            except Exception:
                pass
            self.set_status("已取消编辑")
        ed.bind("<<ComboboxSelected>>", commit)
        ed.bind("<Return>", commit)
        ed.bind("<FocusOut>", commit)
        ed.bind("<Escape>", cancel)

