    def refresh_template_tree(self):
        if not hasattr(self, "tpl_tree"):
            return
        for i in self.tpl_tree.get_children():
            self.tpl_tree.delete(i)
        td = core.templates_dir(self.cfg)                # 每次都按当前知识库重新取（换库后跟着变）
        self.tpl_dir_var.set(td if td else "（未设置：<知识库>/Templates（模板） 不存在）")
        self.refresh_tpl_lib()
        self.refresh_tpl_map()
        used = {str(v).strip() for v in (self.cfg.get("template_routes") or {}).values()}
        sources = core.template_sources(self.cfg)
        seen_any = False
        for sd in sources:                       # 只列**用户提供的**模板文件（选定文件夹 / 粘贴目录 / 库内 Templates）
            try:
                files = core.list_template_files(sd)
            except Exception:
                files = []
            for f in files:
                seen_any = True
                tag = "粘贴模板" if "_模板" in str(sd) else str(sd)
                self.tpl_tree.insert("", "end",
                                     values=(f.name, ("✓ 已被某个类型使用" if f.name in used
                                                      else "（未被任何类型使用）") + f"｜来源：{tag}"))
        if not sources:
            self.tpl_tree.insert("", "end",
                                 values=("（还没有模板）", "请在上面「模板库」选一个模板文件夹，"
                                                        "或点「📋 粘贴模板」"))
        elif not seen_any:
            self.tpl_tree.insert("", "end",
                                 values=("（模板文件夹里没有 .md）", "换个目录，或点「📋 粘贴模板」"))

    def refresh_tpl_lib(self):
        """④页「模板库」行：回显当前生效的模板库（找不到/没模板时标红）+ 候选下拉。"""
        if not hasattr(self, "tpl_lib_combo"):
            return
        td = core.templates_dir(self.cfg)
        if td is None:
            self.tpl_lib_var.set("（没有找到模板库，请点「📂 浏览…」选一个目录）")
            try:
                self.tpl_lib_label.configure(foreground="#b00020")
            except Exception:
                pass
        else:
            try:
                count = len(list(core.list_template_files(td)))
            except Exception:
                count = 0
            self.tpl_lib_var.set(f"{td}（{count} 个模板）")
            try:
                self.tpl_lib_label.configure(foreground="#b00020" if not count else "#0a7d32")
            except Exception:
                pass
        try:
            cands = core.find_template_dirs(self.cfg)
        except Exception:
            cands = []
        self._tpl_lib_cands = cands
        self.tpl_lib_combo["values"] = cands
        self.tpl_lib_combo.set(str(td) if td else "")

    def _apply_tpl_lib(self, path: str):
        """设置模板库（空串 = 恢复默认：知识库自带 → 上级共用）。"""
        r = core.set_templates_dir(self.cfg, path, save=True)
        if not r.get("ok"):
            for line in (r.get("report") or ["模板库设置失败"]):
                self.log(self._default_log(), "✗ " + str(line), "err")
            self.set_status("模板库设置失败（详情见日志）", err=True)
            return
        self.refresh_template_tree()                     # 回显、模板清单、模板指向表一起刷新
        self.set_status(f"模板库：{r.get('path') or '（已恢复默认：自动向上查找）'}"
                        f"（{r.get('count') or 0} 个模板）")

