    def set_status(self, msg: str, err: bool = False):
        self.status_var.set(("⚠ " if err else "") + msg)

    def log(self, text_widget: tk.Text, msg: str, tag: str = "info"):
        """写日志，并自动滚动到底部（新内容永远可见）。"""
        text_widget.configure(state="normal")
        text_widget.insert("end", msg + "\n", (tag,))
        self._scroll_to_end(text_widget)
        text_widget.configure(state="disabled")

    @staticmethod
    def _scroll_to_end(text_widget: tk.Text):
        """see("end") 在控件尚未完成布局时可能停在倒数第二行，这里再钉一次底部。"""
        try:
            text_widget.see("end")
            text_widget.yview_moveto(1.0)
        except Exception:
            pass

    def logi(self, w, msg, tag="info"):
        """旧名兼容。"""
        self.log(w, msg, tag)

    def clear_log(self, text_widget: tk.Text, silent: bool = False):
        text_widget.configure(state="normal")
        text_widget.delete("1.0", "end")
        text_widget.configure(state="disabled")
        if not silent:
            self.set_status("日志区已清空")

    def copy_log(self, text_widget: tk.Text):
        try:
            text = text_widget.get("1.0", "end-1c")
        except Exception:
            text = ""
        try:
            self.root.clipboard_clear()
            self.root.clipboard_append(text)
        except Exception as e:  # noqa: BLE001
            self.set_status(f"复制失败：{type(e).__name__}: {e}", err=True)
            return
        self.set_status(f"已复制日志到剪贴板（{len(text)} 字符）")

    def _default_log(self) -> tk.Text:
        for name in ("work_log", "index_log", "man_log"):
            w = getattr(self, name, None)
            if isinstance(w, tk.Text):
                return w
        return self.work_log

    def _set_enabled(self, widgets, enabled: bool):
        for w in widgets or ():
            if w is None:
                continue
            try:
                w.configure(state=("normal" if enabled else "disabled"))
            except Exception:
                pass

    def run_task(self, fn, on_done, desc: str = "任务", busy=()):
        """后台线程执行 fn，完成后**由主线程**回调 on_done(result)。

        线程安全要点：worker 线程**只把结果放进队列**，绝不碰 Tk——
        子线程里调 `root.after` 可能抛 `main thread is not in main loop`，
        一旦抛错结果就永远回不来、界面会一直停在"运行中…"。
        主线程的 `_poll_tasks`（50ms 一次）取走结果并回调。
        busy 里传入触发本次任务的控件：运行期间禁用，结束后一律恢复。
        """
        widgets = [w for w in (busy or ()) if w is not None]
        self._busy = True
        self._set_enabled(widgets, False)
        self._refresh_steps()
        self.set_status(f"{desc}运行中…")

        job = {"on_done": on_done, "widgets": widgets, "result": None}

        def worker():
            r = ("ERROR", "任务异常结束（worker 没有返回结果）")
            try:
                r = fn()
            except Exception as e:  # noqa: BLE001 —— 后台异常也要带回主线程显示
                r = ("ERROR", f"{type(e).__name__}: {e}")
            finally:
                job["result"] = r
                self._task_queue.put(job)         # 只碰队列，不碰 Tk
        threading.Thread(target=worker, daemon=True).start()

    def _poll_tasks(self):
        """主线程轮询：取走后台任务结果并回调（队列空则等下一次）。"""
        while True:
            try:
                job = self._task_queue.get_nowait()
            except queue.Empty:
                break
            self._finish_task(job)
        try:
            self.root.after(50, self._poll_tasks)
        except Exception:                          # 窗口已销毁：停止轮询
            pass

    def _finish_task(self, job: dict):
        """在主线程里收尾：恢复控件 → 回调。"""
        self._busy = False
        self._set_enabled(job.get("widgets"), True)
        try:
            self._refresh_steps()
        except Exception:
            pass
        on_done = job.get("on_done")
        if on_done is None:
            return
        try:
            on_done(job.get("result"))
        except Exception as e:  # noqa: BLE001 —— 界面回调出错也不能炸掉主循环
            self.log(self._default_log(), f"✗ 界面回调异常：{type(e).__name__}: {e}", "err")
            self.set_status(f"界面回调异常：{type(e).__name__}: {e}", err=True)

    def _on_result(self, log_widget: tk.Text, r, err_prefix: str = ""):
        """通用结果处理：ERROR 写进日志区（详情可复制），返回 None 表示失败。"""
        if isinstance(r, tuple) and r and r[0] == "ERROR":
            detail = f"{err_prefix}{r[1]}"
            self.log(log_widget, f"✗ 失败：{detail}", "err")
            self.log(log_widget, "   （上方文字可直接选中复制；修好后重试刚才那一步即可）", "info")
            self.set_status(f"失败：{detail[:120]}（详情见日志区，可复制）", err=True)
            return None
        return r

    def _persist(self, msg: str) -> bool:
        """立即把 cfg 写盘，并在状态栏报「已保存」。"""
        try:
            core.save_config(self.cfg)
        except Exception as e:  # noqa: BLE001
            self.set_status(f"保存失败：{type(e).__name__}: {e}", err=True)
            return False
        self.set_status(f"已保存 · {msg}")
        return True

    @staticmethod
    def _open_dir(path) -> bool:
        """在文件管理器里打开目录；跨平台失败静默（不弹窗）。"""
        if not path:
            return False
        try:
            if hasattr(os, "startfile"):
                os.startfile(str(path))          # noqa: S606 —— Windows
            elif sys.platform == "darwin":
                subprocess.Popen(["open", str(path)])
            else:
                subprocess.Popen(["xdg-open", str(path)])
            return True
        except Exception:
            return False

