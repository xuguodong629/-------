    def _on_audit_types_done(self, r):
        """体检结果 → 预览弹窗（**不写任何文件**；点「写入」才写）。"""
        r = self._on_result(self._default_log(), r, "类型判定体检失败：")
        if r is None:
            return
        if r.get("note"):
            self.set_status("类型判定体检：" + str(r["note"]), err=True)
            return
        wrong = r.get("wrong") or []
        acc = float(r.get("accuracy") or 0) * 100
        kbname = Path(str(r.get("kb") or "")).name or "（未知库）"
        win = tk.Toplevel(self.root)
        win.title("🩺 类型判定体检（预览）")
        win.transient(self.root)
        win.grab_set()
        try:
            win.geometry("880x600")
        except Exception:
            pass
        ttk.Label(win, foreground="#333", justify="left",
                  text=(f"知识库：{kbname}｜准确率 {acc:.1f}%"
                        f"（对 {r.get('correct', 0)} / 错 {len(wrong)}，共 {r.get('total', 0)} 篇"
                        + (f"；其中判不出 {r.get('blank', 0)} 篇" if r.get("blank") else "") + "）\n"
                        "「判错」= 判定器给出的类型与笔记**所在目录**不一致：可能是判定器该补关键词，"
                        "也可能是这篇笔记放错了目录（两种都在下面列出）。\n"
                        "现在还没有写入任何文件 —— 点下面「写入当前库档案」才会写（只增不减）。")
                  ).pack(anchor="w", padx=10, pady=(8, 4))
        txt = tk.Text(win, wrap="none", height=20, font=("Consolas", 10))
        vsb = ttk.Scrollbar(win, orient="vertical", command=txt.yview)
        txt.configure(yscrollcommand=vsb.set)
        txt.pack(side="left", fill="both", expand=True, padx=(10, 0), pady=6)
        vsb.pack(side="right", fill="y", pady=6)
        lines = [f"· {w['name']}  应在「{w['expected']}」→ 实判「{w['guessed'] or '（判不出）'}」"
                 for w in wrong[:40]]
        if len(wrong) > 40:
            lines.append(f"…（其余 {len(wrong) - 40} 条略）")
        lines.append("")
        sg = r.get("suggest") or {}
        if sg:
            lines.append("—— 建议写入的关键词（只增不减；写入后判定会跟着变准）——")
            for t, spec in sg.items():
                if isinstance(spec, dict):
                    if spec.get("strong"):
                        lines.append(f"[{t}] 强匹配：{'、'.join(spec['strong'])}")
                    if spec.get("fallback"):
                        lines.append(f"[{t}] 兜底：{'、'.join(spec['fallback'])}")
                else:
                    lines.append(f"[{t}] {'、'.join(spec)}")
        else:
            lines.append("（没有可归纳的建议关键词：错判太少或前缀会与其他类型冲突，宁少不误吞 ✓）")
        txt.insert("1.0", "\n".join(lines))
        txt.configure(state="disabled")

        bar = ttk.Frame(win)
        bar.pack(fill="x", padx=10, pady=(0, 10))

        def on_write():
            res = core.apply_type_keywords(self.cfg, kb=core.resolve_kb(self.cfg),
                                           suggest=r.get("suggest") or {})
            log = self._default_log()
            for line in (res.get("report") or []):
                self.log(log, ("✓ " if res.get("ok") else "✗ ") + str(line),
                         "ok" if res.get("ok") else "err")
            for ch in (res.get("changes") or [])[:20]:
                self.log(log, f'   + [{ch["type"]}] {ch["word"]}', "info")
            if res.get("ok"):
                self.set_status(f'体检建议已写入 {len(res.get("changes") or [])} 个关键词到「{kbname}」档案')
                self.refresh_map_rows()
                try:
                    win.destroy()
                except Exception:
                    pass
            else:
                self.set_status("写入失败：" + "；".join(res.get("report") or []), err=True)

        btn = ttk.Button(bar, text="💾 写入当前库档案（只增不减）", command=on_write)
        btn.pack(side="left")
        if not sg:
            btn.configure(state="disabled")
        ttk.Button(bar, text="取消（什么都不写）", command=lambda: win.destroy()).pack(side="left", padx=6)
        ttk.Label(bar, foreground="#666",
                  text="写入前会自动备份 config.json 到 _旧程序文件\\").pack(side="left", padx=8)
        self.set_status(f"类型判定体检：准确率 {acc:.1f}%，判错 {len(wrong)} 篇"
                        + (f"，可新增 {sum(len(v.get('strong', [])) + len(v.get('fallback', [])) for v in sg.values() if isinstance(v, dict))} 个关键词" if sg else "")
                        + "（预览中，尚未写入）")

    def do_ensure_dirs(self):
        """按②页映射，在**当前知识库**（①页所选目录）里创建/检查每个类型的目录。"""
        kb = core.resolve_kb(self.cfg)
        if kb is None:
            self.set_status("请先在①页选择知识库目录", err=True)
            return
        r = core.ensure_route_dirs(self.cfg, create=True,
                                   extra=("00 首页", "Templates（模板）", "Assets（图片地图）",
                                          "Attachments（PDF）"))
        log = self._default_log()
        for line in (r.get("report") or []):
            self.log(log, "· " + str(line), "info")
        if r.get("created"):
            self.log(log, "✓ 已创建：" + "、".join(r["created"]), "ok")
        if r.get("failed"):
            self.log(log, "✗ 失败：" + "、".join(r["failed"]), "err")
            self.set_status(f"有 {len(r['failed'])} 个目录建失败（详情见日志）", err=True)
        else:
            self.set_status(f"目录检查完成：新建 {len(r.get('created') or [])} 个、"
                            f"已存在 {len(r.get('existing') or [])} 个（{kb.name}）")
        self.refresh_map_rows()

    def open_route_suggest(self):
        """按**当前知识库**的目录名猜一套映射，弹窗里预览/改完再一键应用（换知识库后重排用）。"""
        kb = core.resolve_kb(self.cfg)
        if kb is None:
            self.set_status("请先设置知识库目录（①页）", err=True)
            return None
        try:
            sug = core.suggest_routes_for_kb(self.cfg) or {}
        except Exception as exc:  # noqa: BLE001
            self.set_status(f"重排映射失败：{type(exc).__name__}: {exc}", err=True)
            return None
        dirs = [r["name"] for r in (core.scan_kb(kb) or [])]
        routes = self.cfg.get("routes") or {}
        types = sorted(routes.keys())

        win = tk.Toplevel(self.root)
        win.title("🔁 按当前知识库重排映射")
        try:
            win.transient(self.root)
            win.grab_set()
        except Exception:
            pass
        holder = ttk.Frame(win, padding=10)
        holder.pack(fill="both", expand=True)
        ttk.Label(holder, justify="left", foreground="#444",
                  text=("以下是按当前知识库目录名猜出的映射，可以直接改（下拉里是该库实际目录）；"
                        "留空的表示没猜出来，请手动选或留空跳过。\n"
                        f"当前知识库：{kb}")).pack(anchor="w")

        fit = ttk.Frame(holder)
        fit.pack(fill="both", expand=True, pady=6)
        tree = ttk.Treeview(fit, columns=("type", "old", "new"), show="headings", height=12)
        for c, txt, w in (("type", "类型", 120), ("old", "当前目录（可能已失效）", 300),
                          ("new", "建议目录（双击可改）", 320)):
            tree.heading(c, text=txt)
            tree.column(c, width=w, anchor="w")
        tree.pack(side="left", fill="both", expand=True)
        sb = ttk.Scrollbar(fit, orient="vertical", command=tree.yview)
        sb.pack(side="right", fill="y")
        tree.configure(yscrollcommand=sb.set)

        state: dict = {"values": {}}
        for t in types:
            old = str(routes.get(t) or "")
            new = str(sug.get(t) or "")
            state["values"][t] = new
            tree.insert("", "end", iid=t, values=(t, old, new or "（留空跳过）"))

        def edit_cell(event):
            if tree.identify_region(event.x, event.y) != "cell":
                return
            if tree.identify_column(event.x) != "#3":
                return
            row = tree.identify_row(event.y)
            if not row:
                return
            bbox = tree.bbox(row, "#3")
            if not bbox or not bbox[2]:
                return
            x, y, w, h = bbox
            ed = ttk.Combobox(tree, values=dirs, state="normal")
            ed.set(state["values"].get(row, ""))
            ed.place(x=x, y=y, width=w, height=h)
            ed.focus_set()
            done = {"closed": False}

            def commit(_e=None):
                if done["closed"]:
                    return
                done["closed"] = True
                val = ed.get().strip()
                try:
                    ed.destroy()
                except Exception:
                    pass
                if val == "（留空跳过）":
                    val = ""
                state["values"][row] = val
                tree.item(row, values=(row, tree.item(row, "values")[1], val or "（留空跳过）"))
            def cancel(_e=None):
                if done["closed"]:
                    return
                done["closed"] = True
                try:
                    ed.destroy()
                except Exception:
                    pass
            ed.bind("<<ComboboxSelected>>", commit)
            ed.bind("<Return>", commit)
            ed.bind("<FocusOut>", commit)
            ed.bind("<Escape>", cancel)
        tree.bind("<Double-Button-1>", edit_cell)

        n_ready = sum(1 for v in state["values"].values() if str(v).strip())
        bar = ttk.Frame(holder)
        bar.pack(fill="x")
        ttk.Label(bar, foreground="#666",
                  text=f"猜出 {n_ready} / {len(types)} 项（留空的会跳过，不改动原映射）").pack(side="left")

        def do_apply():
            mapping = {t: v for t, v in state["values"].items() if str(v).strip()}
            if not mapping:
                self.set_status("没有可应用的映射（建议目录都是空的）", err=True)
                return
            changed = core.apply_routes(self.cfg, mapping, save=True)
            try:
                win.grab_release()
            except Exception:
                pass
            win.destroy()
            self.refresh_map_rows()
            self.refresh_work_types()
            self._refresh_steps()
            log = self._default_log()
            if changed:
                for t, desc in list(changed.items())[:20]:
                    self.log(log, f"✓ {t}：{desc}", "ok")
                if len(changed) > 20:
                    self.log(log, f"   （其余 {len(changed) - 20} 项略）", "info")
                self.set_status(f"已按当前知识库重排映射：改动 {len(changed)} 项（②页已刷新）")
            else:
                self.set_status("映射没有变化（建议与实际一致）")

        ttk.Button(bar, text="✅ 应用并保存", command=do_apply).pack(side="right", padx=4)
        ttk.Button(bar, text="取消",
                   command=lambda: (win.grab_release() if win.winfo_exists() else None,
                                    win.destroy())).pack(side="right", padx=4)
        win.update_idletasks()
        w = min(920, max(720, win.winfo_reqwidth()))
        h = min(600, max(420, win.winfo_reqheight()))
        try:
            x = self.root.winfo_rootx() + max(0, (self.root.winfo_width() - w) // 2)
            y = self.root.winfo_rooty() + max(0, (self.root.winfo_height() - h) // 3)
            win.geometry(f"{w}x{h}+{x}+{y}")
        except Exception:
            pass
        win.lift()
        win.focus_set()
        win._route_state = state          # 便于自动化测试/排查
        win._route_apply = do_apply
        win._route_tree = tree
        return win

