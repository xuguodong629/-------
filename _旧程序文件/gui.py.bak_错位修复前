    # ---------------- 步骤机 ----------------

    def _reset_steps(self, *keys):
        for k in (keys or tuple(self.step_done.keys())):
            if k in self.step_done:
                self.step_done[k] = False
        self._refresh_steps()

    def _manual_ready(self) -> bool:
        """离线手动模式：类型 + 标题都自己填好了，等价于完成了“分析”这一步。"""
        return bool(self.result_type_var.get().strip() and self.title_var.get().strip())

    def _steps_availability(self) -> dict:
        """新增词条为主线：填了关键词（或手动填好类型+标题）就能直接分析；检索不再是前置条件。"""
        done = self.step_done
        manual = self._manual_ready()
        has_kw = bool(self.topic_var.get().strip())
        return {
            "analyze": has_kw or manual,
            "preview": done["analyze"] or manual,
            "write": done["preview"],
            "backlinks": done["write"],
        }

    def _refresh_steps(self):
        if not getattr(self, "_step_buttons", None):
            return
        done = self.step_done
        avail = self._steps_availability()
        manual = self._manual_ready() and not done["analyze"]
        current = ""
        for k, _ in STEP_DEFS:
            if avail.get(k) and not done.get(k):
                current = k
                break
        for k, label in STEP_DEFS:
            btn = self._step_buttons.get(k)
            if btn is None:
                continue
            if done.get(k):
                text, bg, fg = f"✔ {label}", "#e6f4ea", "#0a7d32"
            elif k == current:
                text, bg, fg = f"▶ {label}", "#e8f0fe", "#0b3d91"
            else:
                text, bg, fg = f"○ {label}", "#f2f2f2", "#999999"
            if k == "analyze" and manual:
                text, bg, fg = f"▶ {label}（手动）", "#fff7e6", "#8a5a00"
            try:
                btn.configure(text=text, bg=bg, fg=fg, activebackground=bg,
                              disabledforeground="#b5b5b5",
                              state=("normal" if (avail.get(k) and not self._busy) else "disabled"))
            except Exception:
                pass
        if current:
            self.step_hint_var.set(STEP_HINTS.get(current, ""))
        elif all(done.get(k) for k, _ in STEP_DEFS):
            self.step_hint_var.set("✔ 主线四步全部完成。改动关键词/类型/标题后，相关步骤会自动回到待办。")
        else:
            self.step_hint_var.set(MANUAL_HINT)
        if hasattr(self, "btn_run_all"):
            self.btn_run_all.configure(state=("disabled" if self._busy else "normal"))
        if hasattr(self, "btn_manual"):
            self.btn_manual.configure(state=("disabled" if self._busy else "normal"))
        if hasattr(self, "btn_open_dir"):
            self.btn_open_dir.configure(
                state=("normal" if (self._last_write_path and not self._busy) else "disabled"))
        # 配图按钮同样受忙碌状态约束（联网取图期间不允许重复点）
        for name in ("btn_image", "btn_man_image"):
            w = getattr(self, name, None)
            if w is not None:
                try:
                    w.configure(state=("disabled" if self._busy else "normal"))
                except Exception:
                    pass
        # 可选辅助按钮：检索（不参与打勾）与「打开该词条」
        btn_search = getattr(self, "btn_search", None)
        if btn_search is not None:
            try:
                btn_search.configure(state=("disabled" if self._busy else "normal"))
            except Exception:
                pass
        btn_open_note = getattr(self, "btn_open_note", None)
        if btn_open_note is not None:
            try:
                btn_open_note.configure(
                    state=("normal" if (self._same_title_hit and not self._busy) else "disabled"))
            except Exception:
                pass

    def _bind_state_traces(self):
        """手改类型/标题/摘要后，预览与写入需要重来（避免写进过期内容）。"""
        for var in (self.result_type_var, self.title_var, self.summary_var):
            try:
                var.trace_add("write", self._invalidate_preview)
            except Exception:
                pass
        try:
            # 关键词变化 → 防抖自动检索（可选步骤：查重 + 给 AI 备料，不阻塞任何操作）
            self.topic_var.trace_add("write", self._schedule_auto_search)
        except Exception:
            pass

    def _invalidate_preview(self, *_a):
        if self._suppress_invalidate:
            return
        if self._images:                      # 类型/标题变了，已配的图可能张冠李戴
            self._images = []
            self._set_img_state(getattr(self, "img_state_var", None), "配图：未选（标题/类型已改，请重新配图）")
        if self.step_done.get("preview") or self.step_done.get("write") or self.step_done.get("backlinks"):
            self.step_done["preview"] = False
            self.step_done["write"] = False
            self.step_done["backlinks"] = False
        self._refresh_steps()

    # ---------------- 自动检索（可选，防抖）----------------

    def _schedule_auto_search(self, *_a):
        """关键词一变就重排防抖计时：不阻塞输入、不弹窗、不写状态栏。"""
        kw = self.topic_var.get().strip()
        if self._search_job is not None:
            try:
                self.root.after_cancel(self._search_job)
            except Exception:
                pass
            self._search_job = None
        self._reset_steps("analyze", "preview", "write", "backlinks")   # 关键词变了，下游作废
        self._same_title_hit = None
        self._set_enabled([getattr(self, "btn_open_note", None)], False)
        if len(kw) >= 2:
            self._search_job = self.root.after(AUTO_SEARCH_DELAY_MS, self._auto_search)

    def _auto_search(self):
        """后台（主线程 after）跑一次离线检索；失败只记一行日志，绝不打断用户。"""
        self._search_job = None
        kw = self.topic_var.get().strip()
        if len(kw) < 2 or self._busy:
            return
        try:
            hits = core.find_notes(self.cfg, kw)
        except Exception as e:  # noqa: BLE001 —— 自动检索失败不影响任何操作
            self.log(self.work_log, f"ℹ 自动检索没跑成（不影响继续用）：{type(e).__name__}: {e}", "info")
            return
        self._apply_hits(hits, auto=True)

    @staticmethod
    def _same_title_hit_for(hits: list, kw: str):
        """结果里是否有与关键词同名的词条（`kw` 或 `YYYY年-kw`）。"""
        kw = (kw or "").strip()
        if not kw:
            return None
        for h in hits or ():
            t = str(h.get("title") or "").strip()
            if t and t in (kw, f"{kw}年-{kw}"):
                return h
        return None

    def _apply_hits(self, hits: list, auto: bool = False, quiet: bool = False):
        """把结果填进列表，并按「有没有同名词条」给出提示（决定写入是新建还是增量更新）。"""
        kw = self.topic_var.get().strip()
        self.hits = list(hits or ())
        self._hits_kw = kw
        self.hit_list.delete(0, "end")
        for h in self.hits:
            self.hit_list.insert("end", self._hit_label(h))
        same = self._same_title_hit_for(self.hits, kw)
        self._same_title_hit = same
        self._set_enabled([getattr(self, "btn_open_note", None)], bool(same))
        if quiet:
            return
        count = len(self.hits)
        key = (count, bool(same))
        if auto and key == self._last_hit_key:
            return                                      # 条数与“有无同名”都没变就不刷屏
        self._last_hit_key = key
        if same:
            self.log(self.work_log,
                     f"⚠ 知识库中已存在同名词条「{kw}」——写入将做增量更新（只填空、不覆盖已有内容）；"
                     "如果你想另建一条，请改标题（可点「打开该词条」先看看现有内容）。", "err")
        elif count:
            self.log(self.work_log, f"ℹ 知识库中没有「{kw}」这个词条——将新建。", "info")
            self.log(self.work_log,
                     f"ℹ 命中 {count} 条相关词条（可双击看片段，会作为 AI 分析的参考上下文）。", "info")
        else:
            self.log(self.work_log,
                     f"ℹ 知识库中没有「{kw}」这个词条，也没有相关条目——将按新词条完整生成。", "info")

    def _hits_for(self, kw: str) -> list:
        """当前关键词对应的命中：已有同关键词的缓存就复用，否则现查一次（离线、很快）。"""
        if self._hits_kw == kw and self.hits:
            return self.hits
        try:
            hits = core.find_notes(self.cfg, kw)
        except Exception:
            return list(self.hits or ())
        self._apply_hits(hits, auto=True)               # 顺手刷新列表与同名词条提示
        return hits

    def _exists_for(self, kw: str) -> bool:
        """知识库里是否已有同名词条（决定 AI 是「新建」还是「只补空缺」）。"""
        return bool(self._same_title_hit_for(self._hits_for(kw), kw))

    def open_same_title_note(self):
        """打开与关键词同名的那个词条（.md），用系统默认程序。"""
        h = self._same_title_hit
        if not h:
            self.set_status("没有同名词条可打开", err=True)
            return
        path = str(h.get("path") or "")
        if path and self._open_dir(path):               # os.startfile 对文件同样有效
            self.set_status(f"已打开词条：{path}")
        else:
            self.set_status(f"打开失败（可手动复制路径：{path}）", err=True)

    def _on_topic_enter(self, _e=None):
        """回车 = 走主线：一键分析并预览（检索已降级为可选/自动）。"""
        self.do_run_all()
        return "break"

    def enable_manual_mode(self):
        """离线手动模式：预填类型并提示填标题，之后可直接预览/写入。"""
        t = self.result_type_var.get().strip()
        if not t:
            types = sorted((self.cfg.get("routes") or {}).keys())
            if types:
                self.result_type_var.set(types[0])
                t = types[0]
        if not self.title_var.get().strip():
            self.set_status("手动模式：请在「标题」里填写笔记标题（类型已就绪），然后点「2. 预览笔记」", err=True)
            self._refresh_steps()
            return
        self.set_status(f"手动模式已就绪：类型「{t}」+ 标题「{self.title_var.get().strip()}」，可直接「2. 预览笔记」")
        self._refresh_steps()

    # ---------------- 词条配图 ----------------

    def _current_aliases(self) -> list:
        """当前词条可用于配图匹配的别名：AI 的 aliases / frontmatter.别名 + 标题。"""
        ai = self.ai or {}
        fm = ai.get("frontmatter") if isinstance(ai.get("frontmatter"), dict) else {}
        cands: list = []
        for src in (ai.get("aliases"), fm.get("aliases"), fm.get("别名"), fm.get("别称"),
                    self.title_var.get()):
            if isinstance(src, list):
                cands.extend(str(x).strip() for x in src)
            elif src:
                cands.append(str(src).strip())
        seen, uniq = set(), []
        for a in cands:
            if a and a not in seen:
                seen.add(a)
                uniq.append(a)
        return uniq

    def _auto_images(self) -> bool:
        """③ 页「写入时自动带本地配图」勾选值（默认勾选）。"""
        try:
            return bool(self.auto_img_var.get())
        except Exception:
            return True

    def _man_auto_images(self) -> bool:
        """⑥ 页同名勾选值。"""
        try:
            return bool(self.man_auto_img_var.get())
        except Exception:
            return True

    @staticmethod
    def _img_entry(r: dict) -> dict:
        """把 acquire_image 的结果收敛成写进笔记用的 entry。"""
        return {k: r.get(k) for k in ("ok", "file", "path", "source", "credit", "page")
                if r.get(k) is not None}

    def _set_img_state(self, var, msg: str):
        try:
            var.set(msg)
        except Exception:
            pass

    def do_acquire_image(self):
        """③ 页配图：本地图库优先，其次中文维基百科（联网只在点这个按钮时发生）。"""
        title = core.sanitize_title(self.title_var.get().strip())
        if not title:
            self.set_status("请先填「标题」（可先检索 + AI 分析得到），再点「🖼 配图」", err=True)
            try:
                self.topic_entry.focus_set()
            except Exception:
                pass
            return
        aliases = self._current_aliases()
        self.log(self.work_log, f"▶ 配图：查找「{title}」的图片（本地图库 → 中文维基百科）…", "head")

        def work():
            return core.acquire_image(self.cfg, title, aliases=aliases, allow_network=True)

        self.run_task(work, self._on_acquire_image_done, "配图",
                      busy=(getattr(self, "btn_image", None), self.btn_run_all))

    def _on_acquire_image_done(self, r):
        if isinstance(r, tuple) and r and r[0] == "ERROR":
            self.log(self.work_log, f"✗ 配图失败：{r[1]}", "err")
            self.set_status(f"配图失败：{r[1]}（详情见日志区）", err=True)
            return
        if not isinstance(r, dict):
            self.log(self.work_log, "✗ 配图失败：返回结果异常", "err")
            self.set_status("配图失败：返回结果异常（详情见日志区）", err=True)
            return
        if not r.get("ok"):
            note = str(r.get("note") or "未取得图片")
            self.log(self.work_log, f"✗ 配图未成功：{note}", "err")
            self.log(self.work_log, "   → 可手动把图片放进 Assets（图片地图）后重试；标题越规范越容易匹配。", "info")
            self.set_status(f"配图未成功：{note}", err=True)
            return
        entry = self._img_entry(r)
        self._images = [entry]
        source = str(r.get("source") or "")
        credit = str(r.get("credit") or "")
        self.log(self.work_log,
                 f"✓ 配图：{entry.get('file')}（来源：{source or '未知'}{('／' + credit) if credit else ''}）", "ok")
        self.log(self.work_log,
                 f"   路径：{entry.get('path')}（预览/笔记里写 ![[{entry.get('file')}]]）", "info")
        self._set_img_state(getattr(self, "img_state_var", None),
                            f"配图：{entry.get('file')}（{source or '未知'}）")
        self.set_status(f"配图完成：{entry.get('path')}")
        if self.step_done.get("preview"):     # 已预览过 → 带新图刷新预览
            self.do_preview()

    def open_hit_image(self):
        """打开最近展开的检索命中项的配图（系统默认看图程序；失败静默）。"""
        path = self._last_hit_image
        if not path:
            self.set_status("还没有选中带配图的命中项：在左侧双击一条带 🖼 的记录", err=True)
            return
        if self._open_dir(path):
            self.set_status(f"已打开图片：{path}")
        else:
            self.set_status(f"打开图片失败（可手动复制路径：{path}）", err=True)

    # ---------------- 工作台操作 ----------------

    def do_search(self):
        """可选的辅助动作：查重 / 给 AI 备料。不参与步骤解锁与打勾。"""
        kw = self.topic_var.get().strip()
        if not kw:
            self.set_status("请先填写词条 / 关键词", err=True)
            self.topic_entry.focus_set()
            return

        def work():
            return core.find_notes(self.cfg, kw)

        self.run_task(work, self._on_search_done, f"检索「{kw}」",
                      busy=(getattr(self, "btn_search", None), self.btn_run_all))

    def _hit_label(self, h: dict) -> str:
        """命中项在列表里的一行：带配图时显示数量或第一张文件名。"""
        imgs = h.get("images") or []
        base = f"[{h.get('score')}] {h.get('title')}"
        if not imgs:
            return base
        first = str(imgs[0].get("file") or "")
        tag = f"🖼 {first}" if len(imgs) == 1 else f"🖼×{len(imgs)} {first}".strip()
        return f"{base}  {tag}"

    def _on_search_done(self, r):
        r = self._on_result(self.work_log, r)
        if r is None:
            return
        self._apply_hits(r, auto=False)                  # 填列表 + 同名/新建提示
        with_img = sum(1 for h in r if h.get("images"))
        self.log(self.work_log,
                 f"✓ 检索完成（可选步骤）：命中 {len(r)} 条（其中 {with_img} 条已有配图；双击列表项看片段）", "ok")
        self.set_status(f"检索完成（可选）：命中 {len(r)} 条（带配图 {with_img} 条）。{STEP_HINTS['analyze']}")

    def _on_hit_double(self, _e):
        sel = self.hit_list.curselection()
        if not sel:
            return
        h = self.hits[sel[0]]
        self.log(self.work_log, f"── 片段：「{h['title']}」\n    {h['snippet'] or '(标题命中，无正文片段)'}\n    {h['path']}", "info")
        imgs = h.get("images") or []
        if imgs:
            for e in imgs:
                self.log(self.work_log, f"   🖼 {e.get('file')} → {e.get('path')}", "info")
            self._last_hit_image = str(imgs[0].get("path") or "")
            self._set_enabled([getattr(self, "btn_open_image", None)], bool(self._last_hit_image))
            self.set_status(f"已展开片段 + {len(imgs)} 张配图：{h['title']}（可点「打开图片」查看）")
        else:
            self._last_hit_image = ""
            self._set_enabled([getattr(self, "btn_open_image", None)], False)
            self.set_status(f"已展开片段：{h['title']}（该词条暂无配图）")

    def do_analyze(self):
        kw = self.topic_var.get().strip()
        if not self._steps_availability()["analyze"]:
            self.set_status("请先填写「词条 / 关键词」；或点「手动模式」自己填类型 + 标题", err=True)
            self.topic_entry.focus_set()
            return
        hint = self.work_type_var.get()
        hint = "" if hint == "（由 AI 判定）" else hint
        client = AIClient(**self._ai_params())
        ok, why = client.ready()
        if not ok:
            self.set_status("AI 未配置：可点「手动模式」自己填类型/标题/摘要，或填好 Key 再试", err=True)
            self.log(self.work_log, f"✗ AI 未就绪：{why}", "err")
            self.log(self.work_log, "   → 离线可用：点「手动模式」，或切到「⑥ 手动生成笔记」。", "info")
            return
        hits = self._hits_for(kw)                        # 检索是可选的：没检索过就现查一次（离线、快）
        exists = self._same_title_hit_for(hits, kw) is not None
        self.log(self.work_log,
                 ("⚠ 知识库中已有同名词条：本次按「增量更新」处理（只填空、不覆盖已有内容）。" if exists
                  else "ℹ 知识库中没有同名词条：本次按「新建词条」处理。"), "info")
        prompt = core.build_analysis_prompt(self.cfg, kw, hint, hits[:12], exists=exists)

        def work():
            return core.ai_analyze(client, prompt, self.cfg)

        self.run_task(work, self._on_analyze_done, "AI 分析与抽取",
                      busy=(self._step_buttons.get("analyze"), self.btn_run_all))

    def _apply_ai_result(self, data: dict, quiet: bool = False):
        """把 AI 结果回填到界面（类型/标题/摘要 + 字段），并标记分析完成。"""
        self.ai = data
        type_ = str(data.get("type") or "").strip()
        title = core.sanitize_title(str(data.get("title") or ""))
        summary = str(data.get("summary") or "").strip()
        self._suppress_invalidate = True
        try:
            self.result_type_var.set(type_)
            self.title_var.set(title)
            self.summary_var.set(summary)
        finally:
            self._suppress_invalidate = False
        if not quiet:
            self.log(self.work_log, f"✓ AI 判定类型：{type_}｜标题：{title}", "ok")
            self.log(self.work_log, f"  摘要：{summary or '（空）'}", "info")
            fm = data.get("frontmatter") or {}
            lk = data.get("related") or []
            self.log(self.work_log, f"  frontmatter 字段：{'; '.join(f'{k}={v}' for k, v in list(fm.items())[:8]) or '（空）'}", "info")
            self.log(self.work_log, f"  related 双链目标：{'、'.join(map(str, lk[:12])) or '（空）'}", "info")
        self.step_done["analyze"] = True
        self._refresh_steps()
        self.set_status(f"AI 分析完成：类型「{type_}」｜标题「{title}」。{STEP_HINTS['preview']}")
        return type_, title

    def _on_analyze_done(self, r):
        r = self._on_result(self.work_log, r)
        if r is None or not isinstance(r, dict):
            return
        self._apply_ai_result(r)
        self.log(self.work_log, "  下一步：点「2. 预览笔记」查看成型稿（未预览不会写入）", "head")

    def _current_ai_terms(self) -> tuple:
        """从当前界面/AI 缓存合成 (类型, ai_fields, ai_sections)。未走 AI 时为手动模式。"""
        from collections import OrderedDict
        type_ = self.result_type_var.get().strip()
        ai_fields = dict(self.ai.get("frontmatter") or {}) if self.ai else {}
        era = self.ai.get("era") or ""
        imp = self.ai.get("importance") or ""
        if era:
            ai_fields.setdefault("时期", str(era))
        if imp:
            ai_fields.setdefault("重要性", str(imp))
        content = self.ai.get("content") if self.ai else None
        ai_sections = core.sections_from_ai(content) if content else OrderedDict()
        return type_, ai_fields, ai_sections

    def do_preview(self):
        if not (self.step_done.get("analyze") or self._manual_ready()):
            self.set_status("请先「1. AI 分析与抽取」；或在下方填好类型+标题（手动模式）再预览", err=True)
            return
        type_ = self.result_type_var.get().strip()
        title = core.sanitize_title(self.title_var.get().strip())
        if not type_ or not title:
            self.set_status("请先完成 AI 分析，或在手动模式下填写类型与标题", err=True)
            return
        report: list = []
        try:
            _, ai_fields, ai_sections = self._current_ai_terms()
            text, note = core.build_note_text(self.cfg, type_, title, self.summary_var.get().strip(),
                                              ai_fields, ai_sections, report,
                                              images=self._images or None,
                                              auto_images=self._auto_images())
        except Exception as e:  # noqa: BLE001 —— 失败详情进日志区
            self.log(self.work_log, f"✗ 预览生成失败：{type(e).__name__}: {e}", "err")
            self.set_status(f"预览失败：{type(e).__name__}: {e}（详情见日志区）", err=True)
            return
        self._show_preview(text)
        for rep in report:
            if "配图" in rep:
                self.log(self.work_log, "   · " + rep, "info")
        self.step_done["preview"] = True
        self._refresh_steps()
        self.log(self.work_log, f"✓ 预览生成（模板：{note}）——仅预览，未写入", "ok")
        self.set_status(f"预览完成（模板：{note}）。{STEP_HINTS['write']}")

    def _show_preview(self, text: str):
        self.work_log.configure(state="normal")
        self.work_log.delete("1.0", "end")
        self.work_log.insert("end", "─── 笔记预览 ───\n", "head")
        self.work_log.insert("end", text)
        self._scroll_to_end(self.work_log)      # 自动滚动到底部
        self.work_log.configure(state="disabled")

    def do_write(self):
        if not self.step_done.get("preview"):
            self.set_status("请先「2. 预览笔记」确认内容，再写入（步骤未解锁）", err=True)
            return
        type_ = self.result_type_var.get().strip()
        title = core.sanitize_title(self.title_var.get().strip())
        if not type_ or not title:
            self.set_status("缺少类型/标题：请先 AI 分析，或手动填写", err=True)
            return
        summary = self.summary_var.get().strip()
        _, ai_fields, ai_sections = self._current_ai_terms()

        def work():
            return core.write_note(self.cfg, type_, title, summary, ai_fields, ai_sections, mode="auto",
                                   images=self._images or None,
                                   auto_images=self._auto_images())

        self.run_task(work, self._on_write_done, "写入知识库",
                      busy=(self._step_buttons.get("write"), self.btn_run_all))

    def _on_write_done(self, r):
        r = self._on_result(self.work_log, r)
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(r.get("report") or ["写入失败"])
            self.log(self.work_log, f"✗ 写入失败：{detail}", "err")
            self.log(self.work_log, "   → 可在「② 类型映射」检查该类型的目标目录是否存在；或点「执行测试目录」。", "info")
            self.set_status(f"写入失败：{detail}（详情见日志区）", err=True)
            return
        path = r.get("path") or ""
        self._last_write_path = path
        self._last_new_title = self.title_var.get().strip()
        self.step_done["write"] = True
        self._refresh_steps()
        self.log(self.work_log, f"✓ 已{r['action']}：{path}", "ok")
        for rep in r.get("report") or []:
            self.log(self.work_log, "   · " + rep, "info")
        self.log(self.work_log, f"  完整路径：{path}（点「打开所在文件夹」可直接定位）", "info")
        self.set_status(f"{r['action']}完成，完整路径：{path}")

    def open_last_dir(self):
        if not self._last_write_path:
            self.set_status("还没有写入记录：先「3. 写入知识库」", err=True)
            return
        folder = os.path.dirname(self._last_write_path)
        if self._open_dir(folder):
            self.set_status(f"已打开文件夹：{folder}")
        else:
            self.set_status(f"打开文件夹失败（可手动复制路径：{folder}）", err=True)

    def do_backlinks(self):
        if not self.step_done.get("write"):
            self.set_status("请先「3. 写入知识库」再补齐双链（步骤未解锁）", err=True)
            return
        title = self._last_new_title or self.title_var.get().strip()
        related = self.ai.get("related") or []
        if not title:
            self.set_status("无目标笔记：请先写入知识库", err=True)
            return
        if not related:
            self.set_status("AI 未提供 related 列表，跳过双链补齐", err=True)
            self.log(self.work_log, "✗ 无 related 列表：本次 AI 分析没有给出双链目标，可手动在笔记里补 [[…]]。", "err")
            return
        report: list = []

        def work():
            return core.apply_backlinks(self.cfg, core.sanitize_title(title), related, report)

        self.run_task(work, self._on_backlinks_done, "补齐双链",
                      busy=(self._step_buttons.get("backlinks"), self.btn_run_all))

    def _on_backlinks_done(self, r):
        r = self._on_result(self.work_log, r)
        if r is None:
            return
        if not r.get("ok"):
            self.log(self.work_log, "✗ 双链补齐失败：知识库未设置", "err")
            self.set_status("双链补齐失败：知识库未设置（详情见日志区）", err=True)
            return
        added = len(r.get("added") or [])
        skipped = len(r.get("skipped") or [])
        self.step_done["backlinks"] = True
        self._refresh_steps()
        self.log(self.work_log, f"✓ 反向链接：新增 {added} 处（已存在跳过：{skipped}）", "ok")
        for a in r.get("added") or []:
            self.log(self.work_log, "   + " + a, "info")
        self.set_status(f"双链补齐完成：新增 {added} 处，跳过 {skipped} 处")

    def do_run_all(self):
        """主按钮：先自动检索一次（离线、作参考）→ AI 分析 → 预览，每一步都写状态栏。"""
        if self._busy:
            self.set_status("上一步还在运行中，请稍候…", err=True)
            return
        kw = self.topic_var.get().strip()
        if not kw:
            self.set_status("请先填写词条 / 关键词（Ctrl+回车 也可一键分析并预览）", err=True)
            self.topic_entry.focus_set()
            return
        self._reset_steps("analyze", "preview", "write", "backlinks")
        self.log(self.work_log,
                 f"▶ 一键分析并预览：自动检索（可选，作参考）→ AI 分析 → 预览（词条：{kw}）", "head")
        self.set_status(f"一键分析并预览：正在准备「{kw}」…")

        hint = self.work_type_var.get()
        hint = "" if hint == "（由 AI 判定）" else hint
        client = AIClient(**self._ai_params())
        cached_hits = list(self.hits) if (self._hits_kw == kw and self.hits) else None

        def work():
            hits = cached_hits if cached_hits is not None else core.find_notes(self.cfg, kw)
            ok, why = client.ready()
            if not ok:
                return {"stage": "search_only", "hits": hits, "why": why, "exists": False}
            exists = self._same_title_hit_for(hits, kw) is not None
            prompt = core.build_analysis_prompt(self.cfg, kw, hint, hits[:12], exists=exists)
            try:
                data = core.ai_analyze(client, prompt, self.cfg)
            except AIError as e:
                return {"stage": "search_only", "hits": hits, "why": str(e), "exists": exists}
            return {"stage": "analyzed", "hits": hits, "data": data, "exists": exists}

        self.run_task(work, self._on_run_all_done, "一键分析并预览",
                      busy=(self.btn_run_all, self._step_buttons.get("analyze")))

    def _on_run_all_done(self, r):
        r = self._on_result(self.work_log, r)
        if r is None:
            return
        hits = r.get("hits") or []
        self._apply_hits(hits, auto=False, quiet=True)     # 填列表 + 决定「打开该词条」是否可用
        exists = bool(r.get("exists"))
        with_img = sum(1 for h in hits if h.get("images"))

        if r.get("stage") != "analyzed":
            why = r.get("why") or "AI 未就绪"
            self.log(self.work_log, f"· 参考检索（可选）：命中 {len(hits)} 条，带配图 {with_img} 条", "info")
            self.log(self.work_log, f"✗ AI 分析未执行：{why}", "err")
            self.log(self.work_log,
                     "   → 可点「手动模式」自己填类型/标题后预览；或填好 API Key 再点一次。", "info")
            self.set_status(f"参考检索完成，但 AI 分析未执行：{why}（可用手动模式继续）", err=True)
            return

        type_, title = self._apply_ai_result(r.get("data") or {})
        self.set_status(f"第 1 步完成：类型「{type_}」｜标题「{title}」。正在生成预览…")
        self.do_preview()          # 注意：预览会重写日志区，所以汇总信息放在预览之后写
        self.log(self.work_log,
                 f"✓ 一键分析并预览：第 1 步（AI 分析与抽取）完成：类型「{type_}」｜标题「{title}」", "ok")
        self.log(self.work_log,
                 ("⚠ 知识库中已有同名词条：按「增量更新」处理（只填空、不覆盖已有内容）。" if exists
                  else "ℹ 知识库中没有同名词条：按「新建词条」处理。"), "info")
        self.log(self.work_log, f"· 参考检索（可选）：命中 {len(hits)} 条，带配图 {with_img} 条", "info")
        self.log(self.work_log, "  下一步：点「3. 写入知识库」写盘（预览不会改动知识库）", "head")

