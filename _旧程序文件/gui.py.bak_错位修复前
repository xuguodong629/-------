    def refresh_manual_types(self):
        if not hasattr(self, "man_type_combo"):
            return
        auto = getattr(self, "MAN_AUTO_TYPE", "（自动识别）")
        vals = [auto] + sorted((self.cfg.get("routes") or {}).keys())
        self.man_type_combo["values"] = vals
        combo = getattr(self, "md_type_combo", None)     # 📄 md 批量建库 的类型下拉跟着 ② 页刷新
        var = getattr(self, "md_type_var", None)
        if combo is not None and var is not None:
            try:
                combo["values"] = vals
                if var.get() not in vals:
                    var.set(auto)
            except Exception:
                pass
        if self.man_type_var.get() not in vals:
            self._man_filling = True
            try:
                self.man_type_var.set(auto)
            finally:
                self._man_filling = False

