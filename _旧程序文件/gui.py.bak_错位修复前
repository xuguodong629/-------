    def _ui_state_path(self):
        return core.BASE_DIR / UI_STATE_NAME

    def _load_ui_state(self) -> dict:
        try:
            p = self._ui_state_path()
            if p.exists():
                data = json.loads(p.read_text(encoding="utf-8"))
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
        return {}

    def _apply_geometry(self):
        """默认尺寸按屏幕算：小屏也放得下，关键按钮不会被挤出可视区。"""
        try:
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
        except Exception:
            sw, sh = 1280, 800
        dw = max(960, min(1280, sw - 120))
        dh = max(620, min(840, sh - 140))
        st = self._load_ui_state()
        try:
            w = int(st.get("width") or dw)
            h = int(st.get("height") or dh)
        except Exception:
            w, h = dw, dh
        w = max(880, min(w, sw))
        h = max(560, min(h, sh))
        x = st.get("x")
        y = st.get("y")
        placed = False
        if isinstance(x, int) and isinstance(y, int) and -20 <= x <= max(0, sw - 300) and -20 <= y <= max(0, sh - 200):
            self.root.geometry(f"{w}x{h}+{x}+{y}")
            placed = True
        if not placed:
            self.root.geometry(f"{w}x{h}+{max(0, (sw - w) // 2)}+{max(0, (sh - h) // 3)}")
        self.root.minsize(min(880, max(640, sw - 40)), min(560, max(460, sh - 80)))
        try:
            if st.get("zoomed"):
                self.root.state("zoomed")
        except Exception:
            pass
        self._pending_tab = st.get("tab") if isinstance(st.get("tab"), int) else 0

    def _select_initial_tab(self):
        tabs = self.nb.tabs()
        if not tabs:
            return
        idx = max(0, min(int(self._pending_tab or 0), len(tabs) - 1))
        try:
            self.nb.select(tabs[idx])
        except Exception:
            pass

    def _current_tab_index(self) -> int:
        try:
            return list(self.nb.tabs()).index(self.nb.select())
        except Exception:
            return 0

    def _on_tab_changed(self, _e=None):
        self._schedule_ui_state_save()

    def _schedule_ui_state_save(self):
        if self._ui_save_job is not None:
            try:
                self.root.after_cancel(self._ui_save_job)
            except Exception:
                pass
        try:
            self._ui_save_job = self.root.after(400, self._save_ui_state)
        except Exception:
            self._ui_save_job = None

    def _save_ui_state(self, force: bool = False):
        """记住标签页 + 窗口大小；任何失败都静默忽略。"""
        self._ui_save_job = None
        try:
            if not self.root.winfo_exists():
                return
            if not force and not self.root.winfo_viewable():
                return                      # 隐藏窗口（冒烟测试/自检）不写盘
            w, h = self.root.winfo_width(), self.root.winfo_height()
            if w < 200 or h < 200:
                return
            zoomed = False
            try:
                zoomed = self.root.state() == "zoomed"
            except Exception:
                pass
            state = {"width": w, "height": h, "tab": self._current_tab_index(), "zoomed": zoomed}
            if not zoomed:
                state["x"] = self.root.winfo_x()
                state["y"] = self.root.winfo_y()
            self._ui_state_path().write_text(
                json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception:
            pass

    def _on_close(self):
        self._save_ui_state(force=True)
        try:
            self.root.destroy()
        except Exception:
            pass

    def _style_notebook(self):
        """标签页留出内边距，文字不被截断。"""
