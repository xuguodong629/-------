    # ---------------- ⑧ 页：选项 / 取值 / 计划 ----------------

    def refresh_skeleton_options(self):
        """类型下拉=②页映射的类型；目录下拉=映射里的目录 + 知识库实际内容目录。"""
        if not hasattr(self, "sk_type_combo"):
            return
        auto_t = getattr(self, "SK_AUTO_TYPE", "（自动判断）")
        auto_d = getattr(self, "SK_AUTO_DIR", "（按类型自动）")
        types = [auto_t] + sorted((self.cfg.get("routes") or {}).keys())
        dirs = [auto_d] + self._sk_content_dirs()
        self.sk_type_combo["values"] = types
        self.sk_dir_combo["values"] = dirs
        if self.sk_type_var.get() not in types:
            self.sk_type_var.set(auto_t)
        if self.sk_dir_var.get() not in dirs:
            self.sk_dir_var.set(auto_d)

    def _sk_content_dirs(self) -> list:
        out: list = []
        for v in (self.cfg.get("routes") or {}).values():
            v = str(v or "").strip()
            if v and v not in out:
                out.append(v)
        try:
            kb = core.resolve_kb(self.cfg)
            if kb is not None:
                for p in sorted(kb.iterdir()):
                    name = p.name
                    if (p.is_dir() and name not in out and not name.startswith(("_", "."))
                            and "模板" not in name and "Templates" not in name):
                        out.append(name)
        except Exception:
            pass
        return out

    def _sk_text(self) -> str:
        return self.sk_kw.get("1.0", "end").strip() if hasattr(self, "sk_kw") else ""

    def _sk_default_type(self) -> str:
        v = self.sk_type_var.get().strip() if hasattr(self, "sk_type_var") else ""
        return "" if v == getattr(self, "SK_AUTO_TYPE", "") else v

    def _sk_default_dir(self) -> str:
        v = self.sk_dir_var.get().strip() if hasattr(self, "sk_dir_var") else ""
        return "" if v == getattr(self, "SK_AUTO_DIR", "") else v

    def _sk_overwrite(self) -> bool:
        return bool(self.sk_overwrite_var.get()) if hasattr(self, "sk_overwrite_var") else False

    def _sk_limit(self) -> int:
        raw = self.sk_limit_var.get().strip() if hasattr(self, "sk_limit_var") else ""
        try:
            return max(0, int(raw))
        except Exception:
            return 0

    def _sk_plan(self) -> list:
        """按当前关键词算出"会建到哪"：[{name, type, dir, status}]（不写盘、不调用模型）。"""
        rows: list = []
        try:
            kb = core.resolve_kb(self.cfg)
        except Exception:
            kb = None
        for it in core.parse_keyword_lines(self._sk_text(), default_type=self._sk_default_type(),
                                           default_dir=self._sk_default_dir()):
            name = str(it.get("name") or "").strip()
            if not name:
                continue
            t = str(it.get("type") or "").strip() or core.suggest_type_for_kb(self.cfg, name)
            d = str(it.get("dir") or "").strip() or str((self.cfg.get("routes") or {}).get(t) or "")
            if not t:
                known = "、".join(sorted(self.cfg.get("routes") or {})) or "（没配类型映射）"
                rows.append({"name": name, "type": "—", "dir": d or "—",
                             "status": f"判断不出类型（写成「类型:名称」；本库类型：{known[:24]}…）"})
                continue
            if not d:
                rows.append({"name": name, "type": t, "dir": "—",
                             "status": "该类型没有对应目录（到②页配映射）"})
                continue
            tpl_ok = False
            try:
                tpl_path, _tpl_name = core.resolve_template(self.cfg, t)
                tpl_ok = bool(tpl_path) and Path(str(tpl_path)).is_file()
            except Exception:
                tpl_ok = False
            if not tpl_ok:
                rows.append({"name": name, "type": t, "dir": d,
                             "status": f"缺模板「{t}」（到④页选模板文件夹或粘贴模板）"})
                continue
            status = "待处理"
            if kb is not None:
                try:
                    title = core.sanitize_title(name) or name
                    status = "已存在" if (kb / d / f"{title}.md").exists() else "待新建"
                except Exception:
                    status = "待处理"
            rows.append({"name": name, "type": t or "—", "dir": d, "status": status})
        limit = self._sk_limit()
        return rows[:limit] if limit else rows

    def _fill_sk_table(self, rows: list):
        for iid in self.sk_tree.get_children():
            self.sk_tree.delete(iid)
        self._sk_rows = {}
        for row in rows:
            iid = self.sk_tree.insert("", "end", values=(row["name"], row["type"],
                                                         row["dir"], row["status"]))
            self._sk_rows[iid] = row

    def _sk_busy(self) -> tuple:
        return (getattr(self, "btn_sk_load", None), getattr(self, "btn_sk_preview", None),
                getattr(self, "btn_sk_create", None))

    # ---------------- ⑧ 页：动作 ----------------

    def do_sk_load_terms(self):
        """把词表里"库内还没有的待建词条"填进关键词框（只填前 200 条）。"""
        terms: list = []
        src = "链接词表"
        try:
            data = core.load_term_dictionary()
            terms = [str(x).strip() for x in (data.get("unresolved") or []) if str(x).strip()]
        except Exception:
            terms = []
        if not terms:                                  # 词表为空时退回"正文+备份里汇总"
            try:
                terms = [str(x).strip() for x in core.collect_missing_terms(self.cfg, limit=200)
                         if str(x).strip()]
                src = "全库正文与备份"
            except Exception:
                terms = []
        if not terms:
            self.log(self.sk_log, "✗ 没有可载入的待建词条（词表与全库都没找到）", "err")
            self.set_status("没有可载入的待建词条", err=True)
            return
        fill = terms[:200]
        msg = (f"将把「{src}」里「库内还没有对应词条」的 {len(terms)} 条填入关键词框"
               + ("，只填前 200 条以免太长" if len(terms) > 200 else "") + "。\n\n继续吗？")
        if not messagebox.askokcancel("载入待建词条", msg, parent=self.root):
            return
        self.sk_kw.delete("1.0", "end")
        self.sk_kw.insert("1.0", "\n".join(fill))
        self._fill_sk_table(self._sk_plan())
        self.log(self.sk_log, f"✓ 已从「{src}」载入 {len(fill)} 条待建词条"
                              + (f"（共 {len(terms)} 条，仅载入前 200 条）" if len(terms) > 200 else ""),
                 "ok")
        self.set_status(f"已载入 {len(fill)} 条待建词条，可点「🔍 预览（不写盘）」看会建到哪")

    def do_sk_preview(self):
        self._do_sk(dry_run=True)

    def do_sk_create(self):
        self._do_sk(dry_run=False)

    def _do_sk(self, dry_run: bool):
        text = self._sk_text()
        if not text:
            self.set_status("先在「① 关键词清单」里填关键词（每行一个）", err=True)
            return
        self._fill_sk_table(self._sk_plan())            # 先按当前关键词刷新"会建到哪"
        cfg = self.cfg
        dt, dd, ow, limit = (self._sk_default_type(), self._sk_default_dir(),
                             self._sk_overwrite(), self._sk_limit())

        def work():
            return core.create_skeleton_notes(cfg, text, type_=dt, target_dir=dd,
                                              dry_run=dry_run, overwrite=ow, limit=limit)

        desc = "🔍 批量建条（预览）" if dry_run else "✅ 批量建条（创建）"
        self.run_task(work, lambda r: self._on_sk_done(r, dry_run=dry_run), desc,
                      busy=self._sk_busy())

    def _on_sk_done(self, r, dry_run: bool):
        r = self._on_result(self.sk_log, r, "批量建条失败：")
        if r is None:
            return
        created = [str(x) for x in (r.get("created") or [])]
        skipped = [str(x) for x in (r.get("skipped") or [])]
        failed = [str(x) for x in (r.get("failed") or [])]
        report = [str(x) for x in (r.get("report") or [])]
        if not created and not skipped and not failed:
            detail = "；".join(report or ["没有可处理的条目（关键词清单是空的？）"])
            self.log(self.sk_log, f"✗ {detail}", "err")
            self.set_status(f"{detail}（详情见日志区）", err=True)
            return
        total = r.get("total")
        self.log(self.sk_log,
                 f"{'🔍 预览' if dry_run else '✅ 批量创建'}："
                 f"创建 {len(created)} 篇／跳过 {len(skipped)} 篇／失败 {len(failed)} 篇"
                 f"（共 {total} 条）", "err" if failed else "ok")
        for line in report:
            self.log(self.sk_log, "   · " + line, "info")
        if failed:
            self.log(self.sk_log, "   失败：" + "、".join(failed[:20])
                     + ("…" if len(failed) > 20 else ""), "err")
            reasons = [(str(d.get("name")), str(d.get("reason") or "")) for d in (r.get("details") or [])
                       if not d.get("ok")]
            shown = 0
            for nm, why in reasons:
                if shown >= 20:
                    self.log(self.sk_log, f"   …其余 {len(reasons) - shown} 条原因略", "info")
                    break
                self.log(self.sk_log, f"   ✗ {nm}：{why[:160]}", "err")
                shown += 1
        if dry_run:
            self.log(self.sk_log, "   以上只是预览，没有写盘；确认无误点「✅ 批量创建（先备份）」", "info")
        else:
            self.log(self.sk_log, "   新建的是骨架（TODO 占位）：填内容用 ⑦ 补充更新页，"
                                  "补双链用 ⑤ 索引与统计页。", "info")
        # 回填状态列
        done: dict = {}
        for x in created:
            done[x.split("/")[-1].strip()] = "预览✓" if dry_run else "已创建"
        for x in skipped:
            done[x.strip()] = "已存在，跳过"
        reason_map = {str(d.get("name")): str(d.get("reason") or "")
                      for d in (r.get("details") or []) if not d.get("ok")}
        for x in failed:
            why = reason_map.get(x.strip(), "")
            if "缺模板" in why or "模板" in why:
                done[x.strip()] = "失败：缺模板"
            elif "没能判断" in why or "没有能对应" in why:
                done[x.strip()] = "失败：判断不出类型"
            elif "目录" in why:
                done[x.strip()] = "失败：缺目录"
            else:
                done[x.strip()] = "失败"
        for iid, row in getattr(self, "_sk_rows", {}).items():
            st = done.get(str(row.get("name")))
            if st:
                try:
                    self.sk_tree.set(iid, "status", st)
                except Exception:
                    pass
        self.set_status(f"批量建条{'预览' if dry_run else '完成'}："
                        f"创建 {len(created)}／跳过 {len(skipped)}／失败 {len(failed)}")

    def do_sk_clear(self):
        self.sk_kw.delete("1.0", "end")
        self.sk_limit_var.set("")
        self.sk_overwrite_var.set(False)
        self._fill_sk_table([])
        self.clear_log(self.sk_log, silent=True)
        self.set_status("已清空 ⑧ 批量建条页的输入")


def main(root: tk.Tk) -> App:
    return App(root)
