    def save_ai(self):
        try:
            temp = float(self.ai_temp_var.get() or 0.3)
        except (TypeError, ValueError):
            self.set_status("Temperature 需要是数字，例如 0.3", err=True)
            return
        try:
            max_tokens = int(float(self.ai_max_var.get() or 8000))
        except (TypeError, ValueError):
            self.set_status("max_tokens 需要是整数，例如 8000", err=True)
            return
        max_tokens = max(512, min(32000, max_tokens))
        self.ai_max_var.set(str(max_tokens))
        self.cfg.setdefault("ai", {})
        self.cfg["ai"].update({
            "provider": "deepseek",
            "base_url": self.ai_base_var.get().strip(),
            "api_key": self.ai_key_var.get().strip(),
            "model": self.ai_model_var.get().strip() or "deepseek-chat",
            "temperature": temp,
            "max_tokens": max_tokens,
        })
        self._persist("AI 设置（config.json）")

    def test_ai(self):
        self.save_ai()
        client = AIClient(**self._ai_params())
        self.run_task(client.quick_test, self._on_quick_test, "AI 连接测试",
                      busy=(self.btn_test_ai,))

