    def _manual_payload(self) -> str:
        """粘贴框内容（若填了附加字段，则并入 frontmatter）。"""
        text = self.man_content.get("1.0", "end").strip()
        extra = self.man_fm.get("1.0", "end").strip()
        if not extra:
            return text
        if text.startswith("---"):
            end = text.find("\n---", 3)
            if end > 0:
                return text[:end] + "\n" + extra + text[end:]
        return "---\n" + extra + "\n---\n\n" + text

    def _manual_type_override(self) -> str:
        t = self.man_type_var.get().strip()
        return "" if t in ("", getattr(self, "MAN_AUTO_TYPE", "")) else t

    def _manual_title_override(self) -> str:
        """标题框为空 → 交回给程序自动识别（别把 sanitize_title 的「未命名」当标题传下去）。"""
        raw = self.man_title_var.get().strip()
        return core.sanitize_title(raw) if raw else ""

    def _manual_download_images(self) -> bool:
        return bool(self.man_dl_img_var.get()) if hasattr(self, "man_dl_img_var") else True

    def _fill_manual_recognition(self, type_, title, why, note):
        """把识别结果回填到界面（不触发「用户手改」判定）。"""
        self._man_filling = True
        try:
            if type_:
                self.man_type_var.set(str(type_))
            if title:
                self.man_title_var.set(str(title))
            bits = []
            if why:
                bits.append(f"类型判定：{why}")
            if note:
                bits.append(f"模板：{note}")
            self.man_why_var.set("　｜　".join(bits) or "类型：已识别")
        finally:
            self._man_filling = False
        self._man_user_title = False
        self._man_user_type = False

    def _on_manual_ctrl_enter(self, _e=None):
        self.do_manual_preview()
        return "break"

    def _on_manual_ctrl_shift_enter(self, _e=None):
        self.do_manual_write()
        return "break"

    def _on_manual_content_modified(self, _e=None):
        """粘贴/编辑内容后：作废上一次识别结果（下次预览重新识别）。"""
        try:
            if not self.man_content.edit_modified():
                return
            self.man_content.edit_modified(False)
        except Exception:
            pass
        if getattr(self, "_man_filling", False):
            return
        if self._man_user_title and self._man_user_type:
            return                                     # 用户自己填的类型+标题：不动
        self._man_filling = True
        try:
            if not self._man_user_title:
                self.man_title_var.set("")
            if not self._man_user_type:
                self.man_type_var.set(getattr(self, "MAN_AUTO_TYPE", ""))
            self.man_why_var.set("类型：待识别（内容已变化，请重新点「🔎 识别并预览」）")
        finally:
            self._man_filling = False
        self._man_user_title = self._man_user_type = False
        if self._man_images:
            self._man_images = []
            self._set_img_state(getattr(self, "man_img_state_var", None),
                                "配图：未选（内容已改，请重新配图）")
        self._man_previewed = False

    def _on_manual_key_changed(self, *_a):
        """⑥ 页标题/类型被改：记住「用户手改过」，并让已选配图作废（避免张冠李戴）。"""
        if getattr(self, "_man_filling", False):
            return                                     # 自动回填，不算用户手改
        auto = getattr(self, "MAN_AUTO_TYPE", "（自动识别）")
        self._man_user_title = bool(self.man_title_var.get().strip())
        self._man_user_type = self.man_type_var.get().strip() not in ("", auto)
        if self._man_images:
            self._man_images = []
            self._set_img_state(getattr(self, "man_img_state_var", None),
                                "配图：未选（标题/类型已改，请重新配图）")
        self._man_previewed = False
        if hasattr(self, "man_find_var"):
            self.man_find_var.set("查重：标题/类型已改，请重新点「🔍 查重」")
            self._found_note = ""
            self._set_enabled([getattr(self, "btn_man_open_note", None)], False)

    def do_manual_acquire_image(self):
        """⑥ 页配图：本地图库优先，其次中文维基百科（联网只在点这个按钮时发生）。"""
        title = core.sanitize_title(self.man_title_var.get().strip())
        if not title:
            self.set_status("请先填「标题」，再点「🖼 配图」", err=True)
            return
        self.log(self.man_log, f"▶ 配图：查找「{title}」的图片（本地图库 → 中文维基百科）…", "head")

        def work():
            return core.acquire_image(self.cfg, title, aliases=(title,), allow_network=True)

        self.run_task(work, self._on_manual_acquire_image_done, "配图",
                      busy=(getattr(self, "btn_man_image", None), self.btn_man_preview))

    def _on_manual_acquire_image_done(self, r):
        if isinstance(r, tuple) and r and r[0] == "ERROR":
            self.log(self.man_log, f"✗ 配图失败：{r[1]}", "err")
            self.set_status(f"配图失败：{r[1]}（详情见日志区）", err=True)
            return
        if not isinstance(r, dict):
            self.log(self.man_log, "✗ 配图失败：返回结果异常", "err")
            self.set_status("配图失败：返回结果异常（详情见日志区）", err=True)
            return
        if not r.get("ok"):
            note = str(r.get("note") or "未取得图片")
            self.log(self.man_log, f"✗ 配图未成功：{note}", "err")
            self.log(self.man_log, "   → 可手动把图片放进 Assets（图片地图）后重试；标题越规范越容易匹配。", "info")
            self.set_status(f"配图未成功：{note}", err=True)
            return
        entry = self._img_entry(r)
        self._man_images = [entry]
        source = str(r.get("source") or "")
        credit = str(r.get("credit") or "")
        self.log(self.man_log,
                 f"✓ 配图：{entry.get('file')}（来源：{source or '未知'}{('／' + credit) if credit else ''}）", "ok")
        self.log(self.man_log,
                 f"   路径：{entry.get('path')}（预览/笔记里写 ![[{entry.get('file')}]]）", "info")
        self._set_img_state(getattr(self, "man_img_state_var", None),
                            f"配图：{entry.get('file')}（{source or '未知'}）")
        self.set_status(f"配图完成：{entry.get('path')}")
        if self._man_previewed:               # 已预览过 → 带新图刷新预览
            self.do_manual_preview()

    def _manual_mode(self) -> str:
        """⑥ 页「写入方式」→ core 的 mode。"""
        v = getattr(self, "man_mode_var", None)
        text = v.get() if v is not None else ""
        if text.startswith("只新建"):
            return "create"
        if text.startswith("只补充已有"):
            return "update"
        return "auto"

    def do_manual_find(self):
        """查重：知识库里有没有这篇词条（同名 + 相近名），并列出已有小节的填充情况。"""
        title = (self.man_title_var.get() or "").strip()
        if not title:
            body = self._manual_payload()
            first = next((ln.strip() for ln in body.splitlines() if ln.strip()), "")
            title = core.guess_title_from_text(self.cfg, body) or first
        if not title:
            self.set_status("先粘贴内容或填标题，再查重", err=True)
            return
        cfg = self.cfg
        type_ = self._manual_type_override()
        body = self._manual_payload()

        def work():
            return {"info": core.find_existing_note(cfg, title, type_),
                    "title": title,
                    "guessed": core.guess_title_from_text(cfg, body)}

        self.run_task(work, self._on_manual_find_done, "查重", busy=(self.btn_man_find,))

    def _on_manual_find_done(self, r):
        r = self._on_result(self.man_log, r)
        if r is None:
            return
        info = r.get("info") or {}
        log = self.man_log
        self._found_note = ""
        matches = info.get("matches") or []
        if matches:
            m = matches[0]
            self._found_note = m.get("path") or ""
            self.man_find_var.set(f"查重：已存在 → {m.get('dir')}/{m.get('title')}.md"
                                  f"（{m.get('size_kb')} KB，改于 {m.get('mtime')}）")
            self.log(log, f"🔍 知识库里已经有这篇：{m.get('dir')}/{m.get('title')}.md", "ok")
            for s in (m.get("sections") or [])[:12]:
                tag = "空（可补充）" if not s.get("filled") else f"已有 {s.get('filled')} 行"
                self.log(log, f"   · {s.get('label')}：{tag}", "info")
            self.log(log, "   → 点「🔎 识别并预览」看**补充整合后**的完整内容，再「✅ 写入知识库」即可"
                          "（已有内容不会被覆盖，只填空、只追加缺失小节）", "info")
        else:
            self.man_find_var.set("查重：没有同名词条 → 将新建")
            self.log(log, f"🔍 知识库里没有「{r.get('title')}」这个词条 → 将新建", "ok")
        sugs = info.get("suggestions") or []
        if sugs:
            self.log(log, "   相近名字的词条（可能是同一个，改名可改到这个标题）：", "info")
            for s in sugs[:8]:
                self.log(log, f"   · {s.get('dir')}/{s.get('title')}.md", "info")
        self._set_enabled([getattr(self, "btn_man_open_note", None)], bool(self._found_note))
        self.set_status(self.man_find_var.get())

    def open_found_note(self):
        path = getattr(self, "_found_note", "")
        if not path:
            self.set_status("还没查到已存在的词条（先点「🔍 查重」）", err=True)
            return
        if self._open_dir(path):
            self.set_status(f"已打开：{path}")
        else:
            self.set_status(f"打开失败，可手动打开：{path}", err=True)

    def do_manual_preview(self):
        """整段粘贴 → 识别类型/标题 → 套模板 → 预览（dry_run，不写盘）。"""
        text = self._manual_payload()
        if not text.strip():
            self.set_status("请先把内容粘贴进「粘贴内容」框", err=True)
            try:
                self.man_content.focus_set()
            except Exception:
                pass
            return
        cfg = self.cfg
        type_override = self._manual_type_override()
        title_override = self._manual_title_override()
        download = self._manual_download_images()

        def work():
            return core.import_entry_from_text(
                cfg, text, type_override=type_override, title_override=title_override,
                download_images=download, mode=self._manual_mode(), dry_run=True)

        self.run_task(work, self._on_manual_preview_done, "识别并预览",
                      busy=(self.btn_man_preview, self.btn_man_write,
                            getattr(self, "btn_man_image", None)))

    def _on_manual_preview_done(self, r):
        r = self._on_result(self.man_log, r)
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(r.get("report") or ["识别失败"])
            self.log(self.man_log, f"✗ {detail}", "err")
            self.set_status(f"{detail}（详情见日志区）", err=True)
            return
        self._fill_manual_recognition(r.get("type"), r.get("title"), r.get("why"), r.get("note"))
        action = r.get("action") or "预览"
        existing = r.get("existing") or {}
        m = (existing.get("matches") or [{}])[0] if existing.get("matches") else {}
        if action == "增量预览":
            self._found_note = m.get("path") or r.get("path") or ""
            self.man_find_var.set(f"查重：已存在 → {m.get('dir')}/{m.get('title')}.md（本次为补充整合）")
            self._set_enabled([getattr(self, "btn_man_open_note", None)], bool(self._found_note))
            head = (f"─── 补充整合预览 → {m.get('dir')}/{m.get('title')}.md "
                    f"（{r.get('summary')}）───")
        else:
            head = f"─── 新建预览（模板：{r.get('note')}）───"
        self._show_manual_log(r.get("text") or "", r.get("note") or "", head=head)
        self._man_previewed = True
        self.log(self.man_log, f"✓ {action}：{r.get('summary')}", "ok")
        for rep in r.get("report") or []:
            self.log(self.man_log, "   · " + rep, "info")
        imgs = r.get("images") or []
        if imgs:
            self.log(self.man_log,
                     f"   🖼 正文图片已入库 {len(imgs)} 张：{'、'.join(str(x) for x in imgs[:6])}", "ok")
        self.set_status(f"{action}：类型「{r.get('type')}」／标题「{r.get('title')}」——{r.get('summary')}")

    def do_manual_write(self):
        """整段粘贴 → 识别 → 套模板 → 写入②页映射的对应目录（已存在则增量更新）。"""
        text = self._manual_payload()
        if not text.strip():
            self.set_status("请先把内容粘贴进「粘贴内容」框", err=True)
            return
        cfg = self.cfg
        type_override = self._manual_type_override()
        title_override = self._manual_title_override()
        download = self._manual_download_images()
        manual_images = list(self._man_images)          # 🖼 配图按钮选的图

        def work():
            r = core.import_entry_from_text(
                cfg, text, type_override=type_override, title_override=title_override,
                download_images=download, mode=self._manual_mode(), dry_run=False)
            if r.get("ok") and manual_images and r.get("path"):
                from pathlib import Path
                try:                                     # 把「🖼 配图」选的图插到 H1 之后
                    p = Path(r["path"])
                    old = p.read_text(encoding="utf-8")
                    new_text = core.insert_images(old, manual_images)
                    if new_text != old:
                        core.write_text_keep_eol(p, new_text)
                        r.setdefault("report", []).append(
                            "配图：" + "、".join(str(e.get("file")) for e in manual_images))
                except Exception as exc:                 # 配图失败不影响写入结果
                    r.setdefault("report", []).append(f"配图写入失败：{type(exc).__name__}: {exc}")
            return r

        self.run_task(work, self._on_manual_write_done, "写入知识库",
                      busy=(self.btn_man_write, self.btn_man_preview,
                            getattr(self, "btn_man_image", None)))

    def _on_manual_write_done(self, r):
        r = self._on_result(self.man_log, r)
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(r.get("report") or ["写入失败"])
            self.log(self.man_log, f"✗ 写入失败：{detail}", "err")
            self.set_status(f"写入失败：{detail}（详情见日志区）", err=True)
            return
        path = r.get("path") or ""
        self._last_write_path = path
        self._refresh_steps()
        action = r.get("action") or "写入"
        head = f"─── 已{action}：{r.get('type') or ''}／{r.get('title') or ''} ───"
        shown = ""
        try:                                             # 直接把落盘后的文件显示出来（所见即所得）
            from pathlib import Path
            if path and Path(path).is_file():
                shown = Path(path).read_text(encoding="utf-8")
        except Exception:
            shown = ""
        if shown:
            self._show_manual_log(shown, "", head=head)
        self.log(self.man_log, f"✓ 已{action}：{path}", "ok")
        if r.get("summary"):
            self.log(self.man_log, f"   本次改动：{r.get('summary')}", "ok")
        if r.get("why"):
            self.log(self.man_log, f"   类型判定：{r.get('why')}", "info")
        for rep in r.get("report") or []:
            self.log(self.man_log, "   · " + rep, "info")
        self.log(self.man_log, f"  完整路径：{path}（点「打开所在文件夹」可直接定位）", "info")
        if action == "增量更新":
            self.log(self.man_log,
                     "   （增量更新：只填空、只追加缺失小节；改动前的旧版已备份到 "
                     f"{core.BACKUP_DIR_NAME}/笔记/）", "info")
        self.set_status(f"已{action}，完整路径：{path}")
        self._man_previewed = False

    def _show_manual_log(self, text: str, note: str, head: str = ""):
        self.man_log.configure(state="normal")
        self.man_log.delete("1.0", "end")
        self.man_log.insert("end", (head or f"─── 笔记预览（模板：{note}）───") + "\n", "head")
        self.man_log.insert("end", text)
        self._scroll_to_end(self.man_log)       # 自动滚动到底部
        self.man_log.configure(state="disabled")

    def do_manual_clear(self):
        self._man_filling = True
        try:
            self.man_title_var.set("")
            self.man_summary_var.set("")
            self.man_type_var.set(getattr(self, "MAN_AUTO_TYPE", "（自动识别）"))
            self.man_why_var.set("类型：待识别（粘贴内容后点「🔎 识别并预览」）")
            if hasattr(self, "man_find_var"):
                self.man_find_var.set("查重：未检查")
            self._found_note = ""
            self._set_enabled([getattr(self, "btn_man_open_note", None)], False)
        finally:
            self._man_filling = False
        self.man_fm.delete("1.0", "end")
        self.man_content.delete("1.0", "end")
        try:
            self.man_content.edit_modified(False)
        except Exception:
            pass
        self._man_images = []
        self._man_previewed = False
        self._man_user_title = self._man_user_type = False
        self._set_img_state(getattr(self, "man_img_state_var", None), "配图：未选")
        self.clear_log(self.man_log, silent=True)
        self.set_status("已清空输入")


