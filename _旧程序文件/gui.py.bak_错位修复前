    # ---------------- ⑥ 页：从 md 文档批量建库 ----------------

    def do_md_pick(self):
        """选一个 md 文件（只记住路径并把文件名回显出来，不读内容）。"""
        try:
            path = filedialog.askopenfilename(
                title="选择要拆分成词条的 Markdown 文档",
                filetypes=[("Markdown", "*.md"), ("文本", "*.txt"), ("所有文件", "*.*")],
                parent=self.root)
        except Exception as exc:  # noqa: BLE001
            self.log(self.man_log, f"✗ 打开文件选择框失败：{type(exc).__name__}: {exc}", "err")
            return
        if not path:
            self.set_status("没有选择文件（可重新点「📂 选择 md 文件…」）")
            return
        self._md_path = str(path)
        self.md_file_var.set(Path(self._md_path).name)
        self.log(self.man_log, f"📄 已选择文件：{self._md_path}", "head")
        self._fill_md_table(self._md_plan())
        self.set_status(f"已选择：{Path(self._md_path).name}"
                        f"（点「🔍 预览（看会建哪些词条）」）")

    def _md_level(self) -> int:
        """标题级别下拉 → level（0=自动）。"""
        v = self.md_level_var.get().strip() if hasattr(self, "md_level_var") else ""
        m = re.match(r"^(\d)", v or "")
        return int(m.group(1)) if m else 0

    def _md_default_type(self) -> str:
        v = self.md_type_var.get().strip() if hasattr(self, "md_type_var") else ""
        return "" if v == getattr(self, "MAN_AUTO_TYPE", "") else v

    def _md_busy(self) -> tuple:
        return (getattr(self, "btn_md_preview", None), getattr(self, "btn_md_create", None))

    def _md_read(self) -> str:
        """读文件；失败返回空串并写日志（不抛异常栈）。"""
        path = str(getattr(self, "_md_path", "") or "")
        if not path:
            self.log(self.man_log, "✗ 还没选文件：先点「📂 选择 md 文件…」"
                                   "（要建单篇可直接把内容粘到上面的粘贴框用「🔎 识别并预览」）", "err")
            self.set_status("先选择要拆分的 md 文件", err=True)
            return ""
        try:
            return Path(path).read_text(encoding="utf-8", errors="replace")
        except Exception as exc:  # noqa: BLE001
            self.log(self.man_log, f"✗ 读取文件失败（{Path(path).name}）："
                                   f"{type(exc).__name__}: {exc}", "err")
            self.set_status(f"读取文件失败：{exc}", err=True)
            return ""

    def _md_plan(self) -> list:
        """按标题先算出"会建哪些词条、判成什么类型、放哪个目录、正文字数"（不写盘）。"""
        rows: list = []
        self._md_entries = []
        if not str(getattr(self, "_md_path", "") or ""):
            return rows
        text = self._md_read()
        if not text.strip():
            return rows
        try:
            entries = core.split_markdown_entries(text, level=self._md_level())
        except Exception as exc:  # noqa: BLE001
            self.log(self.man_log, f"✗ 拆分文档失败：{type(exc).__name__}: {exc}", "err")
            return rows
        self._md_entries = entries
        default_type = self._md_default_type()
        routes = self.cfg.get("routes") or {}
        for e in entries:
            title = str(e.get("title") or "").strip()
            meta = e.get("meta") or {}
            t = (default_type or str(meta.get("类型") or meta.get("type") or "").strip()
                 or core.suggest_type_for_kb(self.cfg, title))
            d = str(routes.get(t) or "").strip()
            note = ""
            if not t:
                note = "—（该库没有能对应的类型：请在文档里写「类型: X」或用默认类型）"
            elif not d:
                note = "—（该类型没有对应目录）"
            rows.append({"name": title, "type": t or "—", "dir": d or note,
                         "chars": len(str(e.get("body") or ""))})
        return rows

    def _fill_md_table(self, rows: list):
        if not hasattr(self, "md_tree"):
            return
        for iid in self.md_tree.get_children():
            self.md_tree.delete(iid)
        self._md_rows = {}
        for row in rows or []:
            iid = self.md_tree.insert("", "end", values=(row["name"], row["type"],
                                                         row["dir"], row["chars"]))
            self._md_rows[iid] = row

    def do_md_preview(self):
        self._do_md(dry_run=True)

    def do_md_create(self):
        self._do_md(dry_run=False)

    def _do_md(self, dry_run: bool):
        text = self._md_read()
        if not text.strip():
            return
        try:
            entries = core.split_markdown_entries(text, level=self._md_level())
        except Exception as exc:  # noqa: BLE001
            self.log(self.man_log, f"✗ 拆分文档失败：{type(exc).__name__}: {exc}", "err")
            self.set_status(f"拆分文档失败：{exc}", err=True)
            return
        if not entries:
            self.log(self.man_log, "✗ 这份文档里没找到可拆分的标题：请确认文档里有标题行"
                                   "（如 `## 词条名`），或把「标题级别」改成文档实际用的级别"
                                   "（# / ## / ### / ####）", "err")
            self.set_status("文档里没有找到可拆分的标题", err=True)
            return
        self._fill_md_table(self._md_plan())             # 先把"会建到哪"刷新出来
        cfg, lv, tp = self.cfg, self._md_level(), self._md_default_type()
        dl = bool(self.md_dl_img_var.get()) if hasattr(self, "md_dl_img_var") else False

        def work():
            return core.import_markdown_document(cfg, text, level=lv, type_override=tp,
                                                 dry_run=dry_run, overwrite=False,
                                                 download_images=dl)

        desc = "📄 md 批量建库（预览）" if dry_run else "📄 md 批量建库（创建）"
        self.run_task(work, lambda r: self._on_md_done(r, dry_run=dry_run), desc,
                      busy=self._md_busy())

    def _on_md_done(self, r, dry_run: bool):
        r = self._on_result(self.man_log, r, "从 md 批量建库失败：")
        if r is None:
            return
        created = [str(x) for x in (r.get("created") or [])]
        skipped = [str(x) for x in (r.get("skipped") or [])]
        failed = [str(x) for x in (r.get("failed") or [])]
        report = [str(x) for x in (r.get("report") or [])]
        total = r.get("total")
        if not created and not skipped and not failed:
            detail = "；".join(report) or "这份文档里没有拆出词条"
            self.log(self.man_log, f"✗ {detail}", "err")
            self.set_status(detail, err=True)
            return
        self.log(self.man_log,
                 f"{'🔍 预览' if dry_run else '✅ 已建库'}："
                 f"已建 {len(created)} 篇／跳过 {len(skipped)} 篇／失败 {len(failed)} 篇"
                 f"（共 {total} 条）", "err" if failed else "ok")
        for line in report:
            self.log(self.man_log, "   · " + line, "info")
        if failed:
            self.log(self.man_log, "   失败：" + "、".join(failed[:20])
                     + ("…" if len(failed) > 20 else ""), "err")
        if dry_run:
            self.log(self.man_log, "   以上只是预览，没有写盘；确认无误点「✅ 批量创建（先备份）」", "info")
        else:
            self.log(self.man_log, "   往骨架里填内容用 ⑦ 补充更新页；补正文双链用 ⑤ 索引与统计页。", "info")
            self._last_write_dir = str(Path(str(getattr(self, "_md_path", ""))).parent)
        self.set_status(f"md 批量建库{'预览' if dry_run else '完成'}："
                        f"已建 {len(created)}／跳过 {len(skipped)}／失败 {len(failed)}")

