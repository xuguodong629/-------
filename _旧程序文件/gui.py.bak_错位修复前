    def refresh_map_rows(self):
        if not hasattr(self, "map_tree"):
            return
        for i in self.map_tree.get_children():
            self.map_tree.delete(i)
        types = sorted((self.cfg.get("routes") or {}).keys())
        self.map_type_combo["values"] = types
        for t in types:
            d = (self.cfg.get("routes") or {}).get(t, "")
            tpl = (self.cfg.get("template_routes") or {}).get(t, "通用.md")
            self.map_tree.insert("", "end", values=(t, d, tpl))
        # 目录下拉：实际扫描到的目录名 + 允许手动输入任意目录名
        kb = core.resolve_kb(self.cfg)
        rows = core.scan_kb(kb) if kb else []
        self._reg_names = [r["name"] for r in rows]
        self.map_dir_combo["values"] = self._reg_names + ["（手动输入目录名）"]
        # 模板下拉：模板目录实际 .md 文件 + 内置模板
        tpl_names = []
        td = core.templates_dir(self.cfg)
        if td:
            tpl_names = [p.name for p in core.list_template_files(td)]
        tpl_names = list(dict.fromkeys(tpl_names))
        self.map_tpl_combo["values"] = tpl_names
        self.refresh_map_status()

    def refresh_map_status(self):
        """②页顶部实时状态：当前知识库、可用目录数、映射是否失效（换库后一眼看出该点什么）。"""
        if not hasattr(self, "map_status_label"):
            return
        kb = core.resolve_kb(self.cfg)
        if kb is None:
            self.map_status_var.set("当前知识库：未设置 —— 请先到①页选择知识库目录")
            self.map_status_label.configure(foreground="#b00020")
            return
        try:
            dirs = [r["name"] for r in core.scan_kb(kb)]
        except Exception:
            dirs = []
        routes = self.cfg.get("routes") or {}
        missing = [t for t, d in routes.items()
                   if str(d or "").strip() and not (kb / str(d)).is_dir()]
        head = f"当前知识库：{kb}（{kb.name}）｜该库可用目录 {len(dirs)} 个"
        if dirs:
            head += "：" + "、".join(dirs[:8]) + ("…" if len(dirs) > 8 else "")
        if not dirs or missing:
            detail = ("该目录下还没有类型目录" if not dirs
                      else f"有 {len(missing)} 个映射指向的目录不存在：" + "、".join(missing[:6])
                           + ("…" if len(missing) > 6 else ""))
            self.map_status_var.set(
                head + f"\n⚠ {detail} → 先点「📁 按映射创建/检查目录」在当前库里建出来，"
                       "或点「🔁 按当前知识库重排映射」改成该库实际的目录名")
            self.map_status_label.configure(foreground="#b00020")
        else:
            self.map_status_var.set(head + "｜映射全部有效 ✓")
            self.map_status_label.configure(foreground="#0a7d32")

    def _on_map_select(self, _e):
        sel = self.map_tree.selection()
        if not sel:
            return
        t, d, tpl = self.map_tree.item(sel[0], "values")
        self.map_type_var.set(t)
        self.map_dir_var.set(d)
        self.map_tpl_var.set(tpl)

    def _sync_map_row_from_type(self, t: str):
        """按类型名把该行现有配置填进编辑区（不写盘）。"""
        routes = self.cfg.get("routes") or {}
        if t not in routes:
            return
        self.map_dir_var.set(routes.get(t, ""))
        self.map_tpl_var.set((self.cfg.get("template_routes") or {}).get(t, "通用.md"))
        for iid in self.map_tree.get_children():
            if self.map_tree.item(iid, "values")[0] == t:
                self.map_tree.selection_set(iid)
                self.map_tree.see(iid)
                break

    def _on_map_type_picked(self, _e=None):
        t = self.map_type_var.get().strip()
        if t:
            self._sync_map_row_from_type(t)
        self.set_status(f"当前编辑：{t}（改动会自动保存）" if t else "请选择类型", err=not t)

    def _on_map_editor_changed(self, _e=None):
        """下拉框/输入框变化 → 自动应用并落盘。"""
        if self._commit_map_row(save=True, silent=True, only_if_changed=True):
            self._refresh_steps()
        return "break"

    def _commit_map_row(self, save: bool = True, silent: bool = False,
                        only_if_changed: bool = True) -> bool:
        """把编辑区的类型/目录/模板写进 cfg（可选立即保存）。"""
        t = self.map_type_var.get().strip()
        if not t:
            if not silent:
                self.set_status("请选择类型", err=True)
            return False
        d = self.map_dir_var.get().strip()
        if d == "（手动输入目录名）":
            d = ""
        tpl = self.map_tpl_var.get().strip() or "通用.md"
        routes = self.cfg.setdefault("routes", {})
        tpl_routes = self.cfg.setdefault("template_routes", {})
        changed = (t not in routes) or (routes.get(t, "") != d) or (tpl_routes.get(t, "") != tpl)
        if only_if_changed and not changed:
            if not silent:
                self.set_status(f"映射未变化：{t} → {d or '（未指定）'}")
            return True
        routes[t] = d
        tpl_routes[t] = tpl
        self.refresh_map_rows()
        if save:
            self._persist(f"映射：{t} → {d or '（未指定）'}（模板 {tpl}）")
        return True

    def apply_map_row(self):
        self._commit_map_row(save=True, silent=False, only_if_changed=False)

    def _on_map_double(self, event):
        """双击单元格就地编辑（目标目录 / 模板文件两列）。"""
        tree = self.map_tree
        if tree.identify_region(event.x, event.y) != "cell":
            return
        col = tree.identify_column(event.x)
        row = tree.identify_row(event.y)
        if not row or col not in ("#2", "#3"):
            return
        vals = tree.item(row, "values")
        if not vals:
            return
        t, cur_dir, cur_tpl = vals[0], vals[1], vals[2]
        self.map_type_var.set(t)
        self._sync_map_row_from_type(t)
        bbox = tree.bbox(row, col)
        if not bbox or not bbox[2]:
            return
        x, y, w, h = bbox
        values = self.map_dir_combo["values"] if col == "#2" else self.map_tpl_combo["values"]
        cur = cur_dir if col == "#2" else cur_tpl
        ed = ttk.Combobox(tree, values=list(values), state="normal")
        ed.set(cur)
        ed.place(x=x, y=y, width=w, height=h)
        ed.focus_set()
        try:
            ed.selection_range(0, "end")
        except Exception:
            pass
        done = {"closed": False}

        def commit(_e=None):
            if done["closed"]:
                return
            done["closed"] = True
            new = ed.get().strip()
            try:
                ed.destroy()
            except Exception:
                pass
            if new == cur:
                self.set_status(f"未修改：{t}")
                return
            if col == "#2":
                self.map_dir_var.set("" if new == "（手动输入目录名）" else new)
            else:
                self.map_tpl_var.set(new or "通用.md")
            self._commit_map_row(save=True, silent=False, only_if_changed=False)

        def cancel(_e=None):
            if done["closed"]:
                return
            done["closed"] = True
            try:
                ed.destroy()
            except Exception:
                pass
            self.set_status("已取消编辑")

        ed.bind("<<ComboboxSelected>>", commit)
        ed.bind("<Return>", commit)
        ed.bind("<FocusOut>", commit)
        ed.bind("<Escape>", cancel)

    def save_map(self):
        """兼容入口：映射本来就会自动保存，这里再写一次并整体刷新。"""
        self.refresh_map_rows()
        self.refresh_all()
        self._persist("映射配置（config.json）")

    def add_type(self):
        t = self.new_type_var.get().strip()
        if not t:
            self.set_status("请输入新类型名", err=True)
            return
        self.cfg.setdefault("routes", {})[t] = ""
        self.cfg.setdefault("template_routes", {})[t] = "通用.md"
        self.new_type_var.set("")
        self.refresh_map_rows()
        self.refresh_work_types()
        self._persist(f"已添加类型：{t}（请在表格里为它指定目标目录）")

    def del_type(self):
        sel = self.map_tree.selection()
        if not sel:
            self.set_status("请先在表格中选择要删除的类型", err=True)
            return
        t = self.map_tree.item(sel[0], "values")[0]
        self.cfg.get("routes", {}).pop(t, None)
        self.cfg.get("template_routes", {}).pop(t, None)
        self.refresh_map_rows()
        self.refresh_work_types()
        self._persist(f"已删除类型：{t}")

    def reset_map(self):
        """重填映射 = 按**当前知识库**扫描出的映射（程序不内置任何时期的目录名）。"""
        kb = core.resolve_kb(self.cfg)
        if kb is None:
            self.set_status("请先在①页选择知识库目录", err=True)
            return
        det = core.detect_route_profile(self.cfg, kb)
        routes = det.get("routes") or {}
        if not routes:
            messagebox.showinfo("重填映射", f"当前知识库下没有可识别的类型目录：\n{kb}\n\n"
                                            "请先用「📁 按映射创建/检查目录」创建目录，或手工填写映射。")
            self.set_status("该库下没有可用目录，未能重填映射", err=True)
            return
        if not messagebox.askyesno("重填为当前库映射",
                                   f"将按**当前知识库**（{kb.name}）扫描出的 {len(routes)} 个类型重填映射，"
                                   "并同步更新该库档案，是否继续？"):
            self.set_status("已取消重填映射")
            return
        self.cfg["routes"] = dict(routes)
        self.cfg["template_routes"] = dict(det.get("template_routes") or {})
        core.save_kb_profile(self.cfg, kb, save=False)
        self.refresh_map_rows()
        self.refresh_work_types()
        self._persist(f"已按当前库重填 {len(routes)} 个类型的映射")

    def do_scan_types(self):
        """扫描**当前知识库**目录，生成"类型 → 目录"映射（换库/新建库时用）。"""
        kb = core.resolve_kb(self.cfg)
        if kb is None:
            self.set_status("请先在①页选择知识库目录", err=True)
            return
        det = core.detect_route_profile(self.cfg, kb)
        routes = det.get("routes") or {}
        if not routes:
            messagebox.showinfo("扫描当前库", f"该库下没有可识别的目录：\n{kb}\n\n"
                                            "可先点「📁 按映射创建/检查目录」建目录，或手工填写映射。")
            self.set_status("当前库下没有可识别的类型目录", err=True)
            return
        lines = "\n".join(f"  {t} → {d}" for t, d in list(routes.items())[:16])
        more = f"\n  …（共 {len(routes)} 项）" if len(routes) > 16 else ""
        if not messagebox.askyesno("扫描当前库目录生成类型",
                                   f"当前知识库：{kb}\n\n将收录 {len(routes)} 个类型：\n{lines}{more}\n\n"
