    def _toggle_update_fm(self):
        """勾选「附加 frontmatter 字段」时才把那块小框加进粘贴区（不勾则粘贴框占满整行）。"""
        show = bool(getattr(self, "upd_fm_show_var", None)
                    and self.upd_fm_show_var.get())
        pane = getattr(self, "upd_paste_pane", None)
        frame = getattr(self, "upd_fm_frame", None)
        if pane is None or frame is None:
            return
        try:
            panes = tuple(pane.panes())
            key = str(frame)
            if show and key not in panes:
                pane.add(frame, weight=1)
            elif not show and key in panes:
                pane.forget(frame)
        except Exception:
            pass

    # ---------------- ⑦ 页逻辑 ----------------

    def _update_target_path(self) -> str:
        return (getattr(self, "_upd_target", "") or "").strip()

    def _rel_note_path(self, path: str) -> str:
        """笔记路径 → 相对知识库的路径（如 `03 派系图谱/北洋系.md`，正斜杠），便于分辨同名条目。"""
        try:
            p = Path(path)
            kb = core.resolve_kb(self.cfg)
            if kb is not None:
                rel = str(p.resolve().relative_to(Path(kb).resolve()))
            else:
                rel = f"{p.parent.name}/{p.name}"
        except Exception:
            try:
                p = Path(path)
                rel = f"{p.parent.name}/{p.name}"
            except Exception:
                rel = str(path)
        return rel.replace("\\", "/")

    def _type_of_dir(self, dirname: str) -> str:
        """目录名 → ②页映射的类型（纯字典查找，不读文件）。"""
        d = core.normalize_dir_name(dirname or "")
        if not d:
            return ""
        for type_, target in (self.cfg.get("routes") or {}).items():
            if core.normalize_dir_name(str(target)) == d:
                return type_
        return ""

    def _set_update_target(self, path: str, quiet: bool = False):
        """设/清空目标词条，并把「目标：…」标签（类型 + 小节填充情况）、路径框、打开按钮同步好。"""
        path = (path or "").strip()
        self._upd_target = path
        if not path:
            self.upd_target_var.set("目标：未选择")
            self._set_enabled([self.btn_upd_open], False)
            return
        p = Path(path)
        self.upd_path_var.set(path)
        try:
            type_ = core.detect_type_of_note(self.cfg, p)
        except Exception:
            type_ = ""
        try:
            stats = core.section_stats(self.cfg, p)
        except Exception:
            stats = None
        parts = []
        if type_:
            parts.append(f"类型：{type_}")
        if stats and stats.get("sections"):
            parts.append(f"{len(stats['sections'])} 小节：{stats['filled']} 已填 / {stats['empty']} 空")
        info = f"目标：{p.parent.name}/{p.name}"
        if parts:
            info += "（" + "；".join(parts) + "）"
        empties = [s.get("label", "") for s in (stats or {}).get("sections", [])
                   if not s.get("filled") and s.get("label")]
        if empties:
            info += "；建议补充：" + "、".join(empties[:4]) + ("…" if len(empties) > 4 else "")
        self.upd_target_var.set(info)
        self._set_enabled([self.btn_upd_open], p.is_file())
        if not quiet and stats is not None:
            self.set_status(f"已选目标：{p.parent.name}/{p.name}"
                            f"（{stats.get('filled', 0)} 已填 / {stats.get('empty', 0)} 空）")

    def do_update_search(self):
        """搜索已有词条（关键词可为空 = 全列）。"""
        kw = self.upd_kw_var.get().strip()
        cfg = self.cfg

        def work():
            return core.list_notes(cfg, kw)

        self.run_task(work, self._on_update_search_done, "搜索已有词条",
                      busy=(self.btn_upd_search,))

    def _on_update_search_done(self, r):
        r = self._on_result(self.upd_log, r, "搜索失败：")
        if r is None:
            return
        rows = r or []
        for iid in self.upd_tree.get_children():
            self.upd_tree.delete(iid)
        self._upd_rows = {}
        for row in rows:
            dirname = str(row.get("dir", ""))
            iid = self.upd_tree.insert(
                "", "end", values=(row.get("title", ""), self._rel_note_path(row.get("path", "")),
                                   self._type_of_dir(dirname),
                                   f"{row.get('size_kb', 0)} KB", row.get("mtime", "")))
            self._upd_rows[iid] = row
        kw = self.upd_kw_var.get().strip()
        kb = core.resolve_kb(self.cfg)
        self.log(self.upd_log, f"✓ 搜索到 {len(rows)} 篇词条"
                 + (f"（关键词：{kw}）" if kw else "（全部）")
                 + f"｜知识库：{kb if kb else '未设置'}", "ok")
        if not rows and kw:
            # 自诊断：换个来源再查一次，能查到就说明是配置/旧进程问题，直接提示
            try:
                again = core.list_notes(core.load_config(), kw)
            except Exception:
                again = []
            if again:
                self.log(self.upd_log, f"   ⚠ 用当前 config.json 直查能查到 {len(again)} 篇："
                                       + "、".join(str(r.get("title")) for r in again[:5]), "err")
                self.log(self.upd_log, "   → 说明是运行中的配置没刷新或程序版本较旧："
                                       "到①页确认知识库路径后重试点搜索；用 exe 的话请用最新打包版。", "info")
        hit = next((iid for iid, row in self._upd_rows.items()
                    if str(row.get("title", "")) == kw), None) if kw else None
        same_name = bool(hit)
        if not hit and rows:                        # 没有同名条目 → 自动选中第一行，少点一次
            kids = self.upd_tree.get_children()
            hit = kids[0] if kids else None
        if hit:
            self.upd_tree.selection_set(hit)
            self.upd_tree.focus(hit)
            self.upd_tree.see(hit)
            self._set_update_target(self._upd_rows[hit].get("path", ""))
            self.log(self.upd_log, ("   自动选中同名条目：" if same_name else "   自动选中第一行：")
                     + f"{self.upd_target_var.get()}", "info")
            try:
                self.upd_tree.focus_set()
            except Exception:
                pass
        self.set_status(f"搜索完成：{len(rows)} 篇"
                        + ("，已自动选中同名条目" if same_name
                           else ("，已自动选中第一行" if hit else "（在列表选一篇，或直接填路径）")))

    def _on_update_tree_select(self, _e=None):
        sel = self.upd_tree.selection()
        if not sel:
            return
        row = self._upd_rows.get(sel[0]) or {}
        self._set_update_target(row.get("path", ""))

    def _on_update_tree_double(self, _e=None):
        """双击列表项：只选中 + 提示下一步（不自动跑任务，避免误触）。"""
        self._on_update_tree_select()
        if self._update_target_path():
            self.set_status("已选目标，可在下面粘贴内容后点「🔎 预览整合结果」")

    def use_update_path(self):
        """直接用手填/粘贴的 .md 路径当目标。"""
        p = (self.upd_path_var.get() or "").strip().strip('"')
        if not p:
            self.set_status("先填一个 .md 路径（或从上面搜索列表里选一篇）", err=True)
            return
        if not Path(p).is_file():
            self.set_status(f"路径不存在：{p}", err=True)
            return
        self._set_update_target(p)
        self.set_status(f"目标已设为：{p}")

    def do_update_guess_title(self):
        """从粘贴内容猜标题 → 填进搜索框并自动搜索。"""
        text = self.upd_content.get("1.0", "end").strip()
        if not text:
            self.set_status("先在「② 粘贴要补充的内容」里粘内容，再点猜标题", err=True)
            try:
                self.upd_content.focus_set()
            except Exception:
                pass
            return
        try:
            title = core.guess_title_from_text(self.cfg, text) or ""
        except Exception as exc:                       # noqa: BLE001
            self.set_status(f"猜标题失败：{type(exc).__name__}: {exc}", err=True)
            return
        if not title:
            self.set_status("没从粘贴内容里认出标题（可手动填搜索框或路径）", err=True)
            return
        self.upd_kw_var.set(title)
        self.log(self.upd_log, f"🎯 从粘贴内容认出标题：{title} → 自动搜索", "ok")
        self.do_update_search()

    def open_update_target(self):
        path = self._update_target_path()
        if not path:
            self.set_status("还没选目标词条（搜索后双击列表项，或填路径点「用这个路径」）", err=True)
            return
        if self._open_dir(path):
            self.set_status(f"已打开：{path}")
        else:
            self.set_status(f"打开失败，可手动打开：{path}", err=True)

    def _update_fields(self) -> dict:
        """附加 frontmatter 小框（键: 值，每行一个）→ dict。"""
        fields: dict = {}
        raw = self.upd_fm.get("1.0", "end").strip()
        for line in raw.splitlines():
            line = line.strip().lstrip("-").strip()
            if not line or line.startswith("#") or ":" not in line:
                continue
            key, val = line.split(":", 1)
            key, val = key.strip().strip("*").strip(), val.strip()
            if key:
                fields[key] = val
        return fields

    def _update_payload(self) -> tuple:
        """返回 (sections, plain_text)：有小节标题就给 sections；没有就把整段交给 plain_text。"""
        text = self.upd_content.get("1.0", "end").strip()
        if not text:
            return None, ""
        try:
            sections = core.parse_manual_input(text)
        except Exception:                              # noqa: BLE001
            sections = None
        if sections:
            return sections, ""
        return None, text

    def _update_require_target(self) -> str:
        """取目标路径；没选/不存在时给明确提示并返回空串。"""
        path = self._update_target_path()
        if not path:
            self.set_status("先选目标词条：搜索后双击列表项，或填路径点「用这个路径」", err=True)
            return ""
        if not Path(path).is_file():
            self.set_status(f"目标文件不存在：{path}", err=True)
            return ""
        return path

    def do_update_format(self):
        """只按格式规范整理整篇（不加内容）：sections=None，dry_run=True。"""
        path = self._update_require_target()
        if not path:
            return
        cfg = self.cfg
        add_missing = bool(self.upd_add_missing_var.get())

        def work():
            return core.update_note_file(cfg, Path(path), sections=None, plain_text="",
                                         add_missing_sections=add_missing, dry_run=True)

        self.run_task(work, lambda r: self._on_update_done(r, "📐 格式规范整理（预览）", write=False),
                      "按格式规范整理", busy=self._update_busy())

    def _update_busy(self) -> tuple:
        return (self.btn_upd_format, self.btn_upd_preview, self.btn_upd_write,
                getattr(self, "btn_upd_link", None), getattr(self, "btn_upd_link_write", None))

    # ---- 补正文双链（⑦ 页，针对当前选中的那一篇）----

    def do_update_link_preview(self):
        self._do_update_link(dry_run=True)

    def do_update_link_write(self):
        self._do_update_link(dry_run=False)

    def _do_update_link(self, dry_run: bool):
        """补正文双链：dry_run=True 只预览；False 才写盘（写前 core 会自动备份）。

        勾了「✨ 用 AI 识别专名」就走 AI 模式（识别通称/异名/库里还没有的专名）。
        """
        path = self._update_require_target()
        if not path:
            return
        cfg = self.cfg
        use_ai = bool(getattr(self, "upd_ai_link_var", None) and self.upd_ai_link_var.get())
        red = bool(getattr(self, "upd_red_link_var", None) and self.upd_red_link_var.get())

        def work():
            if use_ai:
                return core.link_keywords_ai(cfg, Path(path), dry_run=dry_run, red_links=red)
            return core.link_keywords(cfg, Path(path), dry_run=dry_run)

        desc = ("🔗 AI 补专名双链（预览）" if dry_run else "🔗 AI 补专名双链（写入）") if use_ai \
            else ("🔗 补正文双链（预览）" if dry_run else "🔗 补正文双链（写入）")
        if use_ai:
            self.set_status(f"{desc}：AI 识别中，约 30–60 秒…")
        self.run_task(work, lambda r: self._on_update_link_done(r, dry_run=dry_run), desc,
                      busy=self._update_busy())

    def _on_update_link_done(self, r, dry_run: bool):
        r = self._on_result(self.upd_log, r, "补正文双链失败：")
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(str(x) for x in (r.get("report") or ["补正文双链未能完成"]))
            self.log(self.upd_log, f"✗ {detail}", "err")
            self.set_status(f"{detail}（详情见日志区）", err=True)
            return
        action = r.get("action") or ("预览" if dry_run else "已补双链")
        added = r.get("added") or []
        report = [str(x) for x in (r.get("report") or [])]
        path = str(r.get("path") or "")
        name = f"{Path(path).parent.name}/{Path(path).name}" if path else ""
        head = "─── 🔗 " + ("正文双链预览" if dry_run else "已补正文双链")
        if name:
            head += f" → {name}"
        head += " ───"
        self._show_update_log(r.get("text") or "", head=head)
        if action == "无改动":
            self.log(self.upd_log, "✓ 这篇没有可补的词条双链（或已经链过了）", "ok")
            for line in report:
                self.log(self.upd_log, "   · " + line, "info")
            if dry_run:
                self.log(self.upd_log, "   （以上只是预览，没有改动文件）", "info")
            self.set_status(f"没有可补的词条双链（{name or path} 未改动）")
            return
        self.log(self.upd_log, f"✓ {'预览' if dry_run else '已补双链'}："
                              f"新增双链 {len(added)} 个", "ok")
        for line in report:
            self.log(self.upd_log, "   · " + line, "info")
        if added:
            self.log(self.upd_log, "   " + "、".join(f"[[{a}]]" for a in added[:20])
                     + ("…" if len(added) > 20 else ""), "info")
        red = [str(x) for x in (r.get("red") or [])]
        if red:
            self.log(self.upd_log,
                     f"   📝 库内暂无对应词条（{len(red)} 个）——可作为「该建哪些词条」的清单：", "info")
            self.log(self.upd_log, "      " + "、".join(red[:30]) + ("…" if len(red) > 30 else ""),
                     "info")
        if dry_run:
            self.log(self.upd_log, "   （以上只是预览，没有改动文件）", "info")
            self.set_status(f"双链预览：可新增 {len(added)} 个（{name}）")
        else:
            self.log(self.upd_log, f"✓ 已写入：{path}", "ok")
            self.log(self.upd_log,
                     f"   旧版已备份到 {core.BACKUP_DIR_NAME}/笔记/（同名只留最新一份）", "info")
            self._last_write_path = path
            self.set_status(f"已补双链 {len(added)} 个：{name}")

    def do_update_preview(self):
        """预览整合结果（不写盘）：sections=解析结果 + plain_text=整段。"""
        path = self._update_require_target()
        if not path:
            return
        sections, plain = self._update_payload()
        if not sections and not plain:
            self.set_status("先粘要补充的内容（没有 ## 小节也行，整段会放进第一个空小节）", err=True)
            try:
                self.upd_content.focus_set()
            except Exception:
                pass
            return
        cfg = self.cfg
        fields = self._update_fields()
        add_missing = bool(self.upd_add_missing_var.get())

        def work():
            return core.update_note_file(cfg, Path(path), sections=sections, fields=fields,
                                         plain_text=plain, add_missing_sections=add_missing,
                                         dry_run=True)

        self.run_task(work, lambda r: self._on_update_done(r, "🔎 整合预览", write=False),
                      "预览整合结果", busy=self._update_busy())

    def do_update_write(self):
        """补充更新（写盘，写前自动备份）。"""
        path = self._update_require_target()
        if not path:
            return
        sections, plain = self._update_payload()
        cfg = self.cfg
        fields = self._update_fields()
        add_missing = bool(self.upd_add_missing_var.get())

        def work():
            return core.update_note_file(cfg, Path(path), sections=sections, fields=fields,
                                         plain_text=plain, add_missing_sections=add_missing,
                                         dry_run=False)

        self.run_task(work, lambda r: self._on_update_done(r, "✅ 补充更新", write=True),
                      "补充更新", busy=self._update_busy())

    def _on_update_done(self, r, desc: str, write: bool = False):
        r = self._on_result(self.upd_log, r, f"{desc}失败：")
        if r is None:
            return
        if not r.get("ok"):
            detail = "；".join(str(x) for x in (r.get("report") or [f"{desc}未能完成"]))
            self.log(self.upd_log, f"✗ {detail}", "err")
            self.set_status(f"{detail}（详情见日志区）", err=True)
            return
        action = r.get("action") or ("补充更新" if write else "预览")
        path = str(r.get("path") or "")
        report = r.get("report") or []
        summary = r.get("summary") or core.summarize_merge(report)
        name = f"{Path(path).parent.name}/{Path(path).name}" if path else ""
        head = f"─── {desc}"
        if name:
            head += f" → {name}"
        if summary:
            head += f"（{summary}）"
        head += " ───"
        self._show_update_log(r.get("text") or "", head=head)
        self.log(self.upd_log, f"✓ {action}：{r.get('type') or ''}／{r.get('title') or ''}"
                 + (f"　{summary}" if summary else ""), "ok")
        for line in report:
            self.log(self.upd_log, "   · " + str(line), "info")
        if action == "无改动":
            self.log(self.upd_log, "   （没有可补充的新内容——已有内容都保留了，未改动文件）", "info")
        if write and action == "补充更新" and path:
            self.log(self.upd_log, f"✓ 已写入：{path}", "ok")
            self.log(self.upd_log,
                     f"   旧版已备份到 {core.BACKUP_DIR_NAME}/笔记/（同名只留最新一份）", "info")
            self._last_write_path = path
        if action == "预览":
            self.log(self.upd_log, "   （以上只是预览，没有改动文件；确认后点「✅ 补充更新」）", "info")
        if action == "无改动":
            self.set_status(f"没有需要补充的内容（{name or path} 未改动）")
        elif write:
            self.set_status(f"已{action}：{name}　{summary}" if name else f"已{action}：{summary}")
        else:
            self.set_status(f"{action}：{summary}")

    def _show_update_log(self, text: str, head: str = ""):
        w = self.upd_log
        w.configure(state="normal")
        w.delete("1.0", "end")
        w.insert("end", (head or "─── 整合结果 ───") + "\n", "head")
        w.insert("end", text or "（没有内容可显示）")
        self._scroll_to_end(w)
        w.configure(state="disabled")

    def do_update_clear(self):
        self.upd_content.delete("1.0", "end")
        self.upd_fm.delete("1.0", "end")
        self.upd_kw_var.set("")
        self.upd_path_var.set("")
        self._set_update_target("", quiet=True)
        if hasattr(self, "upd_add_missing_var"):
            self.upd_add_missing_var.set(False)
        if hasattr(self, "upd_fm_show_var"):
            self.upd_fm_show_var.set(False)      # 顺带把附加 frontmatter 小框收起来
            self._toggle_update_fm()
        for iid in self.upd_tree.get_children():
            self.upd_tree.delete(iid)
        self._upd_rows = {}
        self.clear_log(self.upd_log, silent=True)
        self.set_status("已清空 ⑦ 补充更新页的输入")

