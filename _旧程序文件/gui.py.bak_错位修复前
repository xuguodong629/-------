    def pick_kb(self):
        """选目录 = 立即保存 + 立即重扫 + 刷新 ②③ 页（不再依赖“记得点保存”）。"""
        p = filedialog.askdirectory(parent=self.root, title="选择知识库根目录（例如 …\\历史\\<时期>\\<朝代>）")
        if not p:
            return
        self.kb_var.set(p)
        self.apply_kb_path(auto=True)

    def apply_kb_path(self, auto: bool = False):
        """选/切知识库 = 存档旧库 → 载入（或扫描生成）新库档案 → 落盘 → 刷新 ②③④ 页。"""
        p = self.kb_var.get().strip()
        if not p:
            self.set_status("未设置知识库目录（可点「选择目录…」）", err=True)
            return
        if not os.path.isdir(p):
            self.set_status(f"目录不存在：{p}", err=True)
            return
        old = str(self.cfg.get("knowledge_base") or "")
        r = core.switch_kb(self.cfg, p, save=False)          # 每库一份档案：存旧的、载入新的
        if not r.get("ok"):
            self.set_status("；".join(r.get("report") or ["切换知识库失败"]), err=True)
            return
        if not self._persist(f"知识库目录：{p}"):
            return
        rows = core.scan_kb(p)
        self.kb_rows = rows
        self.refresh_kb_tree()
        self.refresh_all()
        log = self._default_log()
        if old and core.profile_key(old) != core.profile_key(p):
            self.log(log, f"· 知识库切换：{Path(old).name} → {Path(p).name}", "head")
        for line in (r.get("report") or []):
            self.log(log, "· " + str(line), "info")
        self.set_status(f"已切换到 {Path(p).name}：{r.get('types')} 个类型"
                        + ("（载入该库档案）" if r.get("profile_found") else "（已扫描生成该库档案）")
                        + f"｜模板库 {Path(r['templates_dir']).name if r.get('templates_dir') else '未找到'}")

    def save_kb(self):
        """兼容入口：与 apply_kb_path 等价。"""
        self.apply_kb_path()

    def rescan(self):
        p = self.kb_var.get().strip()
        if not p or not os.path.isdir(p):
            self.set_status("目录不存在：请重新选择", err=True)
            return
        rows = core.scan_kb(p)
        self.kb_rows = rows
        self.refresh_kb_tree()
        self.refresh_all()
        self.set_status(f"扫描完成：识别 {len(rows)} 个目录（自动读取实际文件夹，不创建任何目录）")

    def refresh_kb_tree(self):
        if not hasattr(self, "kb_tree"):
            return
        for i in self.kb_tree.get_children():
            self.kb_tree.delete(i)
        for r in self.kb_rows:
            self.kb_tree.insert("", "end", values=(r["name"], r["path"], r["md_count"], r["role"]))

    def run_test_routes(self):
        rows = core.test_routes(self.cfg)
        for i in self.test_tree.get_children():
            self.test_tree.delete(i)
        for r in rows:
            ok = "✓ 存在" if r["ok"] else "✗ 缺失"
            self.test_tree.insert("", "end", values=(r["type"], r["target"], ok, r["note"]))
        n_ok = sum(1 for r in rows if r["ok"])
        missing = [r["type"] for r in rows if not r["ok"]]
        self.set_status(f"测试目录完成：{n_ok}/{len(rows)} 个类型路由命中实际目录"
                        + (f"；缺失：{'、'.join(missing)}" if missing else ""))

