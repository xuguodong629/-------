HEADER = '''# -*- coding: utf-8 -*-
"""
templates.py —— 程序内置模板（**由 _sync_templates.py 自动生成，请勿手改**）。

模板原文来自知识库的 `Templates（模板）/*.md`，即 `格式规范.md` 的落地形态：
  * 文件开头是 Templater 的 `<%* %>` 收集块，所有 tp.system.prompt() 只在这里调用一次；
  * frontmatter 一律英文键名，frontmatter 内禁止 [[ ]]；
  * 正文只有一个 H1 + 若干 emoji 章节（## 📌 …），空位写 <!-- TODO: 待补 -->；
  * 结尾固定 `---` + `**关联**：[[…]] | [[…]]`。

程序侧的用法：
  * `KB_TEMPLATES`      —— 全部规范模板原文（「初始化默认模板」按此写入模板目录）；
  * `BUILTIN_TEMPLATES` —— 类型 → 模板原文（模板目录里找不到对应 .md 时的兜底）；
  * 生成笔记时由 core.render_template() 解析 `<%* %>` 块与 `<% … %>` 表达式，
    把 Templater 模板直接渲染成一篇符合格式规范的笔记骨架。

重新同步：`py _sync_templates.py`（源目录见该脚本的 KB_TPL 常量）。
"""

'''


def load_templates() -> "dict[str, str]":
    """模板目录里的 .md 为准；程序里已有、但目录里没有的模板保留（兜底），并打印说明。"""
    if not KB_TPL.is_dir():
        raise SystemExit(f"模板目录不存在：{KB_TPL}")
    found = {}
    for p in sorted(KB_TPL.glob("*.md")):
        if p.name == SPEC_FILE:
            continue
        found[p.stem] = p.read_text(encoding="utf-8")
    if not found:
        raise SystemExit(f"模板目录里没有 .md 模板：{KB_TPL}")

    kept = {}
    try:
        import templates as _old                      # noqa: PLC0415  已有内置模板
        for name, text in (getattr(_old, "KB_TEMPLATES", {}) or {}).items():
            if name not in found:
                kept[name] = text
    except Exception:
        kept = {}
    if kept:
        print("目录里没有、保留程序内置版（作兜底）：" + "、".join(sorted(kept)))
    ancient = load_ancient_templates()
    if ancient:
        print(f"古代史模板集：从子目录纳入 {len(ancient)} 个 → " + "、".join(sorted(ancient)))
    merged = {**kept, **found, **ancient}
    ordered = [n for n in ORDER if n in merged]
    ordered += [n for n in sorted(merged) if n not in ordered]
    return {n: merged[n] for n in ordered}


def load_ancient_templates() -> "dict[str, str]":
    """从 `古代社会模板/`（优先共享模板库，其次 19民国 模板目录）收集古代史模板。

    键加 `古代/` 前缀：古籍模板里 `人物`/`事件`/`史料` 等与近现代同名但内容不同，
    前缀可避免互相覆盖；同时把"古代独有类型"登记进 TYPE_TEMPLATE_FILE（不覆盖已有的近现代类型）。
    """
    cands = [d for base in (KB_TPL, SHARED_TPL) for d in [base / n for n in ANCIENT_DIR_NAMES]]
    out: dict = {}
    for d in cands:
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.md")):
            if p.name == SPEC_FILE:
                continue
            out["古代/" + p.stem] = p.read_text(encoding="utf-8")
        if out:
            break
    for type_, key in ANCIENT_TYPE_TEMPLATE_FILE.items():
        TYPE_TEMPLATE_FILE.setdefault(type_, key)     # 已被近现代占用的类型名（人物/事件/史料…）保持不动
    return out


def literal(text: str) -> str:
    """生成可读的 Python 字符串字面量。

    必须用 **raw 三引号**：模板里的 JS 字符串含有 `\\n`（如 tR += "---\\n"），
    普通三引号会被 Python 抢先转义成真实换行，模板结构就被破坏了。
    含 ''' 或结尾反斜杠时退回 JSON 转义。
    """
    if "'''" not in text and not text.endswith("\\"):
        return "r'''" + text + "'''"
    return json.dumps(text, ensure_ascii=False)


def build_module(templates: "dict[str, str]") -> str:
    out = [HEADER.rstrip("\n"), "", "# 全部规范模板原文（文件名 stem → 原文）", "KB_TEMPLATES = {"]
    for name, text in templates.items():
        out.append(f"    {name!r}: {literal(text)},")
    out.append("}")
    out.append("")
    out.append("# 类型（config.routes 的键）→ 该类型的首选模板文件")
    out.append("TYPE_TEMPLATE_FILE = {")
    for type_, name in TYPE_TEMPLATE_FILE.items():
        if name not in templates:
            continue
        out.append(f"    {type_!r}: {name!r},")
    out.append("}")
    out.append("")
    out.append("# 类型 → 模板原文（生成笔记的兜底模板）")
    out.append("BUILTIN_TEMPLATES = {t: KB_TEMPLATES[f] for t, f in TYPE_TEMPLATE_FILE.items() if f in KB_TEMPLATES}")
    out.append("")
    out.append("# 格式规范 §1 第 11 条：模板自己没写页脚时按这张表补齐（模板名 → 关联行）")
    out.append("DEFAULT_FOOTERS = {")
    for name in templates:
        if name in DEFAULT_FOOTERS:
            out.append(f"    {name!r}: {DEFAULT_FOOTERS[name]!r},")
    out.append("}")
    out.append("")
    out.append("# 类型 → 关联行")
    out.append("TYPE_FOOTER = {t: DEFAULT_FOOTERS[f] for t, f in TYPE_TEMPLATE_FILE.items() if f in DEFAULT_FOOTERS}")
    out.append("")
    out.append('# 模板目录默认名（知识库根下）')
    out.append('DEFAULT_TEMPLATES_DIR_NAME = "Templates（模板）"')
    out.append("")
    out.append("# 格式规范文件名（模板目录内，只读、不作为模板）")
    out.append(f'SPEC_FILE_NAME = "{SPEC_FILE}"')
    out.append("")
    return "\n".join(out)


def main() -> int:
    check_only = "--check" in sys.argv
    templates = load_templates()
    try:                                        # 复用 core 里的生成器，避免两套实现分叉
        import core
        new_text = core.render_templates_module(templates, ORDER)
    except Exception:
        new_text = build_module(templates)
    old_text = OUT.read_text(encoding="utf-8") if OUT.exists() else ""
    if check_only:
        same = old_text == new_text
        print(("一致：" if same else "有差异：") + str(OUT))
        print(f"模板 {len(templates)} 个：" + "、".join(templates))
        return 0 if same else 1
    OUT.write_text(new_text, encoding="utf-8")
    print(f"已同步 {len(templates)} 个模板 → {OUT}")
    print("模板：" + "、".join(templates))
    print(f"文件大小：{OUT.stat().st_size} 字节")
    return 0


if __name__ == "__main__":
    sys.exit(main())
