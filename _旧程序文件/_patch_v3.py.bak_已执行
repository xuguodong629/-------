def _match_monk(name: str) -> str:
    """僧道/宗教人物：白名单命中，或"首字是僧名常用字且 2–3 字"（排除年号）。"""
    s = str(name or "").strip()
    if s in ERA_NAME_GUARD:
        return ""
    for m in MONK_NAMES:
        if s == m:
            return m
    if 2 <= len(s) <= 3 and s[0] in MONK_PREFIXES and s not in ERA_NAME_GUARD:
        return s[0]
    return ""


