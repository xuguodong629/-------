    return sorted([t for t in routes if any(tok in t for tok in GOV_TYPE_TOKENS)], key=len)


def _match_state(name: str) -> str:
    """名字像不像国号/政权：命中常见政权专名，或以国号字结尾（限 2–6 字）。"""
    s = str(name or "").strip()
    if not (2 <= len(s) <= 6):
        return ""
    for p in STATE_NAMES:
        if s == p or s.startswith(p) or s.endswith(p):
            return p
    if len(s) >= 2 and s[-1] in STATE_SUFFIXES:
        return s[-1]
    return ""


