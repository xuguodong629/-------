    _hint_kb = Path(tempfile.mkdtemp(prefix="kbhint_"))
    try:
        _kb = _hint_kb / "提示库"
        (_kb / "01人物").mkdir(parents=True)
        (_kb / "02事件").mkdir(parents=True)
        _cfg = dict(core.default_config())
        _cfg["knowledge_base"] = str(_kb)
        _cfg["routes"] = {"人物": "01人物", "事件": "02事件"}
        check("11v 提示：kb_label 含库名与类型数", core.kb_label(_cfg) == "提示库（2 类）",
              core.kb_label(_cfg))
        _p1 = core.note_display_path(_cfg, "事件", title="八王之乱")
        check("11v 提示：将写入路径按类型路由拼出（库名\\目录\\文件名.md）",
              _p1 == "提示库\\02事件\\八王之乱.md", _p1)
        _p2 = core.note_display_path(_cfg, "事件", dir_="01人物", title="甲")
        check("11v 提示：给了目录就用给的目录", _p2 == "提示库\\01人物\\甲.md", _p2)
        _p3 = core.note_display_path(_cfg, "不存在的类型", title="甲")
        check("11v 提示：类型没路由时明确提示（不猜）", "没有对应目录" in _p3, _p3)
        _c1 = core.detect_type_conflict(_cfg, "八王之乱", "01人物")
        check("11v 冲突：检测为事件但默认目录是 01人物 → 报冲突",
              bool(_c1) and _c1.get("detected") == "事件" and _c1.get("detected_dir") == "02事件",
              str(_c1))
        check("11v 冲突：默认目录与判定一致 → 不打扰",
              core.detect_type_conflict(_cfg, "八王之乱", "02事件") is None)
        check("11v 冲突：没设默认目录 → 不报冲突",
              core.detect_type_conflict(_cfg, "八王之乱", "") is None)
        (_kb / "02事件" / "八王之乱.md").write_text("# 八王之乱\n", encoding="utf-8")
        (_kb / "01人物" / "桓玄篡位.md").write_text("# 桓玄篡位\n", encoding="utf-8")
        _cfg_before = Path(core.CONFIG_FILE).read_bytes() if Path(core.CONFIG_FILE).is_file() else b""
        _rep = core.misplaced_notes(_cfg, kb=_kb)
        _cfg_after = Path(core.CONFIG_FILE).read_bytes() if Path(core.CONFIG_FILE).is_file() else b""
        check("11v 错位体检：纯只读（真实 config.json 字节不变）", _cfg_before == _cfg_after)
        _names = [w.get("name") for w in (_rep.get("high") or [])]
        check("11v 错位体检：抓出放错目录的笔记（桓玄篡位在 01人物）", "桓玄篡位" in _names, str(_names))
        check("11v 错位体检：放对的不误报（八王之乱在 02事件）", "八王之乱" not in _names, str(_names))
        check("11v 错位体检：返回结构齐全",
              all(k in _rep for k in ("kb", "scanned", "correct", "accuracy", "high", "blank")),
              str(sorted(_rep)))
    finally:
        shutil.rmtree(_hint_kb, ignore_errors=True)

    # ---- 汇总 ----
    print("=" * 60)
    print("历史知识库 · 核心引擎自测")
    print("=" * 60)
    for line in RESULTS:
        print(" " + line)
    print("=" * 60)
    fails = sum(1 for r in RESULTS if r.startswith("[FAIL]"))
    print(f"结果：{len(RESULTS) - fails}/{len(RESULTS)} 通过，{fails} 失败")
    print("沙盒目录：" + str(SANDBOX))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
