SANDBOX_TEMPLATES: dict = {}


def build_sandbox() -> None:
    """沙盒里放两篇「旧格式」笔记，用来验证增量更新不会破坏已有内容。"""
    if SANDBOX.exists():
        shutil.rmtree(SANDBOX)
    (SANDBOX / "01 时间线").mkdir(parents=True)
    (SANDBOX / "02 人物图谱").mkdir(parents=True)
    (SANDBOX / "12 事件数据库 ⭐").mkdir(parents=True)
    (SANDBOX / "Templates（模板）").mkdir(parents=True)
    (SANDBOX / "Assets（图片地图）").mkdir(parents=True)

    # 模板由"用户"提供（程序已取消内置模板兜底）：把模板文件放进沙盒的 Templates（模板）/
    # 并把"粘贴模板"目录也隔离到沙盒里，避免碰真实程序目录
    os.environ["KB_TPL_DIR"] = str(SANDBOX / "_模板")
    seed_sandbox_templates()

    (SANDBOX / "01 时间线" / "1937年-七七事变.md").write_text(
        "---\n年份: 1937\n类型: 历史事件\n时期: 民国时期\n重要性: 5\n人物:\n地点:\n标签:\n  - 中国历史\n---\n\n"
        "# 1937年-七七事变\n\n## 一、事件概览\n\n> 用一段话概括这一事件。\n\n"
        "## 三、事件经过\n\n### 起因\n\n- \n\n### 发展\n\n- 卢沟桥日军挑衅（已有内容，不应被覆盖）\n\n---\n\n## 十、参考资料\n\n-\n",
        encoding="utf-8")

    (SANDBOX / "02 人物图谱" / "蒋介石.md").write_text(
        "---\n姓名: 蒋介石\n历史时期: 民国\n人物类型: 历史人物\n历史重要性: 5\n政治阵营: \n核心领域: \n标签:\n  - 中国历史\n---\n\n"
        "# 蒋介石\n\n## 一、人物定位\n\n**核心身份：**\n\n- 国民政府军事委员会委员长（已有内容）\n\n"
        "## 三、政治 / 军事生涯\n\n### 第一阶段\n\n- \n\n### 第二阶段\n\n- \n\n---\n\n## 十三、参考资料\n\n-\n",
        encoding="utf-8")


def seed_sandbox_templates() -> None:
    """把测试自带的模板写进沙盒（等价于"用户在④页选定/粘贴了模板"）。"""
    SANDBOX_TEMPLATES.clear()
    SANDBOX_TEMPLATES.update(sandbox_templates())
    (SANDBOX / "Templates（模板）").mkdir(parents=True, exist_ok=True)
    for _name, _text in SANDBOX_TEMPLATES.items():
        (SANDBOX / "Templates（模板）" / f"{_name}.md").write_text(_text, encoding="utf-8")

def make_cfg() -> dict:
    return {
        "knowledge_base": str(SANDBOX),
        "templates_dir": str(SANDBOX / "Templates（模板）"),
        "routes": {
            "时间线": "01 时间线",
            "人物": "02 人物图谱",
            "事件": "12 事件数据库 ⭐",
        },
        "template_routes": {
            "人物": "人物图谱.md",
            "事件": "事件数据库.md",
            "时间线": "时间线.md",
        },
        "index_file": "01 时间线/索引.md",
        # era-neutral：关联页脚由**该库自己配置**（程序不再内置任何时期的关联类型表）
        "footer_types": {"时间线": ["人物", "事件"], "人物": ["事件"], "事件": ["时间线", "人物"]},
    }


def main() -> int:
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    build_sandbox()
    cfg = make_cfg()

    # ---- 1. 目录扫描注册表 ----
    rows = core.scan_kb(SANDBOX)
    names = [r["name"] for r in rows]
    check("扫描注册表：识别 5 个目录", len(rows) == 5, "、".join(names))
    role_map = {r["name"]: r["role"] for r in rows}
    check("特殊目录标记 Templates/Assets", role_map["Templates（模板）"] == "特殊目录"
          and role_map["Assets（图片地图）"] == "特殊目录")
    check("内容目录标记 12 事件数据库", role_map["12 事件数据库 ⭐"] == "内容目录")

    # ---- 2. 类型路由 ----
    dp, note = core.resolve_route_dir(cfg, "事件")
    check("路由：事件 → 12 事件数据库 ⭐", dp is not None and dp.name == "12 事件数据库 ⭐", note)
    cfg["routes"]["事件"] = "99 不存在目录"
    dp2, note2 = core.resolve_route_dir(cfg, "事件")
    check("路由：缺失目录返回 None 并说明", dp2 is None and "不存在" in note2, note2)
    cfg["routes"]["事件"] = "12 事件数据库 ⭐"

    # ---- 2b. 类型别名归并（AI 常给「历史人物」这类说法）----
    check("类型别名：历史人物 → 人物", core.resolve_type_alias(cfg, "历史人物")[0] == "人物")
    check("类型别名：历史事件 → 事件", core.resolve_type_alias(cfg, "历史事件")[0] == "事件")
    check("类型别名：精确命中不变", core.resolve_type_alias(cfg, "事件")[0] == "事件")
    check("类型别名：认不出来时原样返回并给说明",
          core.resolve_type_alias(cfg, "莫名其妙类型")[0] == "莫名其妙类型")
    w_alias = core.write_note(cfg, "历史人物", "蔡锷", "",
                              {"出生年": "1882", "逝世年": "1916"},
                              core.sections_from_ai({"生平简史": ["1882-1911 留学日本，参与云南重九起义。"]}),
                              mode="create")
    p_alias = SANDBOX / "02 人物图谱" / "蔡锷.md"
    check("类型别名：写入落到 02 人物图谱 且套人物模板",
          bool(w_alias.get("ok")) and p_alias.exists()
          and "## 🪪 基本信息" in p_alias.read_text(encoding="utf-8"),
          w_alias.get("path", ""))

    # ---- 3. 模板只来自"用户提供的"（程序已无内置模板）----
    _tpl_path, _tpl_note = core.resolve_template(cfg, "人物")
    check("模板来源：找到的是沙盒里用户提供的模板文件（不是程序内置）",
          _tpl_path is not None and _tpl_path.parent == SANDBOX / "Templates（模板）"
          and _tpl_path.name in ("人物图谱.md", "人物.md"), f"{_tpl_path}｜{_tpl_note}")
    check("模板来源：程序已不再提供内置模板（相关函数/模块已移除）",
          not any(hasattr(core, n) for n in
                  ("materialize_templates", "sync_templates", "import_templates_from_vault",
                   "render_templates_module", "builtin_template_text", "create_kb_structure")),
          "残留：" + str([n for n in ("materialize_templates", "sync_templates",
                                     "import_templates_from_vault", "render_templates_module",
                                     "builtin_template_text", "create_kb_structure")
                          if hasattr(core, n)]))
    import importlib.util as _ilu
    check("模板来源：顶层没有 templates 模块可依赖（已删除）",
          _ilu.find_spec("templates") is None)

    # ---- 4. 模板解析：Templater 提示项 + 骨架不含 <% ----
    tpl_text, tpl_note = core.load_template_text(cfg, "事件")
    parsed = core.parse_template(tpl_text)
    check("模板：识别为 Templater 模板并解析出提示项", parsed["templater"] and len(parsed["prompts"]) >= 2,
          "、".join(p["var"] for p in parsed["prompts"]))
    skeleton = core.template_skeleton(cfg, "事件")
    check("模板骨架：无 <% %> 残留、有空位 TODO", "<%" not in skeleton and "<!-- TODO" in skeleton)

    # ---- 5. 新建事件笔记（AI 用旧式编号小节名，程序应对齐到 emoji 小节）----
    ai_fields = {"时间": "1937年7月7日", "地点": "北平卢沟桥", "人物": "宋哲元、蒋介石",
                 "前置事件": "华北事变", "后续事件": "全面抗战", "重要性": 5}
    ai_sections = core.sections_from_ai({
        "一、事件概览": ["七七事变是日本全面侵华的起点。"],
        "三、事件经过": ["起因：日军演习失联借口军事演习。"],
        "### 起因": ["日军在卢沟桥附近演习，借口士兵失踪要求入城搜查。"],
        "### 发展": ["中国守军拒绝日军无理要求，双方交火。"],
        "四、核心人物": ["[[宋哲元]]", "[[蒋介石]]"],
    })
    text, note = core.build_note_text(cfg, "事件", "七七事变",
                                      "日本全面侵华战争的开端。", ai_fields, ai_sections)
    h1_count = len([ln for ln in text.splitlines() if ln.startswith("# ")])
    check("新建：模板解析（返回文本 + 模板说明）", "七七事变" in text and "事件数据库.md" in note, note)
    check("新建：frontmatter 英文键 + 值（date/locations/people）",
          "date: 1937年7月7日" in text and "  - 北平卢沟桥" in text and "  - 宋哲元" in text)
    check("新建：前置/后续事件写入英文键", "prev_events:" in text and "  - 华北事变" in text
          and "next_events:" in text and "  - 全面抗战" in text)
    check("新建：中文键「时间/地点/人物」已规范成 date/locations/people", "时间:" not in text.split("---")[1])
    check("新建：AI 的「一、事件概览」落到 ## 📌 事件概览", "## 📌 事件概览" in text
          and "七七事变是日本全面侵华的起点。" in text)
    check("新建：AI 的「三、事件经过 / ### 起因」对齐到 emoji 小节", "## 📅 事件经过" in text
          and "### 起因" in text and "日军在卢沟桥附近演习" in text)
    check("新建：有且仅有一个 H1", h1_count == 1, f"H1={h1_count}")
    check("新建：结尾关联页脚按当前库映射生成（模块笔记命名）",
          "**关联**：[[12事件数据库]]" in text or "**关联**：[[12 事件数据库 ⭐]]" in text,
          [ln for ln in text.splitlines() if ln.startswith("**关联**")][:1])
    check("新建：未填小节留 TODO 占位", "<!-- TODO: 待补 -->" in text)
    check("新建：没有模板标记漏进笔记", "<%" not in text and "%>" not in text)
    spec_issues = _check_spec.check_text(text)
    check("新建：完全符合 格式规范.md", not spec_issues, "；".join(spec_issues[:3]))

    w = core.write_note(cfg, "事件", "七七事变", "日本全面侵华战争的开端。",
                        ai_fields, ai_sections, mode="auto")
    target = SANDBOX / "12 事件数据库 ⭐" / "七七事变.md"
    check("写入：新建成功", w["ok"] and w["action"] == "新建" and target.exists(), w["path"])
    check("写入：文件名为 标题.md", target.name == "七七事变.md")
    check("写入：落盘内容也符合规范", not _check_spec.check_file(target))

    # ---- 5b. 人物：生平简史按时间线阶段罗列（格式规范 §2.2）----
    lifeline = core.sections_from_ai({"生平简史": ["1881-1894 在朝鲜任职，主持练兵与对日外交。",
                                                   "1895-1911 小站练兵，编练北洋新军。"]})
    t_life, note_life = core.build_note_text(cfg, "人物", "袁世凯", "",
                                             {"出生年": "1859", "逝世年": "1916"}, lifeline)
